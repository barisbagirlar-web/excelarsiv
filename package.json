{
  "name": "excel-arsiv",
  "type": "module",
  "version": "0.0.1",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "astro dev",
    "build": "npm run guard:source && astro build && npm run seo:generate && npm run seo:validate && npm run seo:test && npm run seo:guard",
    "preview": "astro preview",
    "astro": "astro",
    "generate": "node scripts/validate-commerce.mjs",
    "validate:commerce": "node scripts/validate-commerce.mjs",
    "guard:source": "node scripts/guard-source-language.mjs",
    "seo:generate": "node scripts/seo/generate-artifacts.mjs",
    "seo:finalize": "node scripts/seo/finalize-sitemap-index.mjs",
    "seo:validate": "node scripts/seo/validate-artifacts.mjs",
    "seo:test": "node scripts/seo/test-sitemap-index-semantics.mjs",
    "seo:guard": "node scripts/seo/enterprise-guard.mjs",
    "seo:live": "node scripts/seo/live-contract.mjs",
    "seo:preflight": "node --experimental-strip-types scripts/seo/preflight.ts",
    "seo:conformance": "node --experimental-strip-types --test tests/conformance/*.test.ts tests/conformance/invariants/*.test.ts",
    "seo:coldstart-check": "node --experimental-strip-types scripts/seo/coldstart-check.ts",
    "seo:analytics-events": "node --experimental-strip-types scripts/seo/analytics-event-contract.ts",
    "seo:validate-registry": "node --experimental-strip-types scripts/seo/registry-validate.ts --site excelarsiv",
    "seo:kac": "node --experimental-strip-types scripts/seo/kac-prioritize.ts --site excelarsiv",
    "seo:pnl": "node --experimental-strip-types scripts/seo/seo-pnl.ts --site excelarsiv",
    "seo:slo": "node --experimental-strip-types scripts/seo/seo-slo-check.ts --site excelarsiv",
    "seo:offpage": "node --experimental-strip-types scripts/seo/audit-offpage.ts --site excelarsiv",
    "seo:cro": "node --experimental-strip-types scripts/seo/cro-contract.ts --site excelarsiv",
    "seo:vertical": "node --experimental-strip-types scripts/seo/audit-vertical-contract.ts --site excelarsiv",
    "seo:tam": "node --experimental-strip-types scripts/seo/tam-contract.ts --site excelarsiv",
    "seo:portfolio": "node --experimental-strip-types scripts/seo/portfolio-pnl.ts --site excelarsiv",
    "seo:programmatic": "node --experimental-strip-types scripts/seo/programmatic-contract.ts --site excelarsiv",
    "seo:valuation": "node --experimental-strip-types scripts/seo/valuation.ts --site excelarsiv",
    "seo:board": "node --experimental-strip-types scripts/seo/board-report.ts --site excelarsiv",
    "test": "node scripts/validate-commerce.mjs && npm run build && node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {"@astrojs/check": "^0.9.10", "typescript": "^6.0.3"}
}
