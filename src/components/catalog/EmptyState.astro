---
const { query } = Astro.props;
---

<div class="empty-state" data-empty-state hidden>
  <span class="empty-state__icon" aria-hidden="true">Ø</span>
  <h2 class="empty-state__title">Sonuç bulunamadı</h2>
  <p class="empty-state__text">
    {query
      ? `“${query}” için eşleşen şablon yok. Farklı bir anahtar kelime deneyin veya kategori filtrelerini temizleyin.`
      : 'Bu kategoriye uygun şablon bulunamadı.'}
  </p>
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 56px 24px;
    border: 1px dashed var(--xl-border);
    border-radius: 16px;
    background: #fff;
    text-align: center;
  }
  .empty-state[hidden] {
    display: none;
  }
  .empty-state__icon {
    font-family: var(--font-mono);
    font-size: 28px;
    color: var(--xl-ink-3);
  }
  .empty-state__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    color: var(--xl-ink-900);
  }
  .empty-state__text {
    max-width: 420px;
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--xl-ink-3);
  }
</style>
