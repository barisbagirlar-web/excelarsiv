---
import KatalogUrunKarti from './KatalogUrunKarti.astro';
import type { TemplateViewModel } from '../../lib/templates';

interface Props {
  templates: TemplateViewModel[];
}

const { templates } = Astro.props;
---

<div class="template-grid-wrap" data-template-grid-wrap>
  <ul class="template-grid" data-template-grid>
    {
      templates.map((template, index) => (
        <li data-template-item data-priority={index === 0 ? 'true' : undefined}>
          <KatalogUrunKarti template={template} priority={index === 0} />
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { mountCatalogFilter } from '../../scripts/catalog-filter';
  mountCatalogFilter();
</script>

<style>
  .template-grid-wrap { min-width: 0; }
  .template-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .template-grid > *,
  .template-grid li {
    min-width: 0;
  }
  .template-grid > li {
    display: flex;
    align-items: stretch;
  }
  .template-grid > li > :global(.card) {
    width: 100%;
    height: 100%;
  }
  /* The first card is the mobile LCP candidate and must remain immediately
     renderable. Following cards preserve their footprint while deferring
     style/layout/paint until they approach the viewport. */
  .template-grid li:not([data-priority='true']) {
    content-visibility: auto;
    contain-intrinsic-size: 560px;
  }
  .template-grid li[hidden] { display: none; }
  @media (max-width: 1080px) {
    .template-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 680px) {
    .template-grid { grid-template-columns: 1fr; gap: 14px; }
    .template-grid li:not([data-priority='true']) { contain-intrinsic-size: 640px; }
  }
  :global(.empty-state) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 56px 24px;
    border: 1px dashed var(--xl-border);
    border-radius: 16px;
    background: #fff;
    text-align: center;
  }
  :global(.empty-state[hidden]) {
    display: none;
  }
  :global(.empty-state__icon) {
    font-family: var(--font-mono);
    font-size: 28px;
    color: var(--xl-ink-3);
  }
  :global(.empty-state__title) {
    margin: 0;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    color: var(--xl-ink-900);
  }
  :global(.empty-state__text) {
    max-width: 420px;
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--xl-ink-3);
  }
</style>