---
import TemplateCard from './TemplateCard.astro';
import type { TemplateViewModel } from '../../lib/templates';

interface Props {
  templates: TemplateViewModel[];
}

const { templates } = Astro.props;
---

<div class="template-grid-wrap">
  <ul class="template-grid" data-template-grid>
    {
      templates.map((template, index) => (
        <li data-template-item>
          <TemplateCard
            slug={template.slug}
            name={template.name}
            summary={template.summary}
            sheetCount={template.sheetCount}
            priceTL={template.priceTL}
            category={template.categoryName}
            categorySlug={template.categorySlug}
            version={template.version}
            fileFormat={template.fileFormat}
            sheetMap={template.sheetMap}
            outputs={template.outputs}
            preview={template.preview}
            priority={index === 0}
          />
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { mountCatalogFilter } from '../../scripts/catalog-filter';
  mountCatalogFilter();
</script>

<style>
  .template-grid-wrap { min-width: 0; }
  .template-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .template-grid > *,
  .template-grid li {
    min-width: 0;
    content-visibility: auto;
    contain-intrinsic-size: 440px;
  }
  .template-grid li[hidden] { display: none; }
  @media (max-width: 1080px) {
    .template-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 680px) {
    .template-grid { grid-template-columns: 1fr; gap: 14px; }
    .template-grid li { contain-intrinsic-size: 520px; }
  }
  :global(.empty-state) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 56px 24px;
    border: 1px dashed var(--xl-border);
    border-radius: 16px;
    background: #fff;
    text-align: center;
  }
  :global(.empty-state[hidden]) {
    display: none;
  }
  :global(.empty-state__icon) {
    font-family: var(--font-mono);
    font-size: 28px;
    color: var(--xl-ink-3);
  }
  :global(.empty-state__title) {
    margin: 0;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    color: var(--xl-ink-900);
  }
  :global(.empty-state__text) {
    max-width: 420px;
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--xl-ink-3);
  }
</style>
