---
---

<div class="catalog-search">
  <svg class="catalog-search__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
    <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
  <div class="catalog-search__field">
    <label for="catalog-search-input">İhtiyacınızı yazın</label>
    <input
      id="catalog-search-input"
      type="search"
      class="catalog-search__input"
      data-catalog-search
      name="q"
      placeholder="Örn. nakit akışı, kârlılık, tahsilat, stok…"
      autocomplete="off"
      spellcheck="false"
    />
  </div>
  <button type="button" class="catalog-search__clear" data-catalog-search-clear hidden aria-label="Aramayı temizle">×</button>
</div>

<style>
  .catalog-search {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 13px;
    min-height: 66px;
    padding: 0 16px;
    border: 1px solid var(--xl-border);
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 7px 18px rgba(22,53,35,.035);
    transition: border-color 150ms ease-out, box-shadow 150ms ease-out;
  }
  .catalog-search:focus-within {
    border-color: var(--xl-accent-border);
    box-shadow: 0 0 0 4px var(--xl-accent-soft), 0 9px 24px rgba(22,53,35,.06);
  }
  .catalog-search__icon { flex-shrink: 0; color: var(--xl-green); }
  .catalog-search__field { display: grid; gap: 3px; min-width: 0; }
  .catalog-search__field label {
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: .08em;
    color: var(--xl-green-dark);
  }
  .catalog-search__input {
    width: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--xl-ink-900);
    appearance: none;
  }
  .catalog-search__input::-webkit-search-cancel-button { display: none; }
  .catalog-search__input::placeholder { color: #8a958e; opacity: 1; font-weight: 400; }
  .catalog-search__clear {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--xl-grid);
    border-radius: 9px;
    background: var(--xl-paper);
    color: var(--xl-ink-3);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }
  .catalog-search__clear:hover { border-color: var(--xl-accent-border); color: var(--xl-green-dark); }
  .catalog-search__clear[hidden] { display: none; }
  @media (max-width: 560px) {
    .catalog-search { min-height: 62px; padding-inline: 13px; gap: 10px; border-radius: 14px; }
    .catalog-search__field label { font-size: 8px; }
    .catalog-search__input { font-size: 13px; }
  }
</style>
