---
interface Props {
  title?: string;
  description?: string;
  templateCount?: number;
  categoryCount?: number;
  minPriceTL?: number;
}

const {
  title = 'Hazır tablo değil. İşletmeniz için çalışan Excel sistemleri.',
  description = 'Nakit akışından kârlılığa, tahsilattan stok yönetimine kadar işletmenin kritik kararlarını tek bakışta görünür hale getiren hazır Excel çalışma sistemleri.',
  templateCount = 0,
  categoryCount = 0,
  minPriceTL,
} = Astro.props;

const minPrice = typeof minPriceTL === 'number' ? minPriceTL.toLocaleString('tr-TR') : null;
---

<section class="catalog-hero" aria-labelledby="catalog-title">
  <div class="catalog-hero__glow" aria-hidden="true"></div>
  <div class="site-container catalog-hero__grid">
    <div class="catalog-hero__copy">
      <div class="catalog-hero__kicker"><span></span> EXCEL ARŞİV · İŞLETME KARAR ARAÇLARI</div>
      <h1 id="catalog-title" class="catalog-hero__title">{title}</h1>
      <p class="catalog-hero__lead">{description}</p>

      <div class="catalog-hero__actions">
        <a class="catalog-hero__primary" href="#katalog">Sistemleri keşfet <span aria-hidden="true">↓</span></a>
        <a class="catalog-hero__secondary" href="/nasil-calisir">Nasıl çalışır?</a>
      </div>

      <dl class="catalog-hero__stats" aria-label="Katalog özeti">
        <div><dt>{templateCount}</dt><dd>hazır sistem</dd></div>
        <div><dt>{categoryCount}</dt><dd>işletme alanı</dd></div>
        {minPrice && <div><dt>{minPrice} TL</dt><dd>başlayan fiyat</dd></div>}
      </dl>
    </div>

    <div class="catalog-hero__visual" aria-hidden="true">
      <div class="workbook">
        <div class="workbook__topbar">
          <div class="workbook__dots"><i></i><i></i><i></i></div>
          <span>Yönetim_Panosu.xlsx</span>
          <b>Excel Arşiv</b>
        </div>
        <div class="workbook__ribbon">
          <span class="is-active">PANO</span><span>GİRDİLER</span><span>KONTROL</span><span>RAPOR</span>
        </div>
        <div class="workbook__canvas">
          <div class="workbook__title"><span>YÖNETİM ÖZETİ</span><b>Karar için tek ekran</b></div>
          <div class="workbook__kpis">
            <div><small>NAKİT</small><strong>GÖRÜNÜR</strong><span>Giriş / çıkış dengesi</span></div>
            <div><small>RİSK</small><strong>KONTROL</strong><span>Vade / tahsilat görünümü</span></div>
            <div><small>KÂRLILIK</small><strong>KARAR</strong><span>Gerçek sonuç takibi</span></div>
          </div>
          <div class="workbook__body">
            <div class="workbook__chart">
              <div class="workbook__chart-head"><span>12 HAFTALIK GÖRÜNÜM</span><i></i></div>
              <svg viewBox="0 0 320 128" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="areaFill" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="#107c41" stop-opacity=".22" />
                    <stop offset="100%" stop-color="#107c41" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <path d="M0 105 L38 92 L76 98 L114 69 L152 78 L190 48 L228 58 L266 31 L320 20 L320 128 L0 128 Z" fill="url(#areaFill)" />
                <polyline points="0,105 38,92 76,98 114,69 152,78 190,48 228,58 266,31 320,20" fill="none" stroke="#107c41" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <div class="workbook__decisions">
              <span>KARAR AKIŞI</span>
              <ul>
                <li><i class="good"></i><b>Veri</b><em>girildi</em></li>
                <li><i class="good"></i><b>Kontrol</b><em>çalıştı</em></li>
                <li><i class="warn"></i><b>Karar</b><em>görünür</em></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="workbook__tabs"><span class="is-active">PANO</span><span>NAKİT</span><span>KÂRLILIK</span><span>RAPOR</span><b>+</b></div>
      </div>
      <div class="catalog-hero__badge"><span>✓</span><div><b>Gerçek ekranlarla inceleyin</b><small>Ürün sayfalarında 3+ ön izleme</small></div></div>
    </div>
  </div>
</section>

<style>
  .catalog-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(58px, 8vw, 104px) clamp(54px, 7vw, 88px);
    border-bottom: 1px solid var(--xl-grid);
    background:
      linear-gradient(rgba(16,124,65,.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(16,124,65,.045) 1px, transparent 1px),
      linear-gradient(145deg, #fbfdfb 0%, #f5faf7 52%, #eef7f1 100%);
    background-size: 34px 34px, 34px 34px, auto;
  }
  .catalog-hero__glow {
    position: absolute;
    width: 680px;
    height: 680px;
    right: -220px;
    top: -300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(16,124,65,.16), rgba(16,124,65,0) 68%);
    pointer-events: none;
  }
  .catalog-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(470px, 1.1fr);
    gap: clamp(44px, 7vw, 92px);
    align-items: center;
  }
  .catalog-hero__copy { min-width: 0; }
  .catalog-hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 28px;
    padding: 0 10px;
    border: 1px solid var(--xl-accent-border);
    border-radius: 999px;
    background: rgba(255,255,255,.7);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .1em;
    color: var(--xl-green-dark);
  }
  .catalog-hero__kicker span { width: 6px; height: 6px; border-radius: 50%; background: var(--xl-green); box-shadow: 0 0 0 4px rgba(16,124,65,.1); }
  .catalog-hero__title {
    max-width: 760px;
    margin: 22px 0 0;
    font-family: var(--font-display);
    font-size: clamp(42px, 5.2vw, 72px);
    font-weight: 800;
    letter-spacing: -.055em;
    line-height: .96;
    color: #13271c;
  }
  .catalog-hero__lead {
    max-width: 650px;
    margin: 22px 0 0;
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.7;
    color: var(--xl-ink-3);
  }
  .catalog-hero__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .catalog-hero__primary,
  .catalog-hero__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 18px;
    border-radius: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 160ms ease-out, box-shadow 160ms ease-out, background 160ms ease-out;
  }
  .catalog-hero__primary { border: 1px solid #0a6235; background: #0d7040; color: #fff; box-shadow: 0 10px 24px rgba(13,112,64,.2); }
  .catalog-hero__primary:hover { transform: translateY(-1px); box-shadow: 0 14px 30px rgba(13,112,64,.25); }
  .catalog-hero__secondary { border: 1px solid var(--xl-border); background: rgba(255,255,255,.82); color: var(--xl-ink-900); }
  .catalog-hero__secondary:hover { background: #fff; }
  .catalog-hero__stats { display: flex; flex-wrap: wrap; gap: 0; margin: 30px 0 0; }
  .catalog-hero__stats div { min-width: 112px; padding: 0 18px; border-right: 1px solid var(--xl-border); }
  .catalog-hero__stats div:first-child { padding-left: 0; }
  .catalog-hero__stats div:last-child { border-right: 0; }
  .catalog-hero__stats dt { font-family: var(--font-mono); font-size: 16px; font-weight: 800; color: var(--xl-ink-900); }
  .catalog-hero__stats dd { margin: 3px 0 0; font-size: 10.5px; color: var(--xl-ink-3); }

  .catalog-hero__visual { position: relative; min-width: 0; padding: 10px 10px 28px 0; }
  .workbook {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(20,61,39,.18);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 34px 70px rgba(17,56,35,.17), 0 3px 0 rgba(255,255,255,.65) inset;
    transform: perspective(1200px) rotateY(-3deg) rotateX(1.2deg);
    transform-origin: center;
  }
  .workbook__topbar { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; height: 40px; padding: 0 13px; background: #0f6f40; color: #fff; }
  .workbook__dots { display: flex; gap: 5px; }
  .workbook__dots i { width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,.48); }
  .workbook__topbar > span { font-family: var(--font-mono); font-size: 9px; opacity: .82; }
  .workbook__topbar > b { font-family: var(--font-mono); font-size: 8px; letter-spacing: .07em; opacity: .85; }
  .workbook__ribbon { display: flex; align-items: center; gap: 18px; height: 36px; padding: 0 14px; border-bottom: 1px solid #dfe7e2; background: #f5f7f6; font-family: var(--font-mono); font-size: 7.5px; font-weight: 700; color: #718078; }
  .workbook__ribbon span.is-active { color: #0c6e3e; }
  .workbook__canvas { padding: 18px; background: linear-gradient(#edf1ef 1px, transparent 1px), linear-gradient(90deg,#edf1ef 1px,transparent 1px), #fff; background-size: 24px 24px; }
  .workbook__title { display: flex; align-items: end; justify-content: space-between; gap: 16px; padding: 0 2px 12px; }
  .workbook__title span { font-family: var(--font-mono); font-size: 7.5px; font-weight: 800; letter-spacing: .08em; color: #0c6e3e; }
  .workbook__title b { font-size: 9px; color: #647169; }
  .workbook__kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .workbook__kpis div { display: grid; gap: 5px; min-width: 0; padding: 12px; border: 1px solid #dde6e0; border-radius: 10px; background: rgba(255,255,255,.92); box-shadow: 0 6px 16px rgba(30,61,43,.045); }
  .workbook__kpis small { font-family: var(--font-mono); font-size: 6.5px; font-weight: 800; letter-spacing: .08em; color: #7d8982; }
  .workbook__kpis strong { font-family: var(--font-mono); font-size: 12px; color: #163b28; }
  .workbook__kpis span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 7px; color: #7d8982; }
  .workbook__body { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(130px,.7fr); gap: 8px; margin-top: 8px; }
  .workbook__chart,
  .workbook__decisions { border: 1px solid #dde6e0; border-radius: 10px; background: rgba(255,255,255,.94); }
  .workbook__chart { padding: 11px 11px 5px; }
  .workbook__chart-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 5px; font-family: var(--font-mono); font-size: 6.5px; font-weight: 800; color: #6e7c74; }
  .workbook__chart-head i { width: 34px; height: 5px; border-radius: 999px; background: #d8eee1; }
  .workbook__chart svg { display: block; width: 100%; height: 114px; }
  .workbook__decisions { padding: 11px; }
  .workbook__decisions > span { font-family: var(--font-mono); font-size: 6.5px; font-weight: 800; letter-spacing: .08em; color: #6e7c74; }
  .workbook__decisions ul { display: grid; gap: 9px; margin: 11px 0 0; padding: 0; list-style: none; }
  .workbook__decisions li { display: grid; grid-template-columns: 8px 1fr; gap: 1px 6px; align-items: center; padding-bottom: 8px; border-bottom: 1px solid #edf1ef; }
  .workbook__decisions li:last-child { border-bottom: 0; }
  .workbook__decisions i { grid-row: span 2; width: 7px; height: 7px; border-radius: 50%; }
  .workbook__decisions i.good { background: #107c41; box-shadow: 0 0 0 3px #e0f2e7; }
  .workbook__decisions i.warn { background: #c48616; box-shadow: 0 0 0 3px #f9edcf; }
  .workbook__decisions b { font-size: 7.5px; color: #26372e; }
  .workbook__decisions em { grid-column: 2; font-style: normal; font-size: 6.5px; color: #829087; }
  .workbook__tabs { display: flex; align-items: center; gap: 3px; height: 32px; padding: 0 10px; border-top: 1px solid #dfe7e2; background: #f3f5f4; }
  .workbook__tabs span { height: 22px; padding: 0 9px; border-radius: 5px 5px 0 0; font-family: var(--font-mono); font-size: 6.5px; line-height: 22px; color: #6f7c74; }
  .workbook__tabs span.is-active { background: #fff; color: #0c6e3e; box-shadow: inset 0 -2px #107c41; }
  .workbook__tabs b { margin-left: auto; font-size: 13px; font-weight: 400; color: #708078; }
  .catalog-hero__badge { position: absolute; right: -3px; bottom: 0; display: flex; align-items: center; gap: 9px; padding: 10px 12px; border: 1px solid #d6e3da; border-radius: 13px; background: rgba(255,255,255,.96); box-shadow: 0 15px 30px rgba(18,55,34,.13); }
  .catalog-hero__badge > span { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 9px; background: #e6f4eb; color: #0c6e3e; font-size: 12px; font-weight: 800; }
  .catalog-hero__badge div { display: grid; gap: 2px; }
  .catalog-hero__badge b { font-size: 9px; color: #23352b; }
  .catalog-hero__badge small { font-size: 7.5px; color: #7a887f; }

  @media (max-width: 1060px) {
    .catalog-hero__grid { grid-template-columns: 1fr; }
    .catalog-hero__copy { max-width: 780px; }
    .catalog-hero__visual { max-width: 760px; width: 100%; }
  }
  @media (max-width: 620px) {
    .catalog-hero { padding-block: 44px 46px; }
    .catalog-hero__title { margin-top: 18px; font-size: clamp(38px, 12vw, 52px); }
    .catalog-hero__lead { margin-top: 16px; font-size: 14px; }
    .catalog-hero__actions { margin-top: 22px; }
    .catalog-hero__primary,
    .catalog-hero__secondary { width: 100%; }
    .catalog-hero__stats { margin-top: 24px; }
    .catalog-hero__stats div { min-width: 96px; padding: 0 12px; }
    .catalog-hero__visual { padding: 0 0 24px; }
    .workbook { border-radius: 15px; transform: none; }
    .workbook__topbar > b { display: none; }
    .workbook__topbar { grid-template-columns: auto 1fr; }
    .workbook__ribbon { gap: 12px; overflow: hidden; }
    .workbook__canvas { padding: 11px; }
    .workbook__kpis div { padding: 9px; }
    .workbook__kpis span { display: none; }
    .workbook__body { grid-template-columns: 1fr; }
    .workbook__decisions { display: none; }
    .workbook__chart svg { height: 96px; }
    .catalog-hero__badge { right: 8px; }
  }
</style>
