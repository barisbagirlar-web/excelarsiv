---
import CatalogProductVisual from './CatalogProductVisual.astro';

interface Preview {
  src: string;
  alt: string;
}

interface Props {
  slug: string;
  name: string;
  summary: string;
  sheetCount: number;
  priceTL: number;
  category?: string;
  categorySlug?: string;
  version?: string;
  fileFormat?: 'xlsx' | 'xlsm';
  sheetMap?: { name: string; kind: 'input' | 'calculation' | 'output' }[];
  outputs?: string[];
  preview?: Preview;
  priority?: boolean;
}

const {
  slug,
  name,
  summary,
  sheetCount,
  priceTL,
  category,
  categorySlug,
  version,
  fileFormat = 'xlsx',
  sheetMap = [],
  outputs = [],
  preview,
  priority = false,
} = Astro.props;

const price = priceTL.toLocaleString('tr-TR');
const benefitItems = outputs.slice(0, 3);
const structure = sheetMap.slice(0, 3);
const kindLabel: Record<string, string> = { input: 'Girdi', calculation: 'Hesap', output: 'Çıktı' };
---

<article
  class="tcard"
  aria-label={name}
  data-template-card
  data-name={name}
  data-category={categorySlug ?? ''}
  data-category-label={category ?? ''}
  data-summary={summary}
>
  <a class="tcard__preview" href={`/sablon/${slug}`} aria-label={`${name} ürününü incele`}>
    {priority ? (
      <CatalogProductVisual slug={slug} name={name} />
    ) : preview ? (
      <img
        class="tcard__shot"
        src={preview.src}
        alt={preview.alt}
        width="1200"
        height="750"
        loading="lazy"
        fetchpriority="auto"
        decoding="async"
      />
    ) : (
      <CatalogProductVisual slug={slug} name={name} />
    )}
    <span class="tcard__preview-label">PREMİUM EXCEL SİSTEMİ</span>
    <span class="tcard__preview-open">Ekranları İncele ↗</span>
  </a>

  <div class="tcard__content">
    <div class="tcard__top">
      <span class="tcard__cat">{category ?? `${sheetCount} Sayfa`}</span>
      {version && <span class="tcard__ver">v{version}</span>}
    </div>

    <h3 class="tcard__title"><a href={`/sablon/${slug}`}>{name}</a></h3>
    <p class="tcard__summary">{summary}</p>

    {benefitItems.length > 0 ? (
      <div class="tcard__benefits">
        <span class="tcard__section-label">ÖNE ÇIKAN ÇIKTILAR</span>
        <ul>
          {benefitItems.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}
        </ul>
      </div>
    ) : structure.length > 0 ? (
      <div class="tcard__structure">
        <span class="tcard__section-label">MODÜLER YAPI</span>
        <ul>{structure.map((row) => <li><span>{row.name}</span><b>{kindLabel[row.kind]}</b></li>)}</ul>
      </div>
    ) : null}

    <div class="tcard__meta">
      <span>{sheetCount} Sayfa</span>
      <span>{fileFormat.toUpperCase()}</span>
      <span>Hazır Şablon</span>
    </div>

    <div class="tcard__foot">
      <div class="tcard__price">
        <small>KDV dahil net fiyat</small>
        <strong>{price} <span>TL</span></strong>
      </div>
      <div class="tcard__actions">
        <a class="tcard__cta" href={`/sablon/${slug}`}>Detay →</a>
      </div>
    </div>
  </div>
</article>

<style>
  .tcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    border-radius: 20px;
    background: #ffffff;
    box-shadow: 0 10px 30px rgba(16, 40, 26, 0.06);
    transition: transform 220ms ease-out, box-shadow 220ms ease-out;
  }
  .tcard:hover {
    transform: translateY(-5px);
    box-shadow: 0 24px 48px rgba(16, 40, 26, 0.12);
  }
  .tcard__preview {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9.6;
    background: #f2f7f4;
    text-decoration: none;
  }
  .tcard__shot {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  .tcard__preview::after {
    content: '';
    position: absolute;
    inset: 50% 0 0;
    z-index: 1;
    background: linear-gradient(180deg, transparent, rgba(6, 31, 18, 0.22));
    pointer-events: none;
  }
  .tcard__preview :global(.product-visual) {
    transition: transform 260ms ease-out;
  }
  .tcard:hover .tcard__preview :global(.product-visual) {
    transform: scale(1.02);
  }
  .tcard__preview-label,
  .tcard__preview-open {
    position: absolute;
    z-index: 3;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 0 10px;
    border-radius: 8px;
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.05em;
  }
  .tcard__preview-label {
    left: 10px;
    background: rgba(10, 48, 28, 0.85);
    color: #ffffff;
  }
  .tcard__preview-open {
    right: 10px;
    background: rgba(255, 255, 255, 0.95);
    color: #0d4227;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 180ms ease-out, transform 180ms ease-out;
  }
  .tcard:hover .tcard__preview-open {
    opacity: 1;
    transform: translateY(0);
  }

  .tcard__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 20px;
  }
  .tcard__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }
  .tcard__cat {
    display: inline-flex;
    align-items: center;
    min-height: 25px;
    padding-inline: 10px;
    border-radius: 999px;
    background: #eef7f1;
    color: var(--xl-green-dark, #0d7040);
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 800;
  }
  .tcard__ver {
    font-family: var(--font-mono);
    font-size: 9px;
    color: #44554c;
  }
  .tcard__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 19px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #122118;
  }
  .tcard__title a {
    color: inherit;
    text-decoration: none;
  }
  .tcard__title a:hover {
    color: var(--xl-green-dark, #0d7040);
  }
  .tcard__summary {
    margin: 8px 0 0;
    font-size: 12.5px;
    line-height: 1.56;
    color: #3a4a41;
  }

  .tcard__benefits,
  .tcard__structure {
    margin-top: 16px;
    padding: 12px;
    border-radius: 12px;
    background: #eef4f0;
    border: 1px solid #d0ddd5;
  }
  .tcard__section-label {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #44554c;
  }
  .tcard__benefits ul,
  .tcard__structure ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tcard__benefits li {
    display: grid;
    grid-template-columns: 15px minmax(0, 1fr);
    gap: 6px;
    align-items: start;
    font-size: 13.5px;
    line-height: 1.45;
    color: #24352c;
  }
  .tcard__benefits li > span {
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    margin-top: 1px;
    border-radius: 5px;
    background: #e1f3e7;
    color: #0b7040;
    font-size: 8.5px;
    font-weight: 800;
  }
  .tcard__structure li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: #2f3f36;
  }
  .tcard__structure li > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tcard__structure li > b {
    flex: 0 0 auto;
    font-size: 8px;
    color: #44554c;
  }

  .tcard__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
  }
  .tcard__meta span {
    min-height: 24px;
    padding: 0 9px;
    border-radius: 7px;
    border: 1px solid #c5d4cb;
    background: #e8f0eb;
    font-family: var(--font-mono);
    font-size: 8px;
    line-height: 24px;
    color: #2f3f36;
  }

  .tcard__foot {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: auto;
    padding-top: 18px;
  }
  .tcard__price {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tcard__price small {
    font-size: 8.5px;
    color: #44554c;
  }
  .tcard__price strong {
    font-family: var(--font-mono);
    font-size: 24px;
    line-height: 1;
    color: #0e1e14;
  }
  .tcard__price strong span {
    font-size: 14px;
    font-weight: 700;
  }

  .tcard__actions {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 8px;
  }
  .tcard__wp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 48px;
    padding: 0 16px;
    border-radius: 11px;
    background: #25d366;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 6px 16px rgba(37, 211, 102, 0.25);
    transition: background 160ms ease-out, transform 160ms ease-out;
  }
  .tcard__wp:hover {
    background: #20bd5a;
    transform: translateY(-1px);
  }
  .tcard__wp-icon {
    flex: 0 0 auto;
  }
  .tcard__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: 48px;
    padding: 0 16px;
    border-radius: 11px;
    background: #0d7040;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 6px 16px rgba(13, 112, 64, 0.15);
    transition: background 160ms ease-out, transform 160ms ease-out;
  }
  .tcard__cta:hover {
    background: #095c34;
    transform: translateY(-1px);
  }

  @media (max-width: 680px) {
    .tcard { border-radius: 18px; }
    .tcard__content { padding: 16px; }
    .tcard__title { font-size: 18px; }
    .tcard__summary { font-size: 12px; }
    .tcard__preview-open { display: none; }
    .tcard__price strong { font-size: 22px; }
    .tcard__actions { grid-template-columns: 1fr; }
  }
</style>

