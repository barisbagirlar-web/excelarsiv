---
interface Preview {
  src: string;
  alt: string;
}

interface Props {
  slug: string;
  name: string;
  summary: string;
  sheetCount: number;
  priceTL: number;
  category?: string;
  categorySlug?: string;
  version?: string;
  fileFormat?: 'xlsx' | 'xlsm';
  sheetMap?: { name: string; kind: 'input' | 'calculation' | 'output' }[];
  outputs?: string[];
  preview?: Preview;
  priority?: boolean;
}

const {
  slug,
  name,
  summary,
  sheetCount,
  priceTL,
  category,
  categorySlug,
  version,
  fileFormat = 'xlsx',
  sheetMap = [],
  outputs = [],
  preview,
  priority = false,
} = Astro.props;

const price = priceTL.toLocaleString('tr-TR');
const structure = sheetMap.slice(0, 3);
const benefitItems = outputs.slice(0, 3);
const kindLabel: Record<string, string> = { input: 'Girdi', calculation: 'Hesap', output: 'Çıktı' };
---

<article
  class="tcard"
  aria-label={name}
  data-template-card
  data-name={name}
  data-category={categorySlug ?? ''}
  data-category-label={category ?? ''}
  data-summary={summary}
>
  <a class="tcard__preview" href={`/sablon/${slug}`} aria-label={`${name} ürününü incele`}>
    {
      preview ? (
        <img src={preview.src} alt={preview.alt} loading={priority ? 'eager' : 'lazy'} decoding="async" />
      ) : (
        <div class="tcard__preview-fallback" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
      )
    }
    <span class="tcard__preview-label">GERÇEK ÜRÜN EKRANI</span>
    <span class="tcard__preview-open">İncele ↗</span>
  </a>

  <div class="tcard__content">
    <div class="tcard__top">
      <span class="tcard__cat">{category ?? `${sheetCount} sayfa`}</span>
      {version && <span class="tcard__ver">v{version}</span>}
    </div>

    <h3 class="tcard__title"><a href={`/sablon/${slug}`}>{name}</a></h3>
    <p class="tcard__summary">{summary}</p>

    {benefitItems.length > 0 ? (
      <div class="tcard__benefits">
        <span class="tcard__section-label">SİSTEMİN ÜRETTİĞİ</span>
        <ul>
          {benefitItems.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}
        </ul>
      </div>
    ) : structure.length > 0 ? (
      <div class="tcard__structure">
        <span class="tcard__section-label">ÇALIŞMA YAPISI</span>
        <ul>{structure.map((row) => <li><span>{row.name}</span><b>{kindLabel[row.kind]}</b></li>)}</ul>
      </div>
    ) : null}

    <div class="tcard__meta">
      <span>{sheetCount} sayfa</span>
      <span>{fileFormat.toUpperCase()}</span>
      <span>Demo ile inceleme</span>
    </div>

    <div class="tcard__foot">
      <div class="tcard__price"><small>KDV dahil</small><strong>{price} TL</strong></div>
      <a class="tcard__cta" href={`/sablon/${slug}`}>Şablonu incele <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>

<style>
  .tcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--xl-border);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(21,53,35,.045);
    transition: border-color 170ms ease-out, transform 170ms ease-out, box-shadow 170ms ease-out;
  }
  .tcard:hover {
    border-color: var(--xl-accent-border);
    transform: translateY(-4px);
    box-shadow: 0 22px 44px rgba(21,53,35,.12);
  }
  .tcard__preview {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9.8;
    border-bottom: 1px solid var(--xl-grid);
    background: #edf3ef;
    text-decoration: none;
  }
  .tcard__preview::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 52%, rgba(8,34,21,.38));
    pointer-events: none;
  }
  .tcard__preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 260ms ease-out;
  }
  .tcard:hover .tcard__preview img { transform: scale(1.025); }
  .tcard__preview-fallback {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 7px;
    height: 100%;
    padding: 26px;
    background: linear-gradient(#e3eae6 1px, transparent 1px), linear-gradient(90deg,#e3eae6 1px,transparent 1px), #f7faf8;
    background-size: 24px 24px;
  }
  .tcard__preview-fallback span { align-self: end; border-radius: 5px 5px 0 0; background: #107c41; opacity: .14; }
  .tcard__preview-fallback span:nth-child(1) { height: 35%; }.tcard__preview-fallback span:nth-child(2) { height: 58%; }.tcard__preview-fallback span:nth-child(3) { height: 44%; }.tcard__preview-fallback span:nth-child(4) { height: 72%; }.tcard__preview-fallback span:nth-child(5) { height: 61%; }.tcard__preview-fallback span:nth-child(6) { height: 88%; }
  .tcard__preview-label,
  .tcard__preview-open {
    position: absolute;
    z-index: 2;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    min-height: 25px;
    padding: 0 8px;
    border-radius: 7px;
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 7.5px;
    font-weight: 800;
    letter-spacing: .06em;
  }
  .tcard__preview-label { left: 10px; border: 1px solid rgba(255,255,255,.25); background: rgba(8,49,28,.78); color: #fff; }
  .tcard__preview-open { right: 10px; background: rgba(255,255,255,.92); color: #153625; opacity: 0; transform: translateY(4px); transition: opacity 160ms ease-out, transform 160ms ease-out; }
  .tcard:hover .tcard__preview-open { opacity: 1; transform: translateY(0); }

  .tcard__content { display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 18px; }
  .tcard__top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
  .tcard__cat { display: inline-flex; align-items: center; min-height: 26px; padding-inline: 9px; border: 1px solid #d7e8dd; border-radius: 8px; background: #eef7f1; color: var(--xl-green-dark); font-family: var(--font-mono); font-size: 9.5px; font-weight: 800; }
  .tcard__ver { font-family: var(--font-mono); font-size: 8.5px; color: #8a958e; }
  .tcard__title { margin: 0; font-family: var(--font-body); font-size: 19px; font-weight: 800; line-height: 1.22; letter-spacing: -.018em; color: var(--xl-ink-900); }
  .tcard__title a { color: inherit; text-decoration: none; }
  .tcard__title a:hover { color: var(--xl-green-dark); }
  .tcard__summary { margin: 8px 0 0; font-size: 12.2px; line-height: 1.58; color: var(--xl-ink-3); }
  .tcard__benefits,
  .tcard__structure { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--xl-grid); }
  .tcard__section-label { display: block; margin-bottom: 9px; font-family: var(--font-mono); font-size: 7.5px; font-weight: 800; letter-spacing: .1em; color: #7a877f; }
  .tcard__benefits ul,
  .tcard__structure ul { display: grid; gap: 7px; margin: 0; padding: 0; list-style: none; }
  .tcard__benefits li { display: grid; grid-template-columns: 15px minmax(0,1fr); gap: 6px; align-items: start; font-size: 10.5px; line-height: 1.4; color: #4c5b52; }
  .tcard__benefits li > span { display: grid; place-items: center; width: 14px; height: 14px; margin-top: 1px; border-radius: 5px; background: #e5f3ea; color: #0b7040; font-size: 8px; font-weight: 800; }
  .tcard__structure li { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-family: var(--font-mono); font-size: 9px; color: #526157; }
  .tcard__structure li > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tcard__structure li > b { flex: 0 0 auto; font-size: 7.5px; color: #829087; }
  .tcard__meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 15px; }
  .tcard__meta span { min-height: 24px; padding: 0 7px; border: 1px solid var(--xl-grid); border-radius: 7px; background: var(--xl-paper); font-family: var(--font-mono); font-size: 7.8px; line-height: 22px; color: #6e7b73; }
  .tcard__foot { display: flex; align-items: end; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 17px; }
  .tcard__price { display: grid; gap: 2px; }
  .tcard__price small { font-size: 8px; color: #8a958e; }
  .tcard__price strong { font-family: var(--font-mono); font-size: 22px; line-height: 1; color: var(--xl-ink-900); }
  .tcard__cta { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 42px; padding: 0 13px; border: 1px solid #0b7040; border-radius: 11px; background: #0d7040; color: #fff; font-family: var(--font-mono); font-size: 9.5px; font-weight: 800; text-decoration: none; box-shadow: 0 8px 16px rgba(13,112,64,.13); }
  .tcard__cta:hover { background: #095c34; }

  @media (max-width: 680px) {
    .tcard { border-radius: 18px; }
    .tcard__content { padding: 16px; }
    .tcard__title { font-size: 18px; }
    .tcard__summary { font-size: 11.8px; }
    .tcard__preview-open { display: none; }
    .tcard__benefits li { font-size: 10.2px; }
    .tcard__foot { align-items: center; }
    .tcard__price strong { font-size: 20px; }
  }
</style>
