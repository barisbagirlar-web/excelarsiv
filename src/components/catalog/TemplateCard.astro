---
interface Props {
  slug: string;
  name: string;
  summary: string;
  sheetCount: number;
  priceTL: number;
  category?: string;
  categorySlug?: string;
  version?: string;
  variant?: 'sparkline' | 'hm' | 'bars';
  sheetMap?: { name: string; kind: 'input' | 'calculation' | 'output' }[];
}

const { slug, name, summary, sheetCount, priceTL, category, categorySlug, version, variant = 'sparkline', sheetMap } = Astro.props;
const price = priceTL.toLocaleString('tr-TR');
const kindLabel: Record<string, string> = { input: 'Girdi', calculation: 'Hesap', output: 'Çıktı' };
const rows = (sheetMap ?? []).slice(0, 3);
---

<article class="tcard" aria-label={name} data-template-card data-name={name} data-category={categorySlug ?? ''} data-summary={summary}>
  <div class="tcard__top">
    <span class="tcard__cat">{category ?? `${sheetCount} sayfa`}</span>
    {version && <span class="tcard__ver">v{version}</span>}
  </div>

  <h3 class="tcard__title" title={name}>{name}</h3>
  <p class="tcard__summary">{summary}</p>

  <div class="tcard__viz">
    {variant === 'sparkline' && (
      <svg viewBox="0 0 200 44" preserveAspectRatio="none" class="tcard__spark" aria-hidden="true">
        <polyline points="0,36 28,30 56,33 84,22 112,26 140,15 168,19 200,8" fill="none" stroke="var(--xl-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="200" cy="8" r="3" fill="var(--xl-green)" />
      </svg>
    )}
    {variant === 'hm' && (
      <div class="tcard__hm" aria-hidden="true"><i style="--a:.2"></i><i style="--a:.5"></i><i style="--a:.85"></i><i style="--a:.35"></i><i style="--a:.65"></i><i style="--a:.95"></i></div>
    )}
    {variant === 'bars' && <div class="tcard__bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>}
  </div>

  {rows.length > 0 && (
    <ul class="tcard__outputs">
      {rows.map((row) => <li><span>{row.name}</span><span>{kindLabel[row.kind]}</span></li>)}
    </ul>
  )}

  <div class="tcard__foot">
    <span class="tcard__scope"><span>{sheetCount} sayfa</span><span class="tcard__file"> · {slug}.xlsx</span></span>
    <div class="tcard__buyrow">
      <span class="tcard__price">{price} TL</span>
      <a class="tcard__cta" href={`/sablon/${slug}`}>İncele <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>

<style>
  .tcard { display:flex; flex-direction:column; height:100%; min-width:0; padding:18px 18px 16px; border:1px solid var(--xl-border); border-radius:18px; background:#fff; transition:border-color .15s,transform .15s,box-shadow .15s; }
  .tcard:hover { border-color:var(--xl-accent-border); transform:translateY(-2px); box-shadow:0 14px 34px rgba(24,55,38,.1); }
  .tcard__top { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; }
  .tcard__cat { display:inline-flex; align-items:center; min-height:22px; padding:0 9px; border-radius:999px; background:var(--xl-accent-soft); color:var(--xl-green-dark); font-family:var(--font-mono); font-size:10px; font-weight:700; }
  .tcard__ver { font-family:var(--font-mono); font-size:10.5px; color:var(--xl-ink-3); }
  .tcard__title { margin:0; font-size:18px; font-weight:700; line-height:1.2; color:var(--xl-ink-900); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .tcard__summary { margin:6px 0 0; font-size:13px; line-height:1.5; color:var(--xl-ink-3); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .tcard__viz { margin:12px 0; border-radius:12px; background:var(--xl-paper); padding:10px; min-height:48px; display:grid; place-items:center; }
  .tcard__spark { width:100%; height:38px; }
  .tcard__hm { display:grid; grid-template-columns:repeat(6,1fr); gap:4px; width:100%; }
  .tcard__hm i { aspect-ratio:1; border-radius:4px; background:color-mix(in srgb,var(--xl-green) calc(var(--a)*100%),var(--xl-paper)); }
  .tcard__bars { display:flex; align-items:flex-end; gap:5px; height:32px; width:100%; }
  .tcard__bars i { flex:1; border-radius:3px 3px 0 0; background:var(--xl-green); height:100%; opacity:.55; }
  .tcard__bars i:nth-child(2){opacity:.75}.tcard__bars i:nth-child(3){opacity:.4}.tcard__bars i:nth-child(4){opacity:.9}.tcard__bars i:nth-child(5){opacity:.65}.tcard__bars i:nth-child(6){opacity:.95}
  .tcard__outputs { margin:0 0 12px; padding:0; list-style:none; display:flex; flex-direction:column; gap:4px; }
  .tcard__outputs li { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:6px 8px; border-radius:7px; background:var(--xl-paper); font-family:var(--font-mono); font-size:11px; color:var(--xl-ink-3); }
  .tcard__outputs li span:first-child { color:var(--xl-ink-900); }
  .tcard__foot { margin-top:auto; border-top:1px solid var(--xl-grid); padding-top:10px; display:grid; gap:8px; }
  .tcard__scope { font-family:var(--font-mono); font-size:10.5px; color:var(--xl-ink-3); }
  .tcard__buyrow { display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .tcard__price { font-family:var(--font-mono); font-size:18px; font-weight:700; color:var(--xl-ink-900); }
  .tcard__cta { display:inline-flex; align-items:center; justify-content:center; gap:5px; min-height:36px; padding:0 14px; border:1px solid var(--xl-green); border-radius:9px; background:#fff; color:var(--xl-green-dark); font-family:var(--font-mono); font-size:12px; font-weight:700; text-decoration:none; }
  .tcard__cta:hover { background:var(--xl-green); color:#fff; }

  @media (max-width:680px) {
    .tcard { min-height:338px; padding:15px; border-radius:17px; }
    .tcard__top { margin-bottom:8px; }
    .tcard__cat { min-height:21px; padding-inline:8px; font-size:9.5px; }
    .tcard__ver { font-size:9.5px; }
    .tcard__title { font-size:18px; line-height:1.16; }
    .tcard__summary { margin-top:6px; font-size:12px; line-height:1.42; -webkit-line-clamp:2; }
    .tcard__viz { min-height:76px; margin:10px 0; padding:9px; }
    .tcard__spark { height:48px; }
    .tcard__hm i { min-height:42px; }
    .tcard__bars { height:46px; }
    .tcard__outputs { display:none; }
    .tcard__file { display:none; }
    .tcard__foot { padding-top:9px; gap:7px; }
    .tcard__scope { font-size:10px; }
    .tcard__price { font-size:20px; }
    .tcard__cta { min-height:38px; padding-inline:15px; border-radius:10px; font-size:12px; }
  }
</style>
