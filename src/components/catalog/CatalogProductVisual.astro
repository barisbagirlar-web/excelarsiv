---
interface Props { slug: string; name: string; }
const { slug, name } = Astro.props;

type Theme = {
  eyebrow: string; sheet: string; labels: [string,string,string,string]; metrics: [string,string,string,string];
  accent: string; accent2: string; accent3: string; accent4: string; tint: string; family: string;
};

const themes: Record<string, Partial<Theme>> = {
  '13-haftalik-nakit-akisi-ve-odeme-planlama-sistemi': { eyebrow:'13 HAFTALIK NAKİT', sheet:'NAKİT AKIŞI', labels:['GİRİŞ','ÇIKIŞ','NET','MİN. NAKİT'], metrics:['₺3,45M','₺2,43M','₺1,02M','₺210K'], family:'cashflow' },
  'akilli-kasa-defteri-ve-nakit-kontrol-sistemi': { eyebrow:'KASA KONTROL', sheet:'KASA DEFTERİ', labels:['BAKİYE','GÜNLÜK GİRİŞ','GÜNLÜK ÇIKIŞ','FARK'], metrics:['₺56.890','₺18.250','₺12.480','₺6.590'], family:'cashbook' },
  'aylik-patron-finans-paneli': { eyebrow:'PATRON FİNANS', sheet:'YÖNETİM PANELİ', labels:['CİRO','NET KÂR','MARJ','NAKİT'], metrics:['₺2,45M','₺630K','%25,7','₺1,12M'], family:'executive' },
  'banka-kredi-ve-taksit-takip-sistemi': { eyebrow:'BORÇ & TAKSİT', sheet:'ÖDEME PLANI', labels:['BORÇ','KALAN','TAKSİT','GECİKEN'], metrics:['₺2,24M','₺1,42M','₺95K','₺20K'], family:'debt' },
  'cari-hesap-tahsilat-ve-musteri-risk-takip-sistemi': { eyebrow:'CARİ RİSK', sheet:'ALACAK YAŞLANDIRMA', labels:['ALACAK','VADESİ GEÇEN','TAHSİLAT','VADE'], metrics:['₺3,12M','₺620K','%78,5','45 gün'], family:'receivables' },
  'cek-senet-ve-vade-risk-sistemi': { eyebrow:'VADE RİSKİ', sheet:'VADE TAKVİMİ', labels:['EVRAK','TOPLAM','YAKLAŞAN','GEÇEN'], metrics:['125','₺1,85M','₺320K','₺85K'], family:'maturity' },
  'gunluk-gelir-gider-ve-gercek-karlilik-sistemi': { eyebrow:'GERÇEK KÂRLILIK', sheet:'KÂR KÖPRÜSÜ', labels:['GELİR','GİDER','NET KÂR','MARJ'], metrics:['₺985K','₺742K','₺243K','%24,7'], family:'profit' },
  'kobi-finans-yonetim-paketi': { eyebrow:'KOBİ FİNANS', sheet:'FİNANS MERKEZİ', labels:['KASA','BANKA','CARİ','POS'], metrics:['₺7.900','₺83.500','₺214K','₺415K'], family:'suite' },
  'pos-komisyon-ve-net-tahsilat-kontrol-sistemi': { eyebrow:'POS MUTABAKAT', sheet:'POS KONTROL', labels:['BRÜT','KOMİSYON','NET','FARK'], metrics:['₺684K','₺17,8K','₺666K','₺2,4K'], family:'pos' },
  'proje-ve-is-bazinda-gercek-karlilik-sistemi': { eyebrow:'PROJE KÂRLILIĞI', sheet:'PROJE MATRİSİ', labels:['PROJE','CİRO','MARJ','RİSK'], metrics:['8','₺4,8M','%31,4','2'], family:'project' },
  'stok-satis-ve-nakit-baglanma-sistemi': { eyebrow:'STOK & NAKİT', sheet:'STOK HAREKETİ', labels:['SKU','STOK DEĞERİ','DEVİR','KRİTİK'], metrics:['2.450','₺1,24M','3,2','18'], family:'stock' },
  'vergi-sgk-ve-maas-karsilik-ayirma-sistemi': { eyebrow:'VERGİ · SGK · MAAŞ', sheet:'BORDRO YÜKÜ', labels:['MAAŞ','SGK','VERGİ','PERSONEL'], metrics:['₺286K','₺91K','₺62K','24'], family:'payroll' },
  'ithalat-depo-teslim-rafa-gelen-net-birim-maliyet': { eyebrow:'İTHALAT MALİYETİ', sheet:'MALİYET KÖPRÜSÜ', labels:['FOB','CIF','RAFA GELEN','BİRİM'], metrics:['$42,5K','$47,8K','₺1,83M','₺457'], family:'import' },
  'kacirilan-sgk-tesvikleri-ve-gercek-iscilik-maliyeti-analizi': { eyebrow:'SGK TEŞVİK', sheet:'TEŞVİK MATRİSİ', labels:['İŞÇİLİK','TEŞVİK','NET','KAZANIM'], metrics:['₺184K','₺71K','₺113K','%38,6'], family:'sgk' },
  'kidem-ihbar-yuku-ve-personel-cikarma-maliyeti-hesaplayici': { eyebrow:'KIDEM · İHBAR', sheet:'PERSONEL YÜKÜ', labels:['KIDEM','İHBAR','İZİN','TOPLAM'], metrics:['₺492K','₺137K','₺48K','₺677K'], family:'severance' },
  'asgari-ucret-zam-etkisi-fiyat-ayarlama-cetveli': { eyebrow:'ZAM ETKİSİ', sheet:'FİYAT AYARLAMA', labels:['ÜCRET','MALİYET','FİYAT','MARJ'], metrics:['%24,8','%14,2','%9,6','%22,1'], family:'wage' },
  'fazla-mesai-ve-isci-dava-riski-tespit-dosyasi': { eyebrow:'FAZLA MESAİ RİSKİ', sheet:'MESAİ TAKVİMİ', labels:['SAAT','PERSONEL','YÜKSEK RİSK','KARŞILIK'], metrics:['428','17','5','₺186K'], family:'overtime' },
  'ihaleye-kac-tl-teklif-vermeliyim': { eyebrow:'TEKLİF KARAR MOTORU', sheet:'TEKLİF BANDI', labels:['TABAN','HEDEF','TEKLİF','MARJ'], metrics:['₺7,61M','₺8,05M','₺8,42M','%11,8'], family:'tender' },
  'asiri-dusuk-teklif-savunma-robotu': { eyebrow:'SAVUNMA ROBOTU', sheet:'KANIT DOSYASI', labels:['KALEM','KANIT','TAMLIK','RİSK'], metrics:['14','9','%96','2'], family:'defense' },
  'hakedis-fiyat-farki-hak-kaybi-cetveli': { eyebrow:'HAKEDİŞ FARKI', sheet:'ENDEKS KÖPRÜSÜ', labels:['HAKEDİŞ','FİYAT FARKI','KAYIP','TAHSİL'], metrics:['₺3,28M','₺214K','₺63K','₺151K'], family:'progress' },
  'yillara-sari-insaat-stopaj-nakit-akis-planlayici': { eyebrow:'STOPAJ NAKİT', sheet:'STOPAJ TAKVİMİ', labels:['TAHAKKUK','STOPAJ','NET','DÖNEM'], metrics:['₺12,8M','₺640K','₺12,16M','18 ay'], family:'withholding' },
  'taseron-hakedis-kesinti-mutabakati': { eyebrow:'TAŞERON MUTABAKAT', sheet:'KESİNTİ CETVELİ', labels:['BRÜT','KESİNTİ','NET','FARK'], metrics:['₺2,14M','₺186K','₺1,95M','₺4,8K'], family:'subcontract' },
  'amortisman-ve-sabit-kiymet-satis-zamanlama-stratejisti': { eyebrow:'AMORTİSMAN', sheet:'SATIŞ ZAMANLAMA', labels:['NET DEFTER','SATIŞ','VERGİ','DÖNEM'], metrics:['₺2,86M','₺3,42M','₺614K','Q4'], family:'asset' },
  'doviz-acik-pozisyonu-ve-kur-riski-stres-testi': { eyebrow:'KUR RİSK STRESİ', sheet:'DÖVİZ SENARYOLARI', labels:['USD AÇIK','EUR AÇIK','STRES','VAR'], metrics:['$482K','€215K','₺3,7M','%14,2'], family:'fx' },
  'kdv-iadesi-azami-alacak-hesabi-dosya-hazirlayici': { eyebrow:'KDV İADE', sheet:'İADE KONTROLÜ', labels:['TEORİK','AZAMİ','DOSYA','EKSİK'], metrics:['₺1,42M','₺1,18M','14','3'], family:'vat' },
  'kkeg-ve-finansman-gider-kisitlamasi-vergi-savunma-seti': { eyebrow:'KKEG · FGK', sheet:'VERGİ SAVUNMA', labels:['FİN. GİDER','KISIT','MATRAH','KANIT'], metrics:['₺864K','₺216K','₺648K','12'], family:'taxdefense' },
  'mutfak-kayip-kacak-hesaplayici': { eyebrow:'MUTFAK FİRE', sheet:'REÇETE VARYANSI', labels:['HAMMADDE','FİRE','KAYIP','MARJ'], metrics:['₺286K','%8,4','₺24K','%31'], family:'kitchen' },
  'nakliye-maliyeti-hesaplayici': { eyebrow:'NAKLİYE MALİYETİ', sheet:'SEFER MALİYETİ', labels:['KM','YAKIT','TONAJ','SEFER'], metrics:['1.280','₺14,2K','18 ton','₺36,6K'], family:'logistics' },
  'ortaklar-cari-ve-kasa-adat-faiz-faturasi-hesaplayici': { eyebrow:'ADAT FAİZ', sheet:'ADAT HESABI', labels:['BAKİYE','FAİZ','KDV','FATURA'], metrics:['₺1,12M','₺94K','₺18,8K','₺112,8K'], family:'adat' },
  'pazaryeri-net-kar-ve-eksik-hakedis-yakalayici': { eyebrow:'PAZARYERİ KÂR', sheet:'HAKEDİŞ MUTABAKAT', labels:['SATIŞ','KESİNTİ','NET','EKSİK'], metrics:['₺742K','₺128K','₺614K','₺41K'], family:'marketplace' },
  'sirket-oz-kaynagi-eridi-mi-ttk-376-sermaye-tamamlama-cetveli': { eyebrow:'TTK 376', sheet:'SERMAYE TESTİ', labels:['SERMAYE','ÖZ KAYNAK','KAYIP','EŞİK'], metrics:['₺6,4M','₺2,1M','%67','2/3'], family:'capital' },
  'sube-karlilik-ve-nakit-hesaplayici': { eyebrow:'ŞUBE KÂRLILIĞI', sheet:'ŞUBE MATRİSİ', labels:['ŞUBE','CİRO','MARJ','NEGATİF'], metrics:['8','₺6,2M','%18,6','2'], family:'branch' },
  'uretim-recetesi-ve-zam-yansitma-hesaplayici': { eyebrow:'ÜRETİM REÇETESİ', sheet:'REÇETE MALİYETİ', labels:['BİRİM','GİRDİ ZAMMI','FİYAT ETKİSİ','FİRE'], metrics:['₺128,4','%17,2','%11,6','%3,1'], family:'recipe' },
  'vergi-sgk-borcunu-tecil-etmeli-miyim-kredi-mi-tecil-mi': { eyebrow:'KREDİ Mİ TECİL Mİ', sheet:'FİNANSMAN KIYASI', labels:['BORÇ','KREDİ','TECİL','FARK'], metrics:['₺1,8M','₺312K','₺246K','₺66K'], family:'financing' },
  'yeniden-degerleme-yapmali-miyim-vergi-tasarruf-analizi': { eyebrow:'YENİDEN DEĞERLEME', sheet:'DEĞERLEME KARARI', labels:['YENİ DEĞER','ARTIŞ','VERGİ','TASARRUF'], metrics:['₺12,4M','₺3,1M','₺740K','₺2,36M'], family:'revaluation' },
};

const paletteByFamily: Record<string,[string,string,string,string,string]> = {
  cashflow:['#0d8a4b','#e5484d','#2563eb','#f59e0b','#f2fbf6'], cashbook:['#0f766e','#2563eb','#e5484d','#f59e0b','#f0fdfa'], executive:['#166534','#2563eb','#7c3aed','#f59e0b','#f5f3ff'], debt:['#2563eb','#f97316','#e5484d','#16a34a','#eff6ff'], receivables:['#0f766e','#f59e0b','#e5484d','#2563eb','#f0fdfa'], maturity:['#b42318','#f97316','#f59e0b','#0f766e','#fff7ed'], profit:['#15803d','#2563eb','#f59e0b','#dc2626','#f0fdf4'], suite:['#075985','#15803d','#7c3aed','#f59e0b','#eff6ff'], pos:['#7c3aed','#2563eb','#16a34a','#f97316','#faf5ff'], project:['#0369a1','#16a34a','#f59e0b','#e5484d','#f0f9ff'], stock:['#7c3aed','#2563eb','#16a34a','#f59e0b','#faf5ff'], payroll:['#0891b2','#7c3aed','#16a34a','#f59e0b','#ecfeff'], import:['#0e7490','#2563eb','#f59e0b','#e5484d','#ecfeff'], sgk:['#15803d','#f59e0b','#2563eb','#7c3aed','#f0fdf4'], severance:['#9a3412','#e5484d','#f59e0b','#2563eb','#fff7ed'], wage:['#a16207','#f97316','#2563eb','#16a34a','#fffbeb'], overtime:['#9f1239','#e5484d','#f59e0b','#2563eb','#fff1f2'], tender:['#1d4ed8','#0f766e','#f59e0b','#e5484d','#eff6ff'], defense:['#5b21b6','#2563eb','#e5484d','#f59e0b','#f5f3ff'], progress:['#0f766e','#2563eb','#f59e0b','#e5484d','#f0fdfa'], withholding:['#854d0e','#f59e0b','#2563eb','#16a34a','#fffbeb'], subcontract:['#475569','#2563eb','#f59e0b','#16a34a','#f8fafc'], asset:['#475569','#0f766e','#f59e0b','#2563eb','#f8fafc'], fx:['#1d4ed8','#0f766e','#e5484d','#f59e0b','#eff6ff'], vat:['#7c3aed','#2563eb','#16a34a','#f59e0b','#faf5ff'], taxdefense:['#6b21a8','#e5484d','#f59e0b','#2563eb','#faf5ff'], kitchen:['#b45309','#e5484d','#16a34a','#2563eb','#fff7ed'], logistics:['#0369a1','#f97316','#16a34a','#e5484d','#f0f9ff'], adat:['#475569','#2563eb','#f59e0b','#e5484d','#f8fafc'], marketplace:['#7c3aed','#f97316','#2563eb','#16a34a','#faf5ff'], capital:['#991b1b','#e5484d','#f59e0b','#2563eb','#fff1f2'], branch:['#0f766e','#2563eb','#16a34a','#f59e0b','#f0fdfa'], recipe:['#4d7c0f','#f59e0b','#f97316','#2563eb','#f7fee7'], financing:['#1e40af','#7c3aed','#f59e0b','#16a34a','#eff6ff'], revaluation:['#166534','#0f766e','#f59e0b','#2563eb','#f0fdf4']
};

const fallback: Theme = { eyebrow:'EXCEL KARAR SİSTEMİ', sheet:'YÖNETİM PANELİ', labels:['TOPLAM','KONTROL','SONUÇ','RİSK'], metrics:['CANLI','OTOMATİK','HAZIR','İZLE'], accent:'#107c41', accent2:'#2563eb', accent3:'#f59e0b', accent4:'#e5484d', tint:'#f4faf6', family:'generic' };
const partial = themes[slug] ?? {};
const family = partial.family ?? 'generic';
const palette = paletteByFamily[family] ?? [fallback.accent,fallback.accent2,fallback.accent3,fallback.accent4,fallback.tint];
const config: Theme = { ...fallback, ...partial, accent:palette[0], accent2:palette[1], accent3:palette[2], accent4:palette[3], tint:palette[4], family };
let hash = 0; for (const ch of slug) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const layout = hash % 7;
const density = (hash >>> 3) % 3;
const cells = Array.from({ length: density === 0 ? 24 : density === 1 ? 30 : 36 });
const bars = Array.from({ length: 8 });
const rows = Array.from({ length: 5 });
---

<div class={`product-visual pv-family-${config.family} pv-layout-${layout} pv-density-${density}`} style={`--pv-a:${config.accent};--pv-b:${config.accent2};--pv-c:${config.accent3};--pv-d:${config.accent4};--pv-tint:${config.tint}`} aria-label={`${name} ürününe özel Excel önizlemesi`}>
  <div class="pv-glow pv-glow-a"></div><div class="pv-glow pv-glow-b"></div>
  <div class="pv-window">
    <div class="pv-titlebar"><span class="pv-app">X</span><b>{config.eyebrow}</b><small>{name.slice(0,28)}.xlsx</small><i></i><i></i><i></i></div>
    <div class="pv-tabs"><b>Dashboard</b><span>Girdi</span><span>Hesap</span><span>Analiz</span><span>Rapor</span></div>
    <div class="pv-kpis">
      {config.labels.map((label, i) => <div class={`kpi kpi-${i}`}><small>{label}</small><strong>{config.metrics[i]}</strong><em>{i===3?'● İzle':'↑ '+(12-i*2)+'%'}</em></div>)}
    </div>
    <div class="pv-main">
      <div class="pv-chart">
        <div class="pv-chart-head"><b>{config.sheet}</b><span><i></i>Gerçek</span><span><i></i>Plan</span><span><i></i>Risk</span></div>
        <div class="pv-plot">
          <div class="pv-bars">{bars.map((_,i)=><i style={`--h:${30 + ((hash >> (i%8)) % 61)}%`}></i>)}</div>
          <svg viewBox="0 0 240 82" preserveAspectRatio="none" aria-hidden="true"><polyline points="0,64 28,54 56,58 84,38 112,44 140,29 168,36 198,19 240,12" fill="none" stroke="var(--pv-b)" stroke-width="3" stroke-linecap="round"/><polyline points="0,70 28,66 56,63 84,58 112,52 140,48 168,41 198,38 240,31" fill="none" stroke="var(--pv-c)" stroke-width="2" stroke-dasharray="5 4"/></svg>
        </div>
      </div>
      <div class="pv-side">
        <div class="pv-donut"><span>{config.metrics[2]}</span></div>
        <div class="pv-risk"><small>RİSK SİNYALİ</small><b>{config.labels[3]}</b><strong>{config.metrics[3]}</strong><i></i></div>
      </div>
    </div>
    <div class="pv-bottom">
      <div class="pv-table"><div class="pv-table-head"><b>{config.sheet}</b><span>Oca</span><span>Şub</span><span>Mar</span><span>Nis</span><span>May</span></div>{rows.map((_,r)=><div class="pv-table-row"><b>{r===0?'Giriş':r===1?'Çıkış':r===2?'Net':r===3?'Fark':'Durum'}</b>{Array.from({length:5}).map((_,c)=><span class={(r+c+layout)%5===0?'hot':''}>{r===4?((c+r)%2?'İyi':'İzle'):(120+r*45+c*30)+'.000'}</span>)}</div>)}</div>
      <div class="pv-cells">{cells.map((_,i)=><i class={(i+layout)%7===0?'hot':''}></i>)}</div>
    </div>
    <div class="pv-footer"><span>✓ Otomatik hesaplama</span><span>● Canlı kontrol</span><b>EXCEL ARŞİV</b></div>
  </div>
</div>

<style>
.product-visual{position:relative;width:100%;height:100%;min-height:205px;padding:12px;overflow:hidden;background:linear-gradient(135deg,var(--pv-tint),#fff 55%,color-mix(in srgb,var(--pv-b) 7%,#fff));font-family:var(--font-mono);isolation:isolate}.pv-glow{position:absolute;width:130px;height:130px;border-radius:50%;filter:blur(42px);opacity:.16;z-index:-1}.pv-glow-a{left:-35px;top:-25px;background:var(--pv-a)}.pv-glow-b{right:-20px;bottom:-35px;background:var(--pv-b)}
.pv-window{height:100%;overflow:hidden;border:1px solid color-mix(in srgb,var(--pv-a) 20%,#dfe6e2);border-radius:15px;background:rgba(255,255,255,.97);box-shadow:0 18px 42px color-mix(in srgb,var(--pv-a) 12%,transparent)}
.pv-titlebar{display:flex;align-items:center;gap:6px;height:27px;padding:0 9px;border-bottom:1px solid #e9eeeb;background:linear-gradient(90deg,color-mix(in srgb,var(--pv-a) 8%,#fff),#fff);font-size:5.6px;color:#617068}.pv-app{display:grid;place-items:center;width:16px;height:16px;border-radius:3px;background:var(--pv-a);color:#fff;font-weight:900;font-size:8px}.pv-titlebar b{color:var(--pv-a);font-size:6.2px}.pv-titlebar small{margin-right:auto;max-width:115px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.pv-titlebar>i{width:5px;height:5px;border-radius:50%;background:#d8dfdb}.pv-titlebar>i:nth-last-child(3){background:var(--pv-d)}.pv-titlebar>i:nth-last-child(2){background:var(--pv-c)}.pv-titlebar>i:last-child{background:var(--pv-a)}
.pv-tabs{display:flex;gap:3px;padding:5px 8px 0}.pv-tabs>*{padding:3px 6px;border-radius:4px;font-size:4.7px;color:#7c8780}.pv-tabs b{background:color-mix(in srgb,var(--pv-a) 11%,#fff);color:var(--pv-a)}
.pv-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;padding:5px 8px}.kpi{min-width:0;padding:6px;border:1px solid #e7ece9;border-radius:7px;background:#fff}.kpi-0{border-color:color-mix(in srgb,var(--pv-a) 24%,#e7ece9);background:color-mix(in srgb,var(--pv-a) 5%,#fff)}.kpi-1{border-color:color-mix(in srgb,var(--pv-b) 24%,#e7ece9);background:color-mix(in srgb,var(--pv-b) 5%,#fff)}.kpi-2{border-color:color-mix(in srgb,var(--pv-c) 26%,#e7ece9);background:color-mix(in srgb,var(--pv-c) 6%,#fff)}.kpi-3{border-color:color-mix(in srgb,var(--pv-d) 24%,#e7ece9);background:color-mix(in srgb,var(--pv-d) 5%,#fff)}.kpi small{display:block;font-size:4.3px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#718078}.kpi strong{display:block;margin-top:2px;font-size:7.2px;color:#17231c;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.kpi em{display:block;margin-top:2px;font-size:4.1px;font-style:normal;color:var(--pv-a)}.kpi-3 em{color:var(--pv-d)}
.pv-main{display:grid;grid-template-columns:minmax(0,1fr) 82px;gap:6px;padding:0 8px 5px}.pv-chart,.pv-side>div,.pv-table,.pv-cells{border:1px solid #e9eeeb;border-radius:7px;background:#fff}.pv-chart{padding:6px}.pv-chart-head{display:flex;align-items:center;gap:7px;font-size:4.2px;color:#77837b}.pv-chart-head b{margin-right:auto;color:#34433a;font-size:4.8px}.pv-chart-head span i{display:inline-block;width:5px;height:5px;margin-right:3px;border-radius:1px;background:var(--pv-a)}.pv-chart-head span:nth-child(3) i{background:var(--pv-b)}.pv-chart-head span:nth-child(4) i{background:var(--pv-d)}.pv-plot{position:relative;height:52px;margin-top:4px;overflow:hidden;background:linear-gradient(#eef2ef 1px,transparent 1px);background-size:100% 13px}.pv-plot svg{position:absolute;inset:2px 0 0;width:100%;height:48px}.pv-bars{position:absolute;inset:5px 3px 4px;display:flex;align-items:flex-end;gap:5px}.pv-bars i{flex:1;height:var(--h);border-radius:2px 2px 0 0;background:linear-gradient(180deg,color-mix(in srgb,var(--pv-a) 75%,#fff),var(--pv-a));opacity:.72}.pv-bars i:nth-child(3n){background:linear-gradient(180deg,color-mix(in srgb,var(--pv-d) 62%,#fff),var(--pv-d));opacity:.42}
