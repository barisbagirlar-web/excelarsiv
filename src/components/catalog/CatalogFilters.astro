---
import { categories } from '../../lib/categories';

interface Props {
  active?: string;
}
const { active = '' } = Astro.props;
---

<nav class="catalog-filters" aria-label="Kategoriye göre filtrele">
  <button type="button" class="catalog-filters__chip" data-category-filter data-category="">
    Tümü
  </button>
  {
    categories.map((category) => (
      <button
        type="button"
        class="catalog-filters__chip"
        data-category-filter
        data-category={category.slug}
      >
        {category.name}
      </button>
    ))
  }
</nav>

<style>
  .catalog-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .catalog-filters__chip {
    min-height: 38px;
    padding: 0 16px;
    border: 1px solid var(--xl-border);
    border-radius: 999px;
    background: #fff;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--xl-ink-3);
    cursor: pointer;
    transition:
      border-color 150ms ease-out,
      background 150ms ease-out,
      color 150ms ease-out;
  }
  .catalog-filters__chip:hover {
    border-color: var(--xl-accent-border);
    color: var(--xl-ink-900);
  }
  .catalog-filters__chip.is-active {
    border-color: var(--xl-green);
    background: var(--xl-green);
    color: #fff;
  }
</style>
