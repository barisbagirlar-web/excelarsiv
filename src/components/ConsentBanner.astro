<div class="consent-layer" data-consent-layer hidden>
  <section class="consent-card" role="dialog" aria-modal="true" aria-labelledby="consent-title" aria-describedby="consent-description">
    <p class="consent-kicker">GİZLİLİK TERCİHLERİ</p>
    <h2 id="consent-title">Ölçüm izninizi siz belirleyin.</h2>
    <p id="consent-description">
      Zorunlu teknik depolama siteyi ve satın alma akışını çalıştırır. İzin verirseniz Google Analytics
      ölçüm etiketi yüklenir. Ölçüm izni pazarlama açık rızası değildir;
      <a href="/pazarlama-acik-riza">pazarlama açık rıza metni</a> ayrıdır. Seçiminiz bu tarayıcıda saklanır.
    </p>
    <div class="consent-actions">
      <button type="button" class="consent-secondary" data-consent-reject>Yalnızca Gerekli</button>
      <button type="button" class="consent-primary" data-consent-accept>Tümünü Kabul Et</button>
    </div>
  </section>
</div>

<button type="button" class="consent-manage" data-consent-manage hidden>Çerez Tercihleri</button>

<script>
  const layer = document.querySelector<HTMLElement>('[data-consent-layer]');
  const accept = document.querySelector<HTMLButtonElement>('[data-consent-accept]');
  const reject = document.querySelector<HTMLButtonElement>('[data-consent-reject]');
  const manage = document.querySelector<HTMLButtonElement>('[data-consent-manage]');

  const api = window.ExcelArsivConsent;
  if (layer && accept && reject && manage && api) {
    const showManager = () => {
      layer.hidden = false;
      manage.hidden = true;
      window.requestAnimationFrame(() => accept.focus());
    };
    const hideManager = () => {
      layer.hidden = true;
      manage.hidden = false;
    };
    const choose = (status: 'granted' | 'denied') => {
      api.setStatus(status);
      hideManager();
    };

    if (api.getStatus() === null) showManager();
    else hideManager();

    accept.addEventListener('click', () => choose('granted'));
    reject.addEventListener('click', () => choose('denied'));
    manage.addEventListener('click', showManager);
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && api.getStatus() !== null && !layer.hidden) hideManager();
    });
  }
</script>

<style>
  .consent-layer{position:fixed;inset:0;z-index:1000;display:grid;place-items:end center;padding:20px;background:rgba(14,29,20,.34);backdrop-filter:blur(3px)}
  .consent-layer[hidden],.consent-manage[hidden]{display:none!important}
  .consent-card{width:min(720px,100%);padding:22px;border:1px solid #cbdad1;border-radius:18px;background:#fff;box-shadow:0 24px 70px rgba(12,42,25,.24)}
  .consent-kicker{margin:0;font-family:var(--font-mono);font-size:9px;font-weight:800;letter-spacing:.12em;color:#0b7440}
  .consent-card h2{margin:7px 0 0;font-family:var(--font-display);font-size:25px;line-height:1.05;color:#14271d}
  .consent-card p:not(.consent-kicker){margin:11px 0 0;font-size:12px;line-height:1.6;color:#5d6c63}
  .consent-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:18px}
  .consent-actions button,.consent-manage{min-height:42px;border-radius:9px;padding:0 15px;font-family:var(--font-mono);font-size:10px;font-weight:800;cursor:pointer}
  .consent-primary{border:1px solid #0b7440;background:#0b7440;color:#fff}.consent-primary:hover{background:#075f34}
  .consent-secondary{border:1px solid #cbdad1;background:#fff;color:#294535}.consent-secondary:hover{border-color:#0b7440}
  .consent-manage{position:fixed;right:14px;bottom:14px;z-index:900;min-height:36px!important;border:1px solid #cbdad1;background:#fff;color:#355443;box-shadow:0 8px 24px rgba(12,42,25,.12)}
  @media(max-width:640px){.consent-layer{padding:12px}.consent-card{padding:18px 16px}.consent-card h2{font-size:22px}.consent-actions{display:grid;grid-template-columns:1fr}.consent-actions button{width:100%}.consent-primary{order:-1}.consent-manage{right:9px;bottom:9px}}
</style>
