---
interface Props {
  slug: string;
  name: string;
  summary: string;
  sheetCount: number;
  priceTL: number;
  /* v5 (opsiyonel) — mevcut çağrıları kırmadan zenginleştirir (I9) */
  category?: string;
  version?: string;
  variant?: 'sparkline' | 'hm' | 'bars';
  sheetMap?: { name: string; kind: 'input' | 'calculation' | 'output' }[];
}

const { slug, name, summary, sheetCount, priceTL, category, version, variant = 'sparkline', sheetMap } =
  Astro.props;

const price = priceTL.toLocaleString('tr-TR');

const kindLabel: Record<string, string> = {
  input: 'Girdi',
  calculation: 'Hesap',
  output: 'Çıktı',
};

const rows = (sheetMap ?? []).slice(0, 3);
---

<article class="wb" aria-label={name}>
  <div class="wb-title">
    <span class="xic" aria-hidden="true">X</span>
    <span class="truncate">{slug}.xlsx</span>
    {version && <span class="cf good" style="margin-left:auto">v{version}</span>}
  </div>
  <div class="wb-body">
    {
      variant === 'sparkline' && (
        <svg class="sp" viewBox="0 0 200 44" preserveAspectRatio="none" aria-hidden="true">
          <polyline points="0,36 28,30 56,33 84,22 112,26 140,15 168,19 200,8" />
          <circle class="last" cx="200" cy="8" r="3" />
        </svg>
      )
    }
    {
      variant === 'hm' && (
        <div class="hm" aria-hidden="true" style="margin-bottom:10px">
          <i style="--a:.2;--d:.4s"></i><i style="--a:.5;--d:.5s"></i><i style="--a:.85;--d:.6s"></i
          ><i style="--a:.35;--d:.7s"></i><i style="--a:.65;--d:.8s"></i><i style="--a:.95;--d:.9s"></i>
        </div>
      )
    }
    {
      variant === 'bars' && (
        <div class="bars" style="height:64px;margin-top:0" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i><i></i>
        </div>
      )
    }
    <p class="mt-2 font-mono text-[10.5px] leading-relaxed text-xl-ink-300 line-clamp-2">{summary}</p>
    {
      rows.length > 0 && (
        <>
          <span class="balloon" style="top:10px;right:10px">=B2*C2</span>
          <table>
            <tr>
              <th></th>
              <th>A</th>
              <th>B</th>
              <th>C</th>
            </tr>
            {
              rows.map((row, index) => (
                <tr>
                  <td>{index + 1}</td>
                  <td style="text-align:left">{row.name}</td>
                  <td class={index === 1 ? 'sel' : undefined}>{kindLabel[row.kind]}</td>
                  <td class="cf good">✓</td>
                </tr>
              ))
            }
          </table>
        </>
      )
    }
  </div>
  <div class="wb-foot">
    <span class="wb-tab">{category ?? `${sheetCount} sayfa`}</span>
    <span class="cf good price">{price} TL</span>
  </div>
</article>
