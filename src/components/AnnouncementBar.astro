---
interface Props {
  message?: string;
}

const { message = 'Demo dosyaları satın almadan önce ücretsiz incelenebilir.' } = Astro.props;
---

<div class="announcement-bar" role="status">
  <div class="container-site announcement-bar-inner">
    <span class="announcement-bar-icon" aria-hidden="true">✓</span>
    <span class="announcement-bar-text announcement-bar-text--desktop">{message}</span>
    <span class="announcement-bar-text announcement-bar-text--mobile">Satın almadan önce ücretsiz demo</span>
  </div>
</div>

<style>
  .announcement-bar {
    background: var(--xl-green);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.01em;
  }
  .announcement-bar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 32px;
    padding-block: 3px;
  }
  .announcement-bar-icon {
    display: inline-grid;
    place-items: center;
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.18);
    font-size: 10px;
    font-weight: 700;
  }
  .announcement-bar-text--mobile {
    display: none;
  }
  @media (max-width: 640px) {
    .announcement-bar {
      font-size: 10.5px;
    }
    .announcement-bar-inner {
      min-height: 28px;
      padding-inline: 12px;
      white-space: nowrap;
    }
    .announcement-bar-text--desktop {
      display: none;
    }
    .announcement-bar-text--mobile {
      display: inline;
    }
  }
</style>
