---
import type { SearchItem } from '../../lib/search';
import HeroSearch from './HeroSearch.astro';

interface Props {
  searchIndex: SearchItem[];
}

const { searchIndex } = Astro.props;
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="hero-section__shell">
    <h1 id="hero-title" class="sr-only">Excel Şablonları ve İşletme Çözümleri</h1>
    <picture class="hero-section__artwork">
      <img
        src="/images/hero.jpg"
        alt="Akıllı Kasa Defteri — gerçek Excel şablonunun önizlemesi"
        width="1600"
        height="533"
        fetchpriority="high"
      />
    </picture>
    <HeroSearch searchIndex={searchIndex} />
  </div>
</section>

<style>
  .hero-section__shell {
    position: relative;
    width: min(1440px, calc(100% - 40px));
    margin-inline: auto;
    padding-top: 28px;
  }
  .hero-section__artwork {
    display: block;
    overflow: hidden;
    border-radius: 28px;
    box-shadow: 0 32px 90px rgba(24, 55, 38, 0.16);
  }
  .hero-section__artwork img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 720px) {
    .hero-section__shell {
      width: calc(100% - 20px);
      padding-top: 12px;
    }
  }
</style>
