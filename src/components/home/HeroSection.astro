---
import type { SearchItem } from '../../lib/search';
import HeroSearch from './HeroSearch.astro';

interface Props {
  searchIndex: SearchItem[];
}

const { searchIndex } = Astro.props;
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="hero-shell">
    <h1 id="hero-title" class="sr-only">Excel Şablonları ve İşletme Çözümleri</h1>
    <picture class="hero-artwork">
      <source media="(max-width: 720px)" srcset="/images/hero-mobile.jpg" />
      <img
        src="/images/hero.jpg"
        alt="Excel şablonları ve finansal işletme çözümleri"
        width="1600"
        height="533"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-search-rail" id="hero-search">
      <HeroSearch searchIndex={searchIndex} />
    </div>
  </div>
</section>

<style>
  .hero-section { padding: 24px 0 54px; }
  .hero-shell { position: relative; width: min(1320px, calc(100% - 40px)); margin-inline: auto; padding-bottom: 34px; }
  .hero-artwork { position: relative; display: block; overflow: hidden; width: 100%; aspect-ratio: 3 / 1; border: 1px solid rgba(16,124,65,.12); border-radius: 22px; background:#eef3f6; box-shadow:0 20px 52px rgba(24,55,38,.11); }
  .hero-artwork img { display:block; width:100%; height:100%; object-fit:cover; object-position:center; }
  .hero-search-rail { position:absolute; left:50%; bottom:0; z-index:10; width:min(660px,calc(100% - 48px)); transform:translate(-50%,50%); scroll-margin-top:90px; }
  @media(max-width:720px){
    .hero-section{padding:12px 0 22px}.hero-shell{width:calc(100% - 24px);padding-bottom:0}.hero-artwork{aspect-ratio:358/294;min-height:0;border-radius:18px;box-shadow:0 14px 34px rgba(24,55,38,.09)}.hero-artwork img{object-fit:cover;object-position:center}.hero-search-rail{position:relative;left:auto;bottom:auto;width:100%;margin-top:10px;transform:none;scroll-margin-top:72px}
  }
</style>
