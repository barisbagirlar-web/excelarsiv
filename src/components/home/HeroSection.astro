---
import type { SearchItem } from '../../lib/search';
import HeroSearch from './HeroSearch.astro';

interface Props {
  searchIndex: SearchItem[];
}

const { searchIndex } = Astro.props;
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="hero-shell">
    <h1 id="hero-title" class="sr-only">Excel Şablonları ve İşletme Çözümleri</h1>
    <picture class="hero-artwork">
      <source media="(max-width: 720px)" srcset="/images/hero-mobile.jpg" />
      <img
        src="/images/hero.jpg"
        alt="Excel şablonları ve finansal işletme çözümleri"
        width="1600"
        height="533"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-search-rail" id="hero-search">
      <HeroSearch searchIndex={searchIndex} />
    </div>
  </div>
</section>

<style>
  .hero-section {
    margin-top: 28px;
    margin-bottom: 46px;
  }
  .hero-shell {
    position: relative;
    width: min(var(--container-wide), calc(100% - 48px));
    margin-inline: auto;
    padding-bottom: 28px;
  }
  .hero-artwork {
    position: relative;
    display: block;
    overflow: hidden;
    max-width: var(--container-wide);
    margin-inline: auto;
    aspect-ratio: 3 / 1;
    border: 1px solid rgba(16, 124, 65, 0.12);
    border-radius: 24px;
    background: #eef3f6;
    box-shadow: 0 24px 60px rgba(24, 55, 38, 0.13);
  }
  .hero-artwork img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-search-rail {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 10;
    width: min(660px, calc(100% - 48px));
    transform: translateX(-50%);
    scroll-margin-top: 90px;
  }
  @media (max-width: 720px) {
    .hero-section {
      margin-top: 12px;
      margin-bottom: 0;
    }
    .hero-shell {
      width: calc(100% - 24px);
      padding-bottom: 0;
    }
    .hero-artwork {
      border-radius: 18px;
    }
    .hero-search-rail {
      position: relative;
      left: auto;
      bottom: auto;
      transform: none;
      width: calc(100% - 24px);
      margin: -18px auto 0;
      scroll-margin-top: 72px;
    }
  }
</style>
