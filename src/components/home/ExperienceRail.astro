---
const stages = [
  { id: 'urunler', label: 'Ürünler' },
  { id: 'sistem', label: 'Sistem' },
  { id: 'kanit', label: 'Kanıt' },
  { id: 'kategoriler', label: 'Keşif' },
  { id: 'deger', label: 'Değer' },
  { id: 'satin-alma', label: 'Satın alma' },
];
---

<aside class="experience-rail" aria-label="Ana sayfa bölümleri" data-experience-rail>
  <span class="experience-rail__track" aria-hidden="true"><i data-experience-progress></i></span>
  <nav>
    {stages.map((stage, index) => (
      <a href={`#${stage.id}`} data-experience-link={stage.id} class={index === 0 ? 'is-active' : ''}>
        <span class="experience-rail__dot" aria-hidden="true"></span>
        <span class="experience-rail__label">{stage.label}</span>
      </a>
    ))}
  </nav>
</aside>

<script>
  document.querySelectorAll<HTMLElement>('[data-experience-rail]').forEach((rail) => {
    const links = [...rail.querySelectorAll<HTMLAnchorElement>('[data-experience-link]')];
    const progress = rail.querySelector<HTMLElement>('[data-experience-progress]');
    const ids = links.map((link) => link.dataset.experienceLink).filter(Boolean) as string[];
    const sections = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    if (!sections.length) return;

    const setActive = (id: string) => {
      const index = ids.indexOf(id);
      links.forEach((link) => link.classList.toggle('is-active', link.dataset.experienceLink === id));
      if (progress && index >= 0) {
        const pct = ids.length <= 1 ? 100 : (index / (ids.length - 1)) * 100;
        progress.style.height = `${pct}%`;
      }
    };

    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible?.target?.id) setActive(visible.target.id);
    }, { rootMargin: '-30% 0px -48% 0px', threshold: [0, .1, .25, .5, .75] });

    sections.forEach((section) => observer.observe(section));
  });
</script>

<style>
  .experience-rail{position:fixed;z-index:45;right:18px;top:50%;display:flex;align-items:stretch;gap:8px;transform:translateY(-50%);padding:12px 8px 12px 7px;border:1px solid rgba(20,58,39,.10);border-radius:20px;background:rgba(255,255,255,.78);backdrop-filter:blur(16px);box-shadow:0 12px 34px rgba(28,59,40,.08)}.experience-rail__track{position:absolute;left:15px;top:20px;bottom:20px;width:1px;background:#d7e0da;overflow:hidden}.experience-rail__track i{position:absolute;left:0;top:0;width:100%;height:0;background:var(--xl-green);transition:height .28s ease}.experience-rail nav{display:flex;flex-direction:column;gap:5px}.experience-rail a{position:relative;display:flex;align-items:center;min-height:28px;padding-left:0;color:#6d776f;text-decoration:none}.experience-rail__dot{position:relative;z-index:2;display:block;width:15px;height:15px;border:5px solid rgba(255,255,255,.92);border-radius:50%;background:#bdc8c0;box-shadow:0 0 0 1px #d5ddd8;transition:background .18s ease,transform .18s ease,box-shadow .18s ease}.experience-rail__label{position:absolute;right:24px;white-space:nowrap;padding:6px 8px;border-radius:8px;background:#0b3a28;color:#fff;font-family:var(--font-mono);font-size:8.5px;font-weight:700;letter-spacing:.02em;opacity:0;transform:translateX(5px);pointer-events:none;transition:opacity .18s ease,transform .18s ease;box-shadow:0 8px 22px rgba(11,58,40,.18)}.experience-rail a:hover .experience-rail__label,.experience-rail a:focus-visible .experience-rail__label,.experience-rail a.is-active .experience-rail__label{opacity:1;transform:none}.experience-rail a.is-active .experience-rail__dot{background:var(--xl-green);transform:scale(1.08);box-shadow:0 0 0 1px #8fbea2,0 0 0 5px rgba(16,124,65,.08)}
  @media(max-width:1180px){.experience-rail{display:none}}
  @media(prefers-reduced-motion:reduce){.experience-rail__track i,.experience-rail__dot,.experience-rail__label{transition:none}}
</style>
