---
import type { SearchItem } from '../../lib/search';

interface Props {
  searchIndex: SearchItem[];
}

const { searchIndex } = Astro.props;

const quickLinks = [
  { label: 'Nakit Akışı', href: '/sablonlar?q=nakit' },
  { label: 'Kasa', href: '/sablonlar?q=kasa' },
  { label: 'Cari Hesap', href: '/sablonlar?q=cari' },
  { label: 'Stok', href: '/sablonlar?q=stok' },
  { label: 'Kârlılık', href: '/sablonlar?q=kârlılık' },
];
---

<div class="hero-search" data-hero-search>
  <form class="hero-search__form" action="/sablonlar" method="get" role="search">
    <svg class="hero-search__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
      <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <input
      type="search"
      name="q"
      class="hero-search__input"
      placeholder="Şablon ara: kasa, cari, stok, KDV…"
      autocomplete="off"
      role="combobox"
      aria-label="Şablon ara"
      aria-expanded="false"
    />
    <button type="submit" class="hero-search__button" aria-label="Ara">
      <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
        <path d="M10.5 3a7.5 7.5 0 0 1 6.05 12.02l4.22 4.21-1.42 1.42-4.2-4.22A7.5 7.5 0 1 1 10.5 3Zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Z" fill="currentColor" />
      </svg>
    </button>
  </form>
  <ul class="hero-search__results" hidden></ul>
  <div class="hero-search__quick-wrap" aria-label="Popüler aramalar">
    <span class="hero-search__quick-label">Popüler</span>
    <div class="hero-search__quick">
      {quickLinks.map((link) => <a class="hero-search__quick-link" href={link.href}>{link.label}</a>)}
    </div>
  </div>
</div>

<script type="application/json" id="hero-search-index" set:html={JSON.stringify(searchIndex)}></script>
<script>
  import { mountHeroSearch } from '../../scripts/hero-search';
  const root = document.querySelector<HTMLElement>('[data-hero-search]');
  const indexEl = document.getElementById('hero-search-index');
  if (root && indexEl) mountHeroSearch(root, JSON.parse(indexEl.textContent ?? '[]'));
</script>

<style>
  .hero-search { position: relative; }
  .hero-search__form {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) 44px;
    align-items: center;
    min-height: 58px;
    padding: 6px 7px 6px 17px;
    border: 1px solid rgba(16, 124, 65, 0.18);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.985);
    box-shadow: 0 16px 38px rgba(24, 55, 38, 0.12), 0 2px 7px rgba(24, 55, 38, 0.05);
  }
  .hero-search__icon { color: var(--xl-ink-3); }
  .hero-search__input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-family: var(--font-body);
    font-size: 15.5px;
    color: var(--xl-ink-900);
  }
  .hero-search__input::placeholder { color: var(--xl-ink-3); opacity: 1; }
  .hero-search__button {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: var(--xl-green);
    color: #fff;
    cursor: pointer;
  }
  .hero-search__button:hover { background: var(--xl-accent-dark); }
  .hero-search__results {
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    z-index: 20;
    margin: 0;
    padding: 7px;
    list-style: none;
    background: #fff;
    border: 1px solid var(--xl-border);
    border-radius: 12px;
    box-shadow: 0 16px 40px rgba(27, 27, 31, 0.16);
    max-height: 280px;
    overflow-y: auto;
  }
  .hero-search__results a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 9px;
    text-decoration: none;
    color: inherit;
  }
  .hero-search__results a:hover,
  .hero-search__results a.is-highlighted { background: var(--xl-accent-soft); }
  .hero-search__name { font-size: 13.5px; font-weight: 600; color: var(--xl-ink-900); }
  .hero-search__meta { font-family: var(--font-mono); font-size: 10.5px; color: var(--xl-ink-3); }
  .hero-search__empty { padding: 10px 12px; font-size: 12.5px; color: var(--xl-ink-3); }
  .hero-search__quick-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 9px;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
  }
  .hero-search__quick-label { flex: 0 0 auto; color: var(--xl-ink-3); }
  .hero-search__quick {
    display: flex;
    gap: 7px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .hero-search__quick::-webkit-scrollbar { display: none; }
  .hero-search__quick-link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 9px;
    border: 1px solid var(--xl-grid);
    border-radius: 999px;
    background: rgba(255,255,255,.82);
    color: var(--xl-ink-900);
    text-decoration: none;
    white-space: nowrap;
  }
  .hero-search__quick-link:hover { color: var(--xl-green-dark); border-color: var(--xl-accent-border); }

  @media (max-width: 720px) {
    .hero-search__form {
      grid-template-columns: 20px minmax(0, 1fr) 42px;
      min-height: 54px;
      padding: 5px 6px 5px 15px;
      border-radius: 15px;
      box-shadow: 0 10px 24px rgba(24, 55, 38, 0.09);
    }
    .hero-search__input { font-size: 14px; }
    .hero-search__button { width: 42px; height: 42px; border-radius: 11px; }
    .hero-search__results { top: 60px; }
    .hero-search__quick-wrap { margin-top: 8px; }
  }
</style>
