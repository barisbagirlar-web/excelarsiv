---
import type { SearchItem } from '../../lib/search';

interface Props {
  searchIndex: SearchItem[];
}

const { searchIndex } = Astro.props;

const quickLinks = [
  { label: 'Nakit Akışı', href: '/sablonlar?q=nakit' },
  { label: 'Kasa', href: '/sablonlar?q=kasa' },
  { label: 'Cari Hesap', href: '/sablonlar?q=cari' },
  { label: 'Stok', href: '/sablonlar?q=stok' },
  { label: 'Kârlılık', href: '/sablonlar?q=kârlılık' },
];
---

<div class="hero-search" data-hero-search>
  <form class="hero-search__form" action="/sablonlar" method="get" role="search">
    <svg class="hero-search__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
      <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <input
      type="search"
      name="q"
      class="hero-search__input"
      placeholder="Şablon ara: kasa, cari, stok, KDV…"
      autocomplete="off"
      role="combobox"
      aria-label="Şablon ara"
      aria-expanded="false"
    />
    <button type="submit" class="hero-search__button" aria-label="Ara">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path
          d="M10.5 3a7.5 7.5 0 0 1 6.05 12.02l4.22 4.21-1.42 1.42-4.2-4.22A7.5 7.5 0 1 1 10.5 3Zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Z"
          fill="currentColor"
        />
      </svg>
    </button>
  </form>
  <ul class="hero-search__results" hidden></ul>
  <p class="hero-search__quick">
    <span class="hero-search__quick-label">Popüler:</span>
    {
      quickLinks.map((link, index) => (
        <>
          {index > 0 && <span class="hero-search__quick-dot" aria-hidden="true">·</span>}
          <a class="hero-search__quick-link" href={link.href}>{link.label}</a>
        </>
      ))
    }
  </p>
</div>

<script type="application/json" id="hero-search-index" set:html={JSON.stringify(searchIndex)}></script>
<script>
  import { mountHeroSearch } from '../../scripts/hero-search';
  const root = document.querySelector<HTMLElement>('[data-hero-search]');
  const indexEl = document.getElementById('hero-search-index');
  if (root && indexEl) {
    mountHeroSearch(root, JSON.parse(indexEl.textContent ?? '[]'));
  }
</script>

<style>
  .hero-search {
    position: relative;
  }
  .hero-search__form {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) 44px;
    align-items: center;
    min-height: 58px;
    padding: 6px 8px 6px 18px;
    border: 1px solid rgba(16, 124, 65, 0.18);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow:
      0 18px 44px rgba(24, 55, 38, 0.13),
      0 3px 9px rgba(24, 55, 38, 0.05);
  }
  .hero-search__icon {
    color: var(--xl-ink-3);
  }
  .hero-search__input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--xl-ink-900);
  }
  .hero-search__input::placeholder {
    color: var(--xl-ink-3);
    opacity: 1;
  }
  .hero-search__button {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: var(--xl-green);
    color: #fff;
    cursor: pointer;
    transition: background 150ms ease-out;
  }
  .hero-search__button:hover {
    background: var(--xl-accent-dark);
  }
  .hero-search__results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: #fff;
    border: 1px solid var(--xl-border);
    border-radius: 12px;
    box-shadow: 0 16px 40px rgba(27, 27, 31, 0.16);
    max-height: 300px;
    overflow-y: auto;
  }
  .hero-search__results a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
  }
  .hero-search__results a:hover,
  .hero-search__results a.is-highlighted {
    background: var(--xl-accent-soft);
  }
  .hero-search__name {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--xl-ink-900);
  }
  .hero-search__meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--xl-ink-3);
  }
  .hero-search__empty {
    padding: 12px 14px;
    font-size: 13px;
    color: var(--xl-ink-3);
  }
  .hero-search__quick {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 10px;
    margin: 8px 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--xl-ink-3);
  }
  .hero-search__quick-dot {
    color: rgba(98, 113, 104, 0.5);
  }
  .hero-search__quick-link {
    color: var(--xl-ink-900);
    text-decoration: none;
    transition: color 150ms ease-out;
  }
  .hero-search__quick-link:hover {
    color: var(--xl-green-dark);
  }
</style>
