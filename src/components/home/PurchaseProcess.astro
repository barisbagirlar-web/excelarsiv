---
const steps = [
  { code: '01', title: 'Demo ile görün', description: 'Ürün sayfasındaki örnek dosyayı satın almadan önce inceleyin.', icon: '↓' },
  { code: '02', title: 'Shopier ile ödeyin', description: 'Ödeme Shopier altyapısında işlenir; kart bilgisi Excel Arşiv’de tutulmaz.', icon: '✓' },
  { code: '03', title: 'Siteden indirin', description: 'Ödeme doğrulanınca ürün sayfasındaki Excel’i İndir butonu otomatik açılır.', icon: '→' },
];
---

<section class="purchase-band" aria-labelledby="purchase-title">
  <div class="site-container">
    <div class="purchase-band__head">
      <div>
        <span class="section-head__kicker">SATIN ALMA DENEYİMİ</span>
        <h2 id="purchase-title">Karar zor olabilir; <em>satın alma süreci değil.</em></h2>
      </div>
      <p>Önce dosyayı görürsünüz. Ödemeyi Shopier’de tamamlarsınız. Ödeme doğrulanınca dosyayı ExcelArşiv’den indirirsiniz.</p>
    </div>

    <ol class="purchase-band__rail">
      {steps.map((step) => (
        <li class="purchase-band__step">
          <div class="purchase-band__icon" aria-hidden="true">{step.icon}</div>
          <div>
            <span>{step.code}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="purchase-band__trust" aria-label="Satın alma güvenceleri">
      <span>✓ Shopier ile güvenli ödeme</span>
      <span>✓ KDV dahil fiyat</span>
      <span>✓ Site üzerinden güvenli indirme</span>
      <a href="/teslimat-ve-iade">Teslimat ve iade koşulları <b aria-hidden="true">→</b></a>
    </div>
  </div>
</section>

<style>
  .purchase-band { padding-block:clamp(64px,7vw,92px); background:#eef4f5; border-block:1px solid #dbe5e7; }
  .purchase-band__head { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr); gap:54px; align-items:end; margin-bottom:28px; }
  .purchase-band__head h2 { max-width:720px; margin:10px 0 0; font-family:var(--font-display); font-size:clamp(34px,4.2vw,56px); line-height:.98; letter-spacing:-.04em; color:#1d2726; }.purchase-band__head h2 em{font-style:normal;color:#0f7b43}.purchase-band__head>p{margin:0;font-size:13.5px;line-height:1.65;color:#637170}
  .purchase-band__rail { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); margin:0; padding:0; list-style:none; border-block:1px solid #cfdcdf; }
  .purchase-band__step { display:grid; grid-template-columns:48px minmax(0,1fr); gap:14px; min-width:0; padding:25px 26px; }.purchase-band__step+ .purchase-band__step{border-left:1px solid #cfdcdf}.purchase-band__icon{display:grid;place-items:center;width:42px;height:42px;border-radius:14px;background:#fff;border:1px solid #cfddda;color:#0f7b43;font-family:var(--font-mono);font-size:15px;font-weight:700}.purchase-band__step span{font-family:var(--font-mono);font-size:8px;font-weight:700;letter-spacing:.08em;color:#0f7b43}.purchase-band__step h3{margin:5px 0 0;font-size:17px;color:#1f2926}.purchase-band__step p{margin:7px 0 0;font-size:11.5px;line-height:1.55;color:#667370}
  .purchase-band__trust { display:flex; flex-wrap:wrap; align-items:center; gap:10px 24px; padding-top:18px; font-family:var(--font-mono); font-size:9.5px; color:#596b65; }.purchase-band__trust span{white-space:nowrap}.purchase-band__trust a{margin-left:auto;color:#0d6e3b;font-weight:700;text-decoration:none}.purchase-band__trust b{font-weight:700}
  @media(max-width:850px){.purchase-band__rail{grid-template-columns:1fr}.purchase-band__step+ .purchase-band__step{border-left:0;border-top:1px solid #cfdcdf}.purchase-band__trust a{margin-left:0}}
  @media(max-width:640px){.purchase-band{padding-block:46px}.purchase-band__head{grid-template-columns:1fr;gap:11px;margin-bottom:18px}.purchase-band__head h2{font-size:33px}.purchase-band__head>p{font-size:12px;line-height:1.5}.purchase-band__step{grid-template-columns:38px minmax(0,1fr);gap:11px;padding:16px 4px}.purchase-band__icon{width:34px;height:34px;border-radius:10px}.purchase-band__step h3{font-size:15px}.purchase-band__step p{font-size:10.5px}.purchase-band__trust{gap:8px 12px;font-size:8.5px;padding-top:14px}.purchase-band__trust a{width:100%;margin-top:4px}}
</style>
