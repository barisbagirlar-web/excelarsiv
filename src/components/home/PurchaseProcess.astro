---
const steps = [
  {
    code: '01',
    title: 'Demo ile inceleyin',
    description: 'Ürün sayfasındaki ücretsiz demo dosyayı indirip yapıyı görün.',
  },
  {
    code: '02',
    title: 'Shopier ile ödeyin',
    description: 'Güvenli ödeme sayfasına yönlendirilirsiniz; kart bilgisi burada saklanmaz.',
  },
  {
    code: '03',
    title: 'E-postayla teslim',
    description: 'Ödeme onayıyla birlikte dosya indirme bağlantısı e-postanıza gelir.',
  },
];
---

<section class="site-section site-section--alt" aria-labelledby="purchase-title">
  <div class="site-container">
    <div class="section-head">
      <span class="section-head__kicker">SATIN ALMA SÜRECİ</span>
      <h2 id="purchase-title" class="section-head__title">Üç adımda elinizde</h2>
      <p class="section-head__lead">
        Kredi kartı bilginiz yalnızca Shopier'de işlenir; Excel Arşiv ödeme bilgisi saklamaz.
      </p>
    </div>
    <ol class="purchase-grid">
      {
        steps.map((step, index) => (
          <li class="purchase-card">
            <span class="purchase-card__code">{step.code}</span>
            <h3 class="purchase-card__title">{step.title}</h3>
            <p class="purchase-card__text">{step.description}</p>
            {index < steps.length - 1 && <span class="purchase-card__arrow" aria-hidden="true">→</span>}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .purchase-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .purchase-grid > * {
    min-width: 0;
  }
  .purchase-card {
    position: relative;
    min-height: 150px;
    padding: 20px;
    border: 1px solid var(--xl-border);
    border-radius: 20px;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .purchase-card__code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    color: var(--xl-green);
  }
  .purchase-card__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 15.5px;
    font-weight: 700;
    color: var(--xl-ink-900);
  }
  .purchase-card__text {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--xl-ink-3);
  }
  .purchase-card__arrow {
    position: absolute;
    right: -16px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--xl-green);
    color: #fff;
    font-size: 13px;
    box-shadow: 0 4px 10px rgba(24, 55, 38, 0.18);
  }
  @media (max-width: 760px) {
    .purchase-grid {
      grid-template-columns: 1fr;
    }
    .purchase-card__arrow {
      display: none;
    }
    .purchase-card {
      min-height: 0;
    }
  }
</style>
