---
const badges = [
  { label: 'VUK', note: 'uyumlu şablonlar' },
  { label: 'TFRS', note: 'uyumlu yapılar' },
  { label: 'Shopier', note: '· Güvenli Ödeme' },
];
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <div class="site-container final-cta__inner">
    <span class="section-head__kicker section-head__kicker--light">BAŞLANGIÇ</span>
    <h2 id="final-cta-title" class="final-cta__title">
      Bugün <em>başlayın</em>
    </h2>
    <p class="final-cta__lead">
      Demo dosyayla inceleyin, beğenin, ödeyin — teslimat e-postayla. Kredi kartı bilginiz yalnızca
      Shopier'de işlenir.
    </p>
    <div class="final-cta__actions">
      <a class="final-cta__btn final-cta__btn--primary" href="/sablonlar">
        Şablonları İncele <span aria-hidden="true">→</span>
      </a>
      <a class="final-cta__btn" href="/nasil-calisir">
        Nasıl Çalışır <span aria-hidden="true">↓</span>
      </a>
    </div>
    <ul class="final-cta__badges">
      {
        badges.map((badge) => (
          <li>
            <span class="final-cta__badge-label">{badge.label}</span> {badge.note}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .final-cta {
    padding-block: clamp(64px, 8vw, 108px);
    background:
      radial-gradient(1200px 420px at 50% -80px, rgba(16, 124, 65, 0.14), transparent 70%),
      var(--xl-paper);
    border-top: 1px solid var(--xl-grid);
  }
  .final-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .final-cta__title {
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.08;
    color: var(--xl-ink-900);
  }
  .final-cta__title em {
    color: var(--xl-green);
    font-style: normal;
  }
  .final-cta__lead {
    max-width: 560px;
    margin: 18px 0 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--xl-ink-3);
  }
  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }
  .final-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 26px;
    border: 1px solid var(--xl-border);
    border-radius: 12px;
    background: #fff;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--xl-ink-900);
    text-decoration: none;
    transition:
      border-color 150ms ease-out,
      transform 150ms ease-out;
  }
  .final-cta__btn:hover {
    border-color: var(--xl-accent-border);
    transform: translateY(-1px);
  }
  .final-cta__btn--primary {
    border-color: var(--xl-green);
    background: var(--xl-green);
    color: #fff;
  }
  .final-cta__btn--primary:hover {
    border-color: var(--xl-accent-dark);
    background: var(--xl-accent-dark);
  }
  .final-cta__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 20px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--xl-ink-3);
  }
  .final-cta__badge-label {
    font-weight: 700;
    color: var(--xl-green);
  }
</style>
