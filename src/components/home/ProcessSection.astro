---
const steps = [
  {
    title: 'İhtiyaç analizi',
    description: 'Çözülecek iş problemi ve raporlama dönemi tanımlanır.',
    viz: 'cells',
  },
  {
    title: 'Model kurulumu',
    description: 'Formül, adlandırılmış aralık ve veri doğrulama kurulur.',
    viz: 'fx',
  },
  {
    title: 'Gerçek veriyle test',
    description: 'Farklı sürümlerde sonuçlar doğrulanır.',
    viz: 'tick',
  },
  {
    title: 'Belgeleme',
    description: 'Girdi ve hesaplama mantığı dosyanın içinde açıklanır.',
    viz: 'docs',
  },
];
---

<section class="site-section" aria-labelledby="process-title">
  <div class="site-container">
    <div class="section-head">
      <span class="section-head__kicker">ÜRETİM SÜRECİ</span>
      <h2 id="process-title" class="section-head__title">Bu dosyalar nasıl hazırlanıyor?</h2>
      <p class="section-head__lead">
        Her şablon aynı dört adımla üretilir; çıktısı gerçek iş verisiyle test edilmiş dosyadır.
      </p>
    </div>
    <ol class="process-grid">
      {
        steps.map((step, index) => (
          <li class="process-card">
            <span class="process-card__viz" aria-hidden="true">
              {step.viz === 'cells' && (
                <svg viewBox="0 0 40 28" class="process-card__svg">
                  <rect x="1" y="1" width="38" height="26" rx="3" fill="none" stroke="var(--xl-green)" stroke-width="1.5" />
                  <path d="M13 1v26M27 1v26M1 14h38" stroke="var(--xl-grid)" stroke-width="1" />
                  <rect x="4" y="5" width="6" height="6" rx="1" fill="var(--xl-green)" />
                  <rect x="4" y="17" width="6" height="6" rx="1" fill="var(--xl-accent-border)" />
                </svg>
              )}
              {step.viz === 'fx' && (
                <svg viewBox="0 0 40 28" class="process-card__svg">
                  <path d="M4 22h32" stroke="var(--xl-grid)" stroke-width="1" />
                  <text x="4" y="14" font-family="monospace" font-size="11" fill="var(--xl-green)">fx =B1+B2</text>
                </svg>
              )}
              {step.viz === 'tick' && (
                <svg viewBox="0 0 40 28" class="process-card__svg">
                  <circle cx="20" cy="14" r="12" fill="none" stroke="var(--xl-green)" stroke-width="1.5" />
                  <path d="M14 14l4 4 8-9" fill="none" stroke="var(--xl-green)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {step.viz === 'docs' && (
                <svg viewBox="0 0 40 28" class="process-card__svg">
                  <path d="M8 3h16l8 8v14H8z" fill="none" stroke="var(--xl-green)" stroke-width="1.5" stroke-linejoin="round" />
                  <path d="M24 3v8h8M12 17h12M12 22h8" stroke="var(--xl-green)" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              )}
            </span>
            <span class="process-card__number">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="process-card__title">{step.title}</h3>
            <p class="process-card__text">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .process-grid > * {
    min-width: 0;
  }
  .process-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 185px;
    padding: 20px;
    border: 1px solid var(--xl-border);
    border-radius: 18px;
    background: #fff;
    border-top: 3px solid var(--xl-green);
  }
  .process-card__viz {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 48px;
    margin-bottom: 10px;
    border-radius: 12px;
    background: var(--xl-accent-soft);
  }
  .process-card__svg {
    width: 42px;
    height: 28px;
  }
  .process-card__number {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--xl-green);
  }
  .process-card__title {
    margin: 6px 0 4px;
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 700;
    color: var(--xl-ink-900);
  }
  .process-card__text {
    margin: 0;
    font-size: 12px;
    line-height: 1.55;
    color: var(--xl-ink-3);
  }
  @media (max-width: 1024px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 680px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
