---
const steps = [
  {
    title: 'İhtiyaç analizi',
    description: 'Dosyanın çözeceği iş problemini, çıktı biçimini ve raporlama dönemini tanımlıyoruz.',
  },
  {
    title: 'Model kurulumu',
    description: 'Formüller, adlandırılmış aralıklar, veri doğrulama ve sayfa korumalarıyla yapıyı kuruyoruz.',
  },
  {
    title: 'Gerçek veriyle test',
    description: 'Farklı Excel sürümlerinde ve gerçek iş senaryolarıyla sonuçları doğruluyoruz.',
  },
  {
    title: 'Belgeleme',
    description: 'Girdi alanlarını, hesaplama mantığını ve uyarıları dosyanın içinde açıklıyoruz.',
  },
];
---

<section class="site-section" aria-labelledby="process-title">
  <div class="site-container">
    <div class="section-head">
      <span class="section-head__kicker">ÜRETİM SÜRECİ</span>
      <h2 id="process-title" class="section-head__title">Bu dosyalar nasıl hazırlanıyor?</h2>
      <p class="section-head__lead">
        Her şablon aynı dört adımla üretilir; çıktısı gerçek iş verisiyle test edilmiş dosyadır.
      </p>
    </div>
    <ol class="process-grid">
      {
        steps.map((step, index) => (
          <li class="process-card">
            <span class="process-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="process-card__title">{step.title}</h3>
            <p class="process-card__text">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .process-grid > * {
    min-width: 0;
  }
  .process-card {
    padding: 24px;
    border-top: 3px solid var(--xl-green);
    border-radius: 0 0 14px 14px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(24, 55, 38, 0.06);
  }
  .process-card__number {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--xl-green);
  }
  .process-card__title {
    margin: 10px 0 6px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    color: var(--xl-ink-900);
  }
  .process-card__text {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--xl-ink-3);
  }
  @media (max-width: 900px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
