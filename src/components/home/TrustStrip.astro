<section class="proof-rail" aria-label="Satın alma güvenceleri">
  <div class="site-container proof-rail__inner">
    <div class="proof-rail__item is-accent">
      <span class="proof-rail__icon" aria-hidden="true">↓</span>
      <div><strong>Önce demo</strong><small>Dosyanın yapısını satın almadan önce görün.</small></div>
    </div>
    <div class="proof-rail__item">
      <span class="proof-rail__icon" aria-hidden="true">₺</span>
      <div><strong>KDV dahil</strong><small>Gösterilen fiyatın üzerine vergi eklenmez.</small></div>
    </div>
    <div class="proof-rail__item">
      <span class="proof-rail__icon" aria-hidden="true">1×</span>
      <div><strong>Tek ödeme</strong><small>Abonelik olmadan satın alın.</small></div>
    </div>
    <div class="proof-rail__item">
      <span class="proof-rail__icon" aria-hidden="true">✓</span>
      <div><strong>Shopier ödeme</strong><small>Kart bilgisi Excel Arşiv'de saklanmaz.</small></div>
    </div>
  </div>
</section>

<style>
  .proof-rail { background:#fff; border-block:1px solid var(--xl-grid); }
  .proof-rail__inner { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); padding-block:0; }
  .proof-rail__item { display:grid; grid-template-columns:34px minmax(0,1fr); gap:10px; align-items:center; min-height:92px; padding:18px 20px; border-right:1px solid var(--xl-grid); }.proof-rail__item:first-child{border-left:1px solid var(--xl-grid)}.proof-rail__item.is-accent{background:#f1f8f4}
  .proof-rail__icon { display:grid; place-items:center; width:32px; height:32px; border-radius:10px; background:#edf5f0; color:var(--xl-green-dark); font-family:var(--font-mono); font-size:10px; font-weight:800; }.is-accent .proof-rail__icon{background:var(--xl-green);color:#fff}
  .proof-rail__item div{min-width:0}.proof-rail__item strong{display:block;font-size:12.5px;color:var(--xl-ink-900)}.proof-rail__item small{display:block;margin-top:3px;font-size:10px;line-height:1.4;color:#3a4a41;font-weight:500}
  @media(max-width:900px){.proof-rail__inner{grid-template-columns:repeat(2,minmax(0,1fr))}.proof-rail__item:nth-child(2){border-right:1px solid var(--xl-grid)}.proof-rail__item:nth-child(3),.proof-rail__item:nth-child(4){border-top:1px solid var(--xl-grid)}}
  @media(max-width:560px){.proof-rail__inner{grid-template-columns:repeat(2,minmax(0,1fr));width:100%;}.proof-rail__item{grid-template-columns:28px minmax(0,1fr);gap:8px;min-height:76px;padding:12px;border-right:1px solid var(--xl-grid)}.proof-rail__item:first-child{border-left:0}.proof-rail__item:nth-child(2n){border-right:0}.proof-rail__icon{width:28px;height:28px;border-radius:9px;font-size:8.5px}.proof-rail__item strong{font-size:11px}.proof-rail__item small{font-size:8.8px;line-height:1.3}}
</style>
