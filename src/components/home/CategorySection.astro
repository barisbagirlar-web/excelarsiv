---
import { categories } from '../../lib/categories';
---

<section class="site-section" aria-labelledby="category-title">
  <div class="site-container">
    <div class="section-head">
      <span class="section-head__kicker">KATEGORİLER</span>
      <h2 id="category-title" class="section-head__title">İhtiyacınıza göre seçin</h2>
      <p class="section-head__lead">
        Finans, muhasebe ve operasyon işlerinize özel kategorilerdeki hazır Excel sistemlerine göz atın.
      </p>
    </div>
    <ul class="category-grid">
      {
        categories.map((category) => (
          <li>
            <a class="category-card" href={`/sablonlar/${category.slug}`}>
              <span class="category-card__code" aria-hidden="true">{category.slug.slice(0, 2).toUpperCase()}</span>
              <span class="category-card__name">{category.name}</span>
              <span class="category-card__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .category-grid > * {
    min-width: 0;
  }
  .category-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    height: 100%;
    padding: 20px;
    border: 1px solid var(--xl-border);
    border-radius: 16px;
    background: #fff;
    text-decoration: none;
    transition:
      border-color 150ms ease-out,
      transform 150ms ease-out,
      box-shadow 150ms ease-out;
  }
  .category-card:hover {
    border-color: var(--xl-accent-border);
    transform: translateY(-2px);
    box-shadow: 0 14px 34px rgba(24, 55, 38, 0.1);
  }
  .category-card__code {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--xl-green);
  }
  .category-card__name {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    color: var(--xl-ink-900);
  }
  .category-card__arrow {
    margin-top: auto;
    font-size: 16px;
    color: var(--xl-ink-3);
  }
  @media (max-width: 1024px) {
    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
