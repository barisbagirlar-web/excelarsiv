---
import CatalogProductVisual from '../catalog/CatalogProductVisual.astro';
import type { TemplateViewModel } from '../../lib/templates';

interface Props { templates: TemplateViewModel[]; }
const { templates } = Astro.props;
const money = (value:number) => value.toLocaleString('tr-TR');
const featured = templates.slice(0,7);
const accents = ['#0d8a4b','#2563eb','#7c3aed','#f97316','#0f766e','#e5484d','#0891b2'];
---

<section class="premium-showcase" aria-labelledby="premium-showcase-title">
  <div class="site-container">
    <header class="premium-showcase__head">
      <div>
        <span class="premium-showcase__kicker">KURULU EXCEL SİSTEMLERİ · PREMIUM VİTRİN</span>
        <h2 id="premium-showcase-title">Her ürün <em>kendi karar ekranıyla</em> gelir.</h2>
        <p>Aynı kartın farklı isimle çoğaltılmış hali değil. Her sistem; iş problemine göre farklı KPI, grafik, risk sinyali ve Excel çalışma düzeniyle gösterilir.</p>
      </div>
      <a href="/sablonlar">Tüm sistemleri inceleyin <span aria-hidden="true">→</span></a>
    </header>

    <div class="premium-showcase__grid">
      {featured.map((template,index) => (
        <article class={`premium-card premium-card--${index+1}`} style={`--card-accent:${accents[index]};`}>
          <div class="premium-card__copy">
            <div class="premium-card__meta"><span>0{index+1}</span><b>{template.categoryName}</b><i>{template.sheetCount} sayfa</i></div>
            <h3>{template.name}</h3>
            <p>{template.summary}</p>
            <div class="premium-card__chips">
              {(template.outputs?.slice(0,3) ?? []).map((item)=><span>{item}</span>)}
            </div>
            <div class="premium-card__foot">
              <strong>{money(template.priceTL)} TL</strong>
              <a href={`/sablon/${template.slug}`}>Sistemi inceleyin <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <a class="premium-card__visual" href={`/sablon/${template.slug}`} aria-label={`${template.name} ürününü incele`}>
            <CatalogProductVisual slug={template.slug} name={template.name} />
            <span class="premium-card__live">ÜRÜNE ÖZEL EXCEL GÖRSELİ</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.premium-showcase{padding-block:clamp(72px,8vw,112px);background:radial-gradient(900px 360px at 50% -120px,rgba(16,124,65,.09),transparent 70%),#fff;border-bottom:1px solid var(--xl-grid)}
.premium-showcase__head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:36px;align-items:end;margin-bottom:28px}.premium-showcase__kicker{font:800 9px var(--font-mono);letter-spacing:.11em;color:var(--xl-green-dark)}.premium-showcase__head h2{max-width:820px;margin:9px 0 0;font-family:var(--font-display);font-size:clamp(38px,4.8vw,66px);line-height:.98;letter-spacing:-.045em;color:var(--xl-ink-900)}.premium-showcase__head h2 em{font-style:normal;color:var(--xl-green)}.premium-showcase__head p{max-width:760px;margin:16px 0 0;font-size:14px;line-height:1.65;color:var(--xl-ink-3)}.premium-showcase__head>a{color:var(--xl-green-dark);font:800 10px var(--font-mono);text-decoration:none;white-space:nowrap}
.premium-showcase__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.premium-card{display:grid;grid-template-columns:minmax(230px,.78fr) minmax(0,1.22fr);min-height:330px;overflow:hidden;border:1px solid color-mix(in srgb,var(--card-accent) 24%,#dce4df);border-radius:24px;background:linear-gradient(135deg,color-mix(in srgb,var(--card-accent) 5%,#fff),#fff 46%,color-mix(in srgb,var(--card-accent) 7%,#fff));box-shadow:0 14px 40px color-mix(in srgb,var(--card-accent) 10%,transparent);transition:transform 180ms ease,box-shadow 180ms ease}.premium-card:hover{transform:translateY(-5px);box-shadow:0 26px 60px color-mix(in srgb,var(--card-accent) 16%,transparent)}
.premium-card__copy{display:flex;flex-direction:column;padding:24px 10px 22px 24px;min-width:0}.premium-card__meta{display:flex;align-items:center;gap:7px;font:800 7.5px var(--font-mono);color:#728078}.premium-card__meta span{display:grid;place-items:center;width:24px;height:24px;border-radius:8px;background:color-mix(in srgb,var(--card-accent) 12%,#fff);color:var(--card-accent)}.premium-card__meta b{color:var(--card-accent)}.premium-card__meta i{font-style:normal;margin-left:auto}.premium-card h3{margin:14px 0 0;font-size:clamp(20px,2vw,28px);line-height:1.06;letter-spacing:-.025em;color:var(--xl-ink-900)}.premium-card__copy>p{margin:9px 0 0;font-size:11px;line-height:1.52;color:var(--xl-ink-3);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.premium-card__chips{display:grid;gap:5px;margin-top:14px}.premium-card__chips span{display:block;padding:6px 8px;border-radius:7px;background:color-mix(in srgb,var(--card-accent) 6%,#fff);border:1px solid color-mix(in srgb,var(--card-accent) 13%,#e6ece8);font:700 7.5px var(--font-mono);color:#506058;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.premium-card__foot{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-top:auto;padding-top:15px}.premium-card__foot strong{font:800 20px var(--font-mono);color:var(--card-accent)}.premium-card__foot a{display:inline-flex;align-items:center;gap:5px;min-height:38px;padding:0 11px;border-radius:10px;background:var(--card-accent);color:#fff;font:800 8px var(--font-mono);text-decoration:none}
.premium-card__visual{position:relative;display:block;min-width:0;margin:15px 15px 15px 6px;overflow:hidden;border-radius:18px;text-decoration:none;box-shadow:0 14px 36px rgba(21,53,35,.10)}.premium-card__visual :global(.product-visual){min-height:300px;transition:transform 220ms ease,filter 220ms ease}.premium-card:hover .premium-card__visual :global(.product-visual){transform:scale(1.018);filter:saturate(1.08)}.premium-card__live{position:absolute;right:10px;bottom:10px;z-index:4;padding:6px 8px;border-radius:7px;background:rgba(255,255,255,.92);backdrop-filter:blur(8px);font:800 6.5px var(--font-mono);letter-spacing:.06em;color:var(--card-accent)}
.premium-card--1{grid-column:1/-1;grid-template-columns:minmax(300px,.65fr) minmax(0,1.35fr);min-height:390px}.premium-card--1 .premium-card__copy{padding:30px 16px 28px 30px}.premium-card--1 h3{font-size:clamp(28px,3.1vw,44px)}.premium-card--1 .premium-card__visual :global(.product-visual){min-height:358px}.premium-card--4,.premium-card--6{background:linear-gradient(135deg,#fff,color-mix(in srgb,var(--card-accent) 9%,#fff))}.premium-card--3 .premium-card__visual,.premium-card--5 .premium-card__visual{transform:rotate(.35deg)}.premium-card--7{grid-column:2;background:linear-gradient(135deg,#fff,color-mix(in srgb,var(--card-accent) 9%,#fff))}.premium-card--7 .premium-card__visual{transform:rotate(-.25deg)}
@media(max-width:1050px){.premium-showcase__grid{grid-template-columns:1fr}.premium-card--1,.premium-card--7{grid-column:auto}.premium-card{grid-template-columns:minmax(240px,.75fr) minmax(0,1.25fr)}}
@media(max-width:720px){.premium-showcase{padding-block:48px}.premium-showcase__head{grid-template-columns:1fr;gap:14px}.premium-showcase__head h2{font-size:38px}.premium-card,.premium-card--1{grid-template-columns:1fr;min-height:0}.premium-card__copy,.premium-card--1 .premium-card__copy{padding:20px}.premium-card__visual{margin:0 14px 14px}.premium-card__visual :global(.product-visual),.premium-card--1 .premium-card__visual :global(.product-visual){min-height:220px}.premium-card__chips{display:none}}
</style>