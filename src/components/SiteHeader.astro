---
interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;

const pathname = Astro.url.pathname;

const menu = [
  { label: 'Şablonlar', href: '/sablonlar' },
  { label: 'Paketler', href: '/paketler' },
  { label: 'Nasıl Çalışır', href: '/nasil-calisir' },
  { label: 'Rehber', href: '/rehber' },
  { label: 'İletişim', href: '/iletisim' },
];

const isActive = (href: string) =>
  href === '/sablonlar' ? pathname.startsWith('/sablon') : pathname === href;
---

<header class="site-header">
  <div class="site-container site-header__inner">
    <a href="/" class="site-header__brand">
      <img
        src="/images/excel-logo.png"
        alt="Excel Arşiv"
        width="34"
        height="32"
        loading="eager"
        class="site-header__logo"
      />
      <span class="site-header__brand-text">
        <span class="site-header__wordmark">Excel Arşiv</span>
        <span class="site-header__tagline">Hazır Excel işletme çözümleri</span>
      </span>
    </a>
    <nav class="site-header__nav" aria-label="Ana menü">
      {
        menu.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class={`site-header__link${active ? ' is-active' : ''}`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <a class="site-header__cta" href="/sablonlar">
      Şablonları İncele
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--xl-grid);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 68px;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .site-header__logo {
    border-radius: 6px;
  }
  .site-header__brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .site-header__wordmark {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--xl-ink-900);
  }
  .site-header__tagline {
    font-size: 9px;
    letter-spacing: 0.02em;
    color: var(--xl-ink-3);
  }
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-inline: auto;
  }
  .site-header__link {
    padding: 9px 11px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 500;
    color: var(--xl-ink-3);
    text-decoration: none;
    transition: color 150ms ease-out, background 150ms ease-out;
  }
  .site-header__link:hover {
    color: var(--xl-green-dark);
    background: var(--xl-accent-soft);
  }
  .site-header__link.is-active {
    color: var(--xl-green-dark);
    background: var(--xl-accent-soft);
  }
  .site-header__cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    height: 42px;
    padding-inline: 16px;
    border-radius: 11px;
    background: var(--xl-green);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: background 150ms ease-out;
  }
  .site-header__cta:hover {
    background: var(--xl-accent-dark);
  }
  @media (max-width: 900px) {
    .site-header__nav {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .site-header__inner {
      min-height: 56px;
    }
    .site-header__cta {
      min-height: 36px;
      padding: 0 14px;
      font-size: 12px;
    }
  }
</style>
