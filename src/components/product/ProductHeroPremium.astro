---
import CheckoutPanel from '../CheckoutPanel.astro';

interface Screenshot { src: string; alt: string; }
interface Props {
  productSlug: string;
  name: string;
  summary: string;
  categoryLabel: string;
  priceTL: number;
  screenshots: Screenshot[];
  outputs: string[];
  sheetCount: number;
  minExcelVersion: string;
  macCompatible: boolean;
}

const { productSlug, name, summary, categoryLabel, priceTL, screenshots, outputs, sheetCount, minExcelVersion, macCompatible } = Astro.props;
const price = priceTL.toLocaleString('tr-TR');
const primary = screenshots[2] ?? screenshots[0];
const secondary = screenshots[0] ?? primary;
---

<section class="product-decision" aria-labelledby="product-decision-title">
  <div class="product-decision__copy">
    <div class="product-decision__eyebrow"><span>{categoryLabel}</span><i aria-hidden="true"></i><b>HAZIR EXCEL SİSTEMİ</b></div>
    <h1 id="product-decision-title">{name}</h1>
    <p class="product-decision__lead">{summary}</p>

    <div class="product-decision__outcomes" aria-label="Temel çıktılar">
      {outputs.slice(0, 3).map((output) => <span><i aria-hidden="true">✓</i>{output}</span>)}
    </div>

    <div class="product-decision__price">
      <strong>{price} <small>TL</small></strong>
      <span>KDV dahil · tek ödeme · abonelik yok</span>
    </div>

    <div class="product-decision__checkout">
      <CheckoutPanel productSlug={productSlug} name={name} priceTL={priceTL} />
    </div>

    <div class="product-decision__trust" aria-label="Ürün bilgileri">
      <span><b>{sheetCount}</b><small>Excel sayfası</small></span>
      <span><b>Demo</b><small>Satın almadan önce</small></span>
      <span><b>{minExcelVersion.replace('Excel ', '')}</b><small>Excel uyumu</small></span>
      <span><b>{macCompatible ? 'Mac + Win' : 'Windows'}</b><small>Platform</small></span>
    </div>
  </div>

  <div class="product-decision__proof" aria-label="Gerçek ürün ekranı">
    <div class="product-proof__halo" aria-hidden="true"></div>
    <div class="product-proof__window">
      <div class="product-proof__bar">
        <span class="product-proof__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>{name}.xlsx</span>
        <b>GERÇEK ÜRÜN</b>
      </div>
      {primary && <img src={primary.src} alt={primary.alt} loading="eager" decoding="async" />}
    </div>
    {secondary && primary && secondary.src !== primary.src && (
      <div class="product-proof__mini" aria-hidden="true">
        <img src={secondary.src} alt="" loading="lazy" decoding="async" />
      </div>
    )}
    <a class="product-proof__link" href="#onizleme">Tüm ekranları ve Proof Demo'yu görün <span aria-hidden="true">↓</span></a>
  </div>
</section>

<style>
  .product-decision{position:relative;display:grid;grid-template-columns:minmax(0,.9fr) minmax(460px,1.1fr);gap:54px;align-items:center;margin-top:28px;padding:clamp(34px,4.8vw,64px);overflow:hidden;border:1px solid #d7e2db;border-radius:30px;background:linear-gradient(135deg,#fbfdfb 0%,#f3f8f5 55%,#e9f2ed 100%);box-shadow:0 28px 74px rgba(28,70,43,.10)}.product-decision:after{content:'';position:absolute;width:430px;height:430px;right:-180px;top:-210px;border-radius:50%;background:radial-gradient(circle,rgba(16,124,65,.13),transparent 68%);pointer-events:none}.product-decision__copy{position:relative;z-index:2;min-width:0}.product-decision__eyebrow{display:flex;align-items:center;gap:9px;font-family:var(--font-mono);font-size:9px;font-weight:700;letter-spacing:.06em;color:#66756c}.product-decision__eyebrow span{color:var(--xl-green)}.product-decision__eyebrow i{width:3px;height:3px;border-radius:50%;background:#a6b4ab}.product-decision__eyebrow b{font-weight:700}.product-decision h1{max-width:680px;margin:14px 0 0;font-family:var(--font-display);font-size:clamp(38px,4.3vw,62px);line-height:.98;letter-spacing:-.045em;color:var(--xl-ink-900)}.product-decision__lead{max-width:650px;margin:18px 0 0;font-size:15px;line-height:1.72;color:var(--xl-ink-3)}.product-decision__outcomes{display:grid;gap:7px;margin-top:22px}.product-decision__outcomes span{display:flex;align-items:flex-start;gap:9px;font-size:11.5px;line-height:1.45;color:#35443b}.product-decision__outcomes i{display:grid;place-items:center;flex:0 0 auto;width:18px;height:18px;margin-top:-1px;border-radius:50%;background:#dff2e6;color:#0d7540;font-style:normal;font-size:9px;font-weight:800}.product-decision__price{display:flex;align-items:end;gap:14px;margin-top:26px;padding-top:22px;border-top:1px solid #dbe5de}.product-decision__price strong{font-family:var(--font-mono);font-size:28px;line-height:1;color:#10271b;letter-spacing:-.04em}.product-decision__price strong small{font-size:13px;letter-spacing:0}.product-decision__price>span{padding-bottom:2px;font-size:10.5px;color:#708078}.product-decision__checkout{margin-top:16px;max-width:620px}.product-decision__trust{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:16px}.product-decision__trust span{display:flex;flex-direction:column;gap:3px;padding:10px;border:1px solid #dce6df;border-radius:11px;background:rgba(255,255,255,.64)}.product-decision__trust b{font-family:var(--font-mono);font-size:9.5px;color:#1a5435}.product-decision__trust small{font-size:8.5px;line-height:1.25;color:#77827b}.product-decision__proof{position:relative;z-index:1;min-width:0;padding:34px 0 42px}.product-proof__halo{position:absolute;inset:0 3% 4% 8%;border-radius:50%;background:radial-gradient(circle,rgba(16,124,65,.16),rgba(16,124,65,.03) 56%,transparent 70%);filter:blur(8px)}.product-proof__window{position:relative;z-index:2;overflow:hidden;border:1px solid #c9d5cd;border-radius:18px;background:#fff;box-shadow:0 30px 70px rgba(20,58,38,.22);transform:rotate(-1deg)}.product-proof__bar{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:38px;padding:0 11px;border-bottom:1px solid #dce4df;background:#eef2ef;font-family:var(--font-mono);font-size:7.5px;color:#6e7a72}.product-proof__bar>span:nth-child(2){justify-self:center;max-width:230px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.product-proof__bar>b{justify-self:end;padding:4px 6px;border-radius:5px;background:#dff1e6;color:#0e713c;font-size:7px}.product-proof__dots{display:flex;gap:5px}.product-proof__dots i{display:block;width:7px;height:7px;border-radius:50%;background:#b7c0ba}.product-proof__dots i:first-child{background:#e66e68}.product-proof__dots i:nth-child(2){background:#e9b84e}.product-proof__dots i:last-child{background:#4db56b}.product-proof__window img{display:block;width:100%;max-height:460px;object-fit:contain;background:#fff}.product-proof__mini{position:absolute;z-index:3;right:-5px;bottom:0;width:44%;overflow:hidden;border:1px solid #cbd7cf;border-radius:13px;background:#fff;box-shadow:0 20px 45px rgba(20,58,38,.22);transform:rotate(3deg)}.product-proof__mini img{display:block;width:100%;height:auto}.product-proof__link{position:absolute;z-index:4;left:18px;bottom:1px;display:inline-flex;align-items:center;gap:8px;padding:9px 11px;border:1px solid rgba(255,255,255,.7);border-radius:10px;background:rgba(8,45,31,.9);backdrop-filter:blur(10px);color:#fff;font-family:var(--font-mono);font-size:8.5px;font-weight:700;text-decoration:none;box-shadow:0 10px 26px rgba(8,45,31,.2)}
  @media(max-width:1020px){.product-decision{grid-template-columns:1fr;gap:22px}.product-decision__proof{max-width:780px;margin-inline:auto}.product-decision__trust{max-width:700px}}
  @media(max-width:680px){.product-decision{margin-top:16px;padding:22px 16px 24px;border-radius:22px}.product-decision h1{font-size:36px}.product-decision__lead{font-size:13px;line-height:1.58}.product-decision__outcomes span{font-size:10.5px}.product-decision__price{display:block}.product-decision__price>span{display:block;margin-top:6px}.product-decision__trust{grid-template-columns:1fr 1fr}.product-decision__proof{padding:8px 0 34px}.product-proof__window{border-radius:12px;transform:none}.product-proof__bar{min-height:32px;font-size:6.5px}.product-proof__window img{max-height:330px}.product-proof__mini{display:none}.product-proof__link{left:8px;bottom:0;font-size:7.5px}}
  @media(prefers-reduced-motion:reduce){.product-proof__window{transform:none}}
</style>
