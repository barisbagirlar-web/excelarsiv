---
import CheckoutPanel from '../CheckoutPanel.astro';
import DemoDownloadBox from '../DemoDownloadBox.astro';

interface Screenshot { src: string; alt: string; }
interface Props {
  productSlug: string;
  name: string;
  summary: string;
  categoryLabel: string;
  priceTL: number;
  screenshots: Screenshot[];
  outputs: string[];
  sheetCount: number;
  minExcelVersion: string;
  macCompatible: boolean;
}

const { productSlug, name, summary, categoryLabel, priceTL, screenshots, outputs, sheetCount, minExcelVersion, macCompatible } = Astro.props;
const price = priceTL.toLocaleString('tr-TR');
const primary = screenshots[2] ?? screenshots[0];
---

<section class="product-hero" aria-labelledby="product-title">
  <div class="product-hero__intro">
    <div class="product-hero__copy">
      <p class="product-hero__eyebrow">{categoryLabel} · Hazır Excel işletme sistemi</p>
      <h1 id="product-title">{name}</h1>
      <p class="product-hero__summary">{summary}</p>

      <ul class="product-hero__outputs" aria-label="Temel çıktılar">
        {outputs.slice(0, 3).map((output) => <li><span aria-hidden="true">✓</span>{output}</li>)}
      </ul>

      <div class="product-hero__price-row">
        <strong>{price} <small>TL</small></strong>
        <span>KDV dahil · Tek ödeme · Abonelik yok</span>
      </div>

      <div class="product-hero__facts" aria-label="Ürün bilgileri">
        <span><b>{sheetCount}</b><small>Excel sayfası</small></span>
        <span><b>{minExcelVersion.replace('Excel ', '')}</b><small>Minimum sürüm</small></span>
        <span><b>{macCompatible ? 'Mac + Windows' : 'Windows'}</b><small>Platform</small></span>
      </div>
    </div>

    <div class="product-hero__visual" aria-label="Gerçek ürün ekranı">
      <div class="product-hero__window">
        <div class="product-hero__window-bar">
          <span aria-hidden="true"><i></i><i></i><i></i></span>
          <b>GERÇEK ÜRÜN EKRANI</b>
        </div>
        {primary && <img src={primary.src} alt={primary.alt} loading="eager" decoding="async" />}
      </div>
      <a href="#onizleme">Diğer gerçek ekranları görün ↓</a>
    </div>
  </div>

  <div class="product-hero__actions" aria-label="Satın alma ve demo seçenekleri">
    <CheckoutPanel productSlug={productSlug} name={name} priceTL={priceTL} />
    <DemoDownloadBox productSlug={productSlug} name={name} />
  </div>
</section>

<style>
  .product-hero{margin-top:24px;padding:clamp(26px,4vw,46px);border:1px solid #d7e2db;border-radius:26px;background:linear-gradient(145deg,#fbfdfb 0%,#f4f8f5 62%,#edf4ef 100%);box-shadow:0 24px 64px rgba(28,70,43,.09)}
  .product-hero__intro{display:grid;grid-template-columns:minmax(0,.9fr) minmax(420px,1.1fr);gap:48px;align-items:center}
  .product-hero__copy{min-width:0}.product-hero__eyebrow{margin:0;font-family:var(--font-mono);font-size:9px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:#0b7440}.product-hero h1{max-width:720px;margin:12px 0 0;font-family:var(--font-display);font-size:clamp(38px,4.4vw,62px);line-height:.99;letter-spacing:-.045em;color:#13271b}.product-hero__summary{max-width:680px;margin:16px 0 0;font-size:14px;line-height:1.65;color:#5e6c64}.product-hero__outputs{display:grid;gap:7px;margin:20px 0 0;padding:0;list-style:none}.product-hero__outputs li{display:flex;align-items:flex-start;gap:8px;font-size:11.5px;line-height:1.45;color:#36473d}.product-hero__outputs span{display:grid;place-items:center;flex:0 0 18px;height:18px;border-radius:50%;background:#dff2e6;color:#0d7540;font-size:9px;font-weight:800}.product-hero__price-row{display:flex;align-items:end;gap:14px;margin-top:24px;padding-top:18px;border-top:1px solid #d9e3dc}.product-hero__price-row strong{font-family:var(--font-mono);font-size:29px;line-height:1;letter-spacing:-.04em;color:#10271b}.product-hero__price-row strong small{font-size:12px}.product-hero__price-row>span{padding-bottom:2px;font-size:10.5px;color:#6e7a73}.product-hero__facts{display:flex;flex-wrap:wrap;gap:8px;margin-top:15px}.product-hero__facts span{display:flex;flex-direction:column;gap:2px;min-width:100px;padding:8px 10px;border:1px solid #d8e3dc;border-radius:10px;background:rgba(255,255,255,.65)}.product-hero__facts b{font-family:var(--font-mono);font-size:9.5px;color:#1a5435}.product-hero__facts small{font-size:8.5px;color:#76827b}
  .product-hero__visual{min-width:0}.product-hero__window{overflow:hidden;border:1px solid #cad6ce;border-radius:16px;background:#fff;box-shadow:0 24px 55px rgba(20,58,38,.17)}.product-hero__window-bar{display:flex;align-items:center;justify-content:space-between;min-height:36px;padding:0 11px;border-bottom:1px solid #dce4df;background:#eff3f0}.product-hero__window-bar>span{display:flex;gap:5px}.product-hero__window-bar i{display:block;width:7px;height:7px;border-radius:50%;background:#b7c0ba}.product-hero__window-bar i:first-child{background:#e66e68}.product-hero__window-bar i:nth-child(2){background:#e9b84e}.product-hero__window-bar i:last-child{background:#4db56b}.product-hero__window-bar b{font-family:var(--font-mono);font-size:7.5px;letter-spacing:.08em;color:#47705a}.product-hero__window img{display:block;width:100%;max-height:420px;object-fit:contain;background:#fff}.product-hero__visual>a{display:inline-block;margin-top:9px;font-family:var(--font-mono);font-size:9px;font-weight:700;color:#0b7440;text-decoration:none}
  .product-hero__actions{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:26px;padding-top:24px;border-top:1px solid #d7e2db}.product-hero__actions>*{min-width:0}
  @media(max-width:980px){.product-hero__intro{grid-template-columns:1fr}.product-hero__visual{max-width:760px}.product-hero__actions{grid-template-columns:1fr 1fr}}
  @media(max-width:760px){.product-hero{margin-top:16px;padding:20px 14px;border-radius:20px}.product-hero h1{font-size:35px}.product-hero__summary{font-size:12.5px}.product-hero__price-row{display:block}.product-hero__price-row>span{display:block;margin-top:6px}.product-hero__facts{display:grid;grid-template-columns:repeat(3,1fr)}.product-hero__facts span{min-width:0}.product-hero__actions{grid-template-columns:1fr;gap:12px;margin-top:20px;padding-top:18px}.product-hero__window img{max-height:320px}}
</style>
