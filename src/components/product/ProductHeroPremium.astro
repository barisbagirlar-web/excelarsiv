---
import CheckoutPanel from '../CheckoutPanel.astro';
import DemoDownloadBox from '../DemoDownloadBox.astro';

interface Screenshot { src: string; alt: string; }
interface Props {
  productSlug: string;
  name: string;
  summary: string;
  categoryLabel: string;
  priceTL: number;
  screenshots: Screenshot[];
  outputs: string[];
  sheetCount: number;
  minExcelVersion: string;
  macCompatible: boolean;
}

const { productSlug, name, summary, categoryLabel, priceTL, screenshots, outputs, sheetCount, minExcelVersion, macCompatible } = Astro.props;
const price = priceTL.toLocaleString('tr-TR');
const primary = screenshots[0] ?? screenshots[2];
const categorySlug = categoryLabel
  .toLocaleLowerCase('tr-TR')
  .replace(/ğ/g, 'g')
  .replace(/ü/g, 'u')
  .replace(/ş/g, 's')
  .replace(/ı/g, 'i')
  .replace(/ö/g, 'o')
  .replace(/ç/g, 'c')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');
---

<section
  class="product-hero"
  aria-labelledby="product-title"
  data-template-view
  data-template-id={productSlug}
  data-category-slug={categorySlug}
>
  <div class="product-hero__intro">
    <div class="product-hero__copy">
      <p class="product-hero__eyebrow">{categoryLabel} · Hazır Excel işletme sistemi</p>
      <h1 id="product-title">{name}</h1>
      <p class="product-hero__summary">{summary}</p>

      <ul class="product-hero__outputs" aria-label="Temel çıktılar">
        {outputs.slice(0, 3).map((output) => <li><span aria-hidden="true">✓</span>{output}</li>)}
      </ul>

      <div class="product-hero__price-row">
        <strong>{price} <small>TL</small></strong>
        <span>KDV dahil · Tek ödeme · Abonelik yok</span>
      </div>

      <div class="product-hero__facts" aria-label="Ürün bilgileri">
        <span><b>{sheetCount}</b><small>Excel sayfası</small></span>
        <span><b>{minExcelVersion.replace('Excel ', '')}</b><small>Minimum sürüm</small></span>
        <span><b>{macCompatible ? 'Mac + Windows' : 'Windows'}</b><small>Platform</small></span>
      </div>
      <a class="product-hero__mobile-proof-link" href="#onizleme">Gerçek Excel ekranlarını aşağıda inceleyin ↓</a>
    </div>

    <div class="product-hero__visual" aria-label="Gerçek ürün ekranı">
      <div class="product-hero__window">
        <div class="product-hero__window-bar">
          <span aria-hidden="true"><i></i><i></i><i></i></span>
          <b>GERÇEK ÜRÜN EKRANI</b>
        </div>
        {primary && (
          <picture>
            <source media="(min-width: 761px)" srcset={primary.src} />
            <img
              src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
              alt={primary.alt}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="1200"
              height="750"
            />
          </picture>
        )}
      </div>
      <a href="#onizleme">Diğer gerçek ekranları görün ↓</a>
    </div>
  </div>

  <div class="product-hero__decision-head">
    <div>
      <p>TEK KARAR ALANI</p>
      <h2>Önce deneyin veya doğrudan satın alın.</h2>
    </div>
    <span>İki seçenek de burada. Aramanız gereken başka bir alan yok.</span>
  </div>

  <div class="product-hero__actions" aria-label="Satın alma ve demo seçenekleri">
    <CheckoutPanel productSlug={productSlug} name={name} priceTL={priceTL} />
    <DemoDownloadBox productSlug={productSlug} name={name} />
  </div>

  <div class="product-hero__trust" aria-label="Satın alma güvenceleri">
    <span><b>01</b><small>Shopier ile güvenli ödeme</small></span>
    <span><b>02</b><small>Ödeme doğrulanınca güvenli indirme</small></span>
    <span><b>03</b><small>Demo ile satın almadan önce inceleme</small></span>
  </div>
</section>

<script>
  import { analytics, trackAnalyticsEvent } from '../../lib/analytics';

  document.querySelectorAll<HTMLElement>('[data-template-view]').forEach((root) => {
    if (root.dataset.analyticsTemplateViewSent === '1') return;
    const templateId = root.dataset.templateId ?? '';
    const categorySlug = root.dataset.categorySlug ?? '';
    if (!templateId || !categorySlug) return;
    if (trackAnalyticsEvent(analytics.events.templateView, { templateId, categorySlug })) {
      root.dataset.analyticsTemplateViewSent = '1';
    }
  });
</script>

<style>
  .product-hero{margin-top:22px;padding:clamp(24px,3.4vw,40px);border:1px solid #d7e2db;border-radius:24px;background:linear-gradient(145deg,#fbfdfb 0%,#f4f8f5 64%,#edf4ef 100%);box-shadow:0 22px 58px rgba(28,70,43,.085)}
  .product-hero__intro{display:grid;grid-template-columns:minmax(0,.96fr) minmax(400px,1.04fr);gap:40px;align-items:center}.product-hero__copy{min-width:0}.product-hero__eyebrow{margin:0;font-family:var(--font-mono);font-size:12px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:#0b7440}.product-hero h1{max-width:700px;margin:10px 0 0;font-family:var(--font-display);font-size:clamp(36px,4vw,55px);line-height:1;letter-spacing:-.043em;color:#13271b}.product-hero__summary{max-width:660px;margin:13px 0 0;font-size:16px;line-height:1.58;color:#3a4a41}.product-hero__outputs{display:grid;gap:6px;margin:16px 0 0;padding:0;list-style:none}.product-hero__outputs li{display:flex;align-items:flex-start;gap:7px;font-size:14.5px;line-height:1.45;color:#2f3f36}.product-hero__outputs span{display:grid;place-items:center;flex:0 0 18px;height:18px;border-radius:50%;background:#dff2e6;color:#0d7540;font-size:11px;font-weight:800}.product-hero__price-row{display:flex;align-items:end;gap:12px;margin-top:18px;padding-top:15px;border-top:1px solid #d9e3dc}.product-hero__price-row strong{font-family:var(--font-mono);font-size:27px;line-height:1;letter-spacing:-.04em;color:#10271b}.product-hero__price-row strong small{font-size:13px}.product-hero__price-row>span{padding-bottom:2px;font-size:14px;color:#3a4a41}.product-hero__facts{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px}.product-hero__facts span{display:flex;flex-direction:column;gap:2px;min-width:94px;padding:8px 10px;border:1px solid #c5d4cb;border-radius:9px;background:#fff}.product-hero__facts b{font-family:var(--font-mono);font-size:13px;color:#1a5435}.product-hero__facts small{font-size:12px;color:#44554c}.product-hero__mobile-proof-link{display:none}
  .product-hero__visual{min-width:0}.product-hero__window{overflow:hidden;border:1px solid #cad6ce;border-radius:14px;background:#fff;box-shadow:0 20px 48px rgba(20,58,38,.16)}.product-hero__window-bar{display:flex;align-items:center;justify-content:space-between;min-height:32px;padding:0 10px;border-bottom:1px solid #dce4df;background:#eff3f0}.product-hero__window-bar>span{display:flex;gap:5px}.product-hero__window-bar i{display:block;width:6px;height:6px;border-radius:50%;background:#b7c0ba}.product-hero__window-bar i:first-child{background:#e66e68}.product-hero__window-bar i:nth-child(2){background:#e9b84e}.product-hero__window-bar i:last-child{background:#4db56b}.product-hero__window-bar b{font-family:var(--font-mono);font-size:7px;letter-spacing:.08em;color:#47705a}.product-hero__window picture{display:block}.product-hero__window img{display:block;width:100%;height:auto;aspect-ratio:8/5;max-height:320px;object-fit:contain;background:#fff}.product-hero__visual>a{display:inline-block;margin-top:8px;font-family:var(--font-mono);font-size:8.5px;font-weight:700;color:#0b7440;text-decoration:none}
  .product-hero__decision-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-top:22px;padding-top:20px;border-top:1px solid #d7e2db}.product-hero__decision-head p{margin:0;font-family:var(--font-mono);font-size:12px;font-weight:800;letter-spacing:.11em;color:#0b7440}.product-hero__decision-head h2{margin:5px 0 0;font-family:var(--font-display);font-size:clamp(24px,2.6vw,30px);line-height:1.05;letter-spacing:-.025em;color:#14271d}.product-hero__decision-head>span{max-width:340px;text-align:right;font-size:14px;line-height:1.5;color:#3a4a41}.product-hero__actions{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:13px}.product-hero__actions>*{min-width:0}.product-hero__trust{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:13px;overflow:hidden;border:1px solid #c5d4cb;border-radius:11px;background:#c5d4cb}.product-hero__trust span{display:flex;align-items:center;gap:8px;min-height:52px;padding:0 14px;background:#fff}.product-hero__trust b{font-family:var(--font-mono);font-size:13px;font-weight:800;color:#0b7440}.product-hero__trust small{font-size:14px;line-height:1.4;color:#3a4a41;font-weight:500}
  :global(.product-page > .product-section){content-visibility:auto;contain-intrinsic-size:auto 760px}
  @media(max-width:980px){.product-hero__intro{grid-template-columns:1fr}.product-hero__visual{max-width:760px}.product-hero__window img{max-height:350px}.product-hero__actions{grid-template-columns:1fr 1fr}}
  @media(max-width:760px){.product-hero{margin-top:14px;padding:18px 13px 16px;border-radius:18px}.product-hero h1{font-size:34px;font-weight:760}.product-hero__summary{font-size:15px}.product-hero__visual{display:none}.product-hero__mobile-proof-link{display:inline-block;margin-top:12px;font-family:var(--font-body);font-size:14px;font-weight:700;color:#0b7440;text-decoration:none}.product-hero__price-row{display:block}.product-hero__price-row>span{display:block;margin-top:5px}.product-hero__facts{display:grid;grid-template-columns:repeat(3,1fr)}.product-hero__facts span{min-width:0}.product-hero__decision-head{align-items:flex-start;flex-direction:column;gap:6px;margin-top:18px;padding-top:16px}.product-hero__decision-head h2{font-size:22px}.product-hero__decision-head>span{max-width:none;text-align:left}.product-hero__actions{grid-template-columns:1fr;gap:10px;margin-top:10px}.product-hero__trust{grid-template-columns:1fr}.product-hero__trust span{min-height:48px}}
</style>
