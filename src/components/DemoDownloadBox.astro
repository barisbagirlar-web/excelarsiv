---
interface Props {
  productSlug: string;
  name: string;
}

const { productSlug, name } = Astro.props;
---

<section id="demo-indir" class="demo-card" data-proof-demo data-product-slug={productSlug}>
  <div class="demo-card__head">
    <div>
      <p class="demo-card__kicker">ÜCRETSİZ DEMO</p>
      <h2>Önce Deneyin</h2>
    </div>
    <span class="demo-card__badge">.XLSX</span>
  </div>

  <p class="demo-card__lead">{name} için 20 kayıtlık değerlendirme sürümünü hemen bilgisayarınıza indirin.</p>

  <form class="demo-card__form" data-demo-form>
    <label class="demo-card__email">
      <span>E-posta</span>
      <input
        type="email"
        name="email"
        autocomplete="email"
        inputmode="email"
        maxlength="254"
        placeholder="ornek@firma.com"
        required
      />
    </label>

    <button type="submit" data-demo-submit>
      Ücretsiz Demo İndir <span aria-hidden="true">↓</span>
    </button>

    <label class="demo-card__terms">
      <input type="checkbox" name="terms" required />
      <span><a href="/demo-kullanim-kosullari" target="_blank" rel="noopener noreferrer">Demo Kullanım Koşulları</a>'nı kabul ediyorum.</span>
    </label>

    <div class="demo-card__microcopy" aria-label="Demo bilgileri">
      <span>10 dk bağlantı</span><i aria-hidden="true"></i><span>Tek kullanımlık</span><i aria-hidden="true"></i><span>Ham e-posta yazılmaz</span>
    </div>
    <p class="hidden demo-card__status" role="status" aria-live="polite" data-demo-status></p>
  </form>
</section>

<script>
  import { analytics, fileTypeFromDownloadUrl, resolveDownloadSource, trackAnalyticsEvent } from '../lib/analytics';

  const ERROR_TEXT: Record<string, string> = {
    INVALID_EMAIL: 'Geçerli bir e-posta adresi girin.',
    DEMO_TERMS_REQUIRED: 'Demo kullanım koşullarını kabul etmeniz gerekiyor.',
    UNKNOWN_PRODUCT: 'Bu ürün için demo şu anda kullanılamıyor.',
    DEMO_RATE_LIMITED: 'Kısa sürede çok fazla demo istendi. Daha sonra yeniden deneyin.',
    INTERNAL_ERROR: 'Demo hazırlanamadı. Lütfen yeniden deneyin.',
  };

  document.querySelectorAll<HTMLElement>('[data-proof-demo]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-demo-form]');
    const submit = root.querySelector<HTMLButtonElement>('[data-demo-submit]');
    const status = root.querySelector<HTMLElement>('[data-demo-status]');
    const productSlug = root.dataset.productSlug ?? '';
    if (!form || !submit || !status || !productSlug) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const acceptedTerms = data.get('terms') === 'on';
      const source = resolveDownloadSource();

      trackAnalyticsEvent(analytics.events.downloadStart, { templateId: productSlug, source });
      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      status.classList.remove('hidden');
      status.className = 'demo-card__status';
      status.textContent = 'Demo hazırlanıyor…';

      try {
        const response = await fetch('/api/demo-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productSlug, email, acceptedTerms }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload?.downloadUrl) {
          const code = String(payload?.error ?? 'INTERNAL_ERROR');
          throw new Error(code);
        }

        const downloadUrl = String(payload.downloadUrl);
        trackAnalyticsEvent(analytics.events.signup, { method: 'demo_email' });
        trackAnalyticsEvent(analytics.events.downloadComplete, {
          templateId: productSlug,
          fileType: fileTypeFromDownloadUrl(downloadUrl),
        });
        status.className = 'demo-card__status demo-card__status--ok';
        status.textContent = 'Demo hazır. İndirme başlatılıyor…';
        window.location.assign(downloadUrl);
      } catch (error) {
        const code = error instanceof Error ? error.message : 'INTERNAL_ERROR';
        status.className = 'demo-card__status demo-card__status--error';
        status.textContent = ERROR_TEXT[code] ?? ERROR_TEXT.INTERNAL_ERROR;
      } finally {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
      }
    });
  });
</script>

<style>
  .demo-card{height:100%;padding:20px;border:1px solid #cbdad1;border-radius:18px;background:#f7faf8;box-shadow:0 12px 30px rgba(21,70,44,.045)}.demo-card__head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}.demo-card__kicker{margin:0;font-family:var(--font-mono);font-size:8.5px;font-weight:800;letter-spacing:.12em;color:#476b57}.demo-card h2{margin:5px 0 0;font-family:var(--font-display);font-size:21px;line-height:1.05;letter-spacing:-.025em;color:#14271d}.demo-card__badge{flex:0 0 auto;padding:5px 7px;border:1px solid #c9d9cf;border-radius:7px;background:#fff;font-family:var(--font-mono);font-size:8.5px;font-weight:800;color:#2f6948}.demo-card__lead{margin:10px 0 0;font-size:11px;line-height:1.48;color:#68766e}.demo-card__form{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px;margin-top:16px}.demo-card__email{display:grid;gap:6px}.demo-card__email>span{font-size:10px;font-weight:700;color:#4d5d53}.demo-card input[type="email"]{width:100%;min-height:44px;padding:0 11px;border:1px solid #cbd8d0;border-radius:9px;background:#fff;color:#16261d;font-size:12.5px;outline:none}.demo-card input[type="email"]:focus{border-color:#0b7a42;box-shadow:0 0 0 3px rgba(11,122,66,.08)}.demo-card__form>button{align-self:end;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:44px;border:1px solid #0b743f;border-radius:9px;background:#fff;padding:0 16px;color:#0b743f;font-family:var(--font-mono);font-size:10.5px;font-weight:800;cursor:pointer;white-space:nowrap}.demo-card__form>button:hover{background:#edf7f1}.demo-card__form>button:disabled{cursor:wait;opacity:.6}.demo-card__terms{grid-column:1/-1;display:flex;align-items:flex-start;gap:7px;font-size:9.5px;line-height:1.4;color:#66736c}.demo-card__terms input{margin-top:2px}.demo-card__terms a{color:#315c43;text-underline-offset:2px}.demo-card__microcopy{grid-column:1/-1;display:flex;align-items:center;gap:7px;font-family:var(--font-mono);font-size:8.5px;font-weight:700;color:#5c6f63}.demo-card__microcopy i{width:3px;height:3px;border-radius:50%;background:#a9b8af}.demo-card__status{grid-column:1/-1;margin:0;padding-top:2px;font-size:9.5px;line-height:1.4;color:#5e6b64}.demo-card__status--ok{color:#167044}.demo-card__status--error{color:#a53e35}.hidden{display:none!important}
  @media(max-width:700px){.demo-card{padding:17px}.demo-card__form{grid-template-columns:1fr}.demo-card__form>button{width:100%}.demo-card__terms,.demo-card__microcopy,.demo-card__status{grid-column:1}.demo-card h2{font-size:20px}}
</style>
