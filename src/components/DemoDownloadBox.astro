---
interface Props {
  productSlug: string;
  name: string;
}

const { productSlug, name } = Astro.props;
---

<section class="demo-card" data-proof-demo data-product-slug={productSlug}>
  <div class="demo-card__head">
    <div>
      <p class="demo-card__kicker">ÜCRETSİZ DEMO</p>
      <h2>Önce deneyin, sonra karar verin</h2>
    </div>
    <span class="demo-card__badge">.XLSX</span>
  </div>

  <p class="demo-card__lead">{name} için 20 kayıtlık canlı değerlendirme sürümünü bilgisayarınıza indirin.</p>

  <ul class="demo-card__benefits" aria-label="Demo kapsamı">
    <li><span>✓</span>Sarı giriş hücrelerini değiştirin</li>
    <li><span>✓</span>Risk ve karar çıktısını görün</li>
    <li><span>✓</span>Premium motor açığa çıkmaz</li>
  </ul>

  <form class="demo-card__form" data-demo-form>
    <label>
      <span>E-posta adresiniz</span>
      <input
        type="email"
        name="email"
        autocomplete="email"
        inputmode="email"
        maxlength="254"
        placeholder="ornek@firma.com"
        required
      />
    </label>

    <label class="demo-card__terms">
      <input type="checkbox" name="terms" required />
      <span>
        <a href="/demo-kullanim-kosullari" target="_blank" rel="noopener noreferrer">Demo Kullanım Koşulları</a>'nı kabul ediyorum.
      </span>
    </label>

    <button type="submit" data-demo-submit>
      Ücretsiz Demo İndir <span aria-hidden="true">↓</span>
    </button>
    <p class="demo-card__privacy">Tek kullanımlık bağlantı · 10 dakika · Ham e-posta dosyaya yazılmaz</p>
    <p class="hidden demo-card__status" role="status" aria-live="polite" data-demo-status></p>
  </form>
</section>

<script>
  const ERROR_TEXT: Record<string, string> = {
    INVALID_EMAIL: 'Geçerli bir e-posta adresi girin.',
    DEMO_TERMS_REQUIRED: 'Demo kullanım koşullarını kabul etmeniz gerekiyor.',
    UNKNOWN_PRODUCT: 'Bu ürün için demo şu anda kullanılamıyor.',
    DEMO_RATE_LIMITED: 'Kısa sürede çok fazla demo istendi. Daha sonra yeniden deneyin.',
    INTERNAL_ERROR: 'Demo hazırlanamadı. Lütfen yeniden deneyin.',
  };

  document.querySelectorAll<HTMLElement>('[data-proof-demo]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-demo-form]');
    const submit = root.querySelector<HTMLButtonElement>('[data-demo-submit]');
    const status = root.querySelector<HTMLElement>('[data-demo-status]');
    const productSlug = root.dataset.productSlug ?? '';
    if (!form || !submit || !status || !productSlug) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const acceptedTerms = data.get('terms') === 'on';

      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      status.classList.remove('hidden');
      status.className = 'demo-card__status';
      status.textContent = 'Demo hazırlanıyor…';

      try {
        const response = await fetch('/api/demo-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productSlug, email, acceptedTerms }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload?.downloadUrl) {
          const code = String(payload?.error ?? 'INTERNAL_ERROR');
          throw new Error(code);
        }

        status.className = 'demo-card__status demo-card__status--ok';
        status.textContent = 'Demo hazır. İndirme başlatılıyor…';
        window.location.assign(String(payload.downloadUrl));
      } catch (error) {
        const code = error instanceof Error ? error.message : 'INTERNAL_ERROR';
        status.className = 'demo-card__status demo-card__status--error';
        status.textContent = ERROR_TEXT[code] ?? ERROR_TEXT.INTERNAL_ERROR;
      } finally {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
      }
    });
  });
</script>

<style>
  .demo-card{height:100%;padding:22px;border:1px solid #cfddd4;border-radius:18px;background:#f7faf8;box-shadow:0 12px 32px rgba(21,70,44,.05)}.demo-card__head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}.demo-card__kicker{margin:0;font-family:var(--font-mono);font-size:9px;font-weight:800;letter-spacing:.12em;color:#476b57}.demo-card h2{margin:6px 0 0;font-family:var(--font-display);font-size:22px;line-height:1.08;letter-spacing:-.025em;color:#14271d}.demo-card__badge{flex:0 0 auto;padding:6px 8px;border:1px solid #c9d9cf;border-radius:8px;background:#fff;font-family:var(--font-mono);font-size:9px;font-weight:800;color:#2f6948}.demo-card__lead{margin:12px 0 0;font-size:11.5px;line-height:1.55;color:#68776e}.demo-card__benefits{display:grid;gap:7px;margin:16px 0 0;padding:0;list-style:none}.demo-card__benefits li{display:flex;align-items:flex-start;gap:8px;font-size:11px;color:#3f5046}.demo-card__benefits span{color:#0b7440;font-weight:800}.demo-card__form{display:grid;gap:11px;margin-top:18px}.demo-card__form>label:first-child{display:grid;gap:7px}.demo-card__form>label:first-child>span{font-size:11px;font-weight:700;color:#4d5d53}.demo-card input[type="email"]{width:100%;min-height:46px;padding:0 12px;border:1px solid #cbd8d0;border-radius:10px;background:#fff;color:#16261d;font-size:13px;outline:none}.demo-card input[type="email"]:focus{border-color:#0b7a42;box-shadow:0 0 0 3px rgba(11,122,66,.08)}.demo-card__terms{display:flex;align-items:flex-start;gap:8px;font-size:10px;line-height:1.4;color:#66736c}.demo-card__terms input{margin-top:2px}.demo-card__terms a{color:#315c43;text-underline-offset:2px}.demo-card__form>button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;border:1px solid #0b743f;border-radius:10px;background:#fff;padding:0 18px;color:#0b743f;font-family:var(--font-mono);font-size:12px;font-weight:800;cursor:pointer}.demo-card__form>button:hover{background:#edf7f1}.demo-card__form>button:disabled{cursor:wait;opacity:.6}.demo-card__privacy{margin:0;font-size:9.5px;line-height:1.4;color:#7c8881}.demo-card__status{margin:0;padding-top:4px;font-size:10.5px;line-height:1.4;color:#5e6b64}.demo-card__status--ok{color:#167044}.demo-card__status--error{color:#a53e35}.hidden{display:none!important}
  @media(max-width:620px){.demo-card{padding:18px}.demo-card h2{font-size:20px}}
</style>
