---
interface Props {
  demoFile: string;
  name: string;
}

import { statSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const { demoFile, name } = Astro.props;

// Build-time boyut: public/ altındaki gerçek dosyadan KB hesabı (0 client JS)
const publicDir = fileURLToPath(new URL('../../public/', import.meta.url));
const fileName = demoFile.split('/').filter(Boolean).pop() ?? demoFile;

// Defansif: geçersiz demoFile yolu link render etmez (şemaya dokunulmaz)
const demoFileValid = demoFile.startsWith('/demo/') && demoFile.endsWith('.xlsx');

let sizeKB = 0;
if (demoFileValid) {
  try {
    sizeKB = Math.max(1, Math.round(statSync(publicDir + demoFile.slice(1)).size / 1024));
  } catch {
    console.warn('[DEMO MISSING] ' + demoFile);
  }
}
---

{
  !demoFileValid ? (
    <div class="cf warn">demo path geçersiz</div>
  ) : (
    <div
      class="flex flex-col items-start gap-3 border border-xl-border bg-xl-canvas p-5"
      style="border-radius:6px"
    >
      <p class="kicker">ÜCRETSİZ DEMO</p>
      <p class="text-sm text-xl-ink-2">{name} — sınırlı veri, filigranlı çıktı</p>
      <a class="btn" href={demoFile} download>
        Ücretsiz Demo <span class="dn">↓</span>
      </a>
      <p class="mono text-[11px] text-xl-ink-3">
        {fileName} · ~{sizeKB} KB · makrosuz · şifresiz
      </p>
    </div>
  )
}
