---
import { getTierForPrice, getCommerceProduct } from '../lib/shopier';

interface Props {
  productSlug: string;
  name: string;
  priceTL: number;
}

const { productSlug, name, priceTL } = Astro.props;
const tierInfo = getTierForPrice(priceTL);
const product = getCommerceProduct(productSlug);
const price = priceTL.toLocaleString('tr-TR');
const satista = product?.satista !== false;
---

<section
  id="satin-al"
  class="checkout-card"
  data-checkout-root
  data-product-slug={productSlug}
  data-product-name={name}
>
  <div class="checkout-card__head">
    <div>
      <p class="checkout-card__kicker">TAM SÜRÜM</p>
      <h2>Satın Al</h2>
    </div>
    <p class="checkout-card__price">{price} <small>TL</small></p>
  </div>

  <p class="checkout-card__lead">Ödemeyi Shopier’de güvenle tamamlayın; ardından ExcelArşiv teslimat ekranına dönüp dosyanızı bilgisayarınıza indirin.</p>

  {
    tierInfo && satista ? (
      <>
        <form class="checkout-card__form" data-checkout-form novalidate>
          <label for={`checkout-email-${productSlug}`}>
            <span>E-posta (Shopier’de kullanacağınız adres)</span>
            <input
              id={`checkout-email-${productSlug}`}
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="254"
              placeholder="ornek@firma.com"
              data-checkout-email
            />
          </label>
          <button type="submit" data-checkout-submit>
            Shopier'de Ödemeye Geç <span aria-hidden="true">→</span>
          </button>
        </form>

        <noscript>
          <p class="checkout-card__hint" style="margin-top:12px">
            JavaScript kapalı veya engellenmiş. Doğrudan Shopier ödeme sayfasına gidin:
            <a href={tierInfo.tier.shopierUrl} rel="noopener noreferrer sponsored">{tierInfo.tier.shopierUrl}</a>.
            Ödeme sonrası <a href="/teslimat">/teslimat</a> sayfasında sipariş numarası + Shopier e-postası ile
            indirmeyi açın. Sorun olursa <a href="/iletisim">iletişim</a>.
          </p>
        </noscript>

        <div class="checkout-card__microcopy" aria-label="Satın alma bilgileri">
          <span>KDV dahil</span><i aria-hidden="true"></i><span>Tek ödeme</span><i aria-hidden="true"></i><span>Abonelik yok</span>
        </div>
        <p class="checkout-card__hint">
          Shopier’de <strong>aynı e-postayı</strong> kullanın. Kart başka kişiye ait olsa bile ödeme e-postası
          bu alanda yazdığınız adresle eşleşmelidir; aksi halde teslimat kilitlenir — o durumda
          <a href="/teslimat">sipariş numarasıyla kurtarma</a> kullanın. Ödeme sonrası “ExcelArşiv’e Dön”
          bağlantısını kapatmayın; kaybolursa /teslimat sayfasından devam edin.
        </p>
        <p class="checkout-card__hint">Locale: Türkçe Excel / virgül formül ayıracı. İngilizce Excel’de bölgeyi Türkiye yapın; aksi halde formüller bozulabilir — iade gerekçesi olmaz.</p>

        <div class="checkout-card__progress hidden" data-checkout-progress aria-live="polite">
          <p class="checkout-card__status" data-checkout-status></p>
          <p class="checkout-card__detail" data-checkout-detail></p>
          <div class="checkout-card__progress-actions">
            <a href="#" class="hidden" data-shopier-link>Shopier ödeme ekranını aç →</a>
            <button type="button" class="hidden" data-download-button>Excel'i İndir ↓</button>
          </div>

          <details class="hidden" data-manual-verify>
            <summary>Ödeme yaptım ama doğrulanmadı</summary>
            <form data-order-form>
              <input type="text" inputmode="text" maxlength="80" placeholder="Shopier sipariş numarası" data-order-id />
              <button type="submit">Siparişi Doğrula</button>
            </form>
          </details>
        </div>
      </>
    ) : tierInfo ? (
      <div class="checkout-card__unavailable">Bu ürün geçici olarak satışa kapalıdır. Hazırlanan ürün kısa süre sonra tekrar satışa sunulacaktır.</div>
    ) : (
      <div class="checkout-card__unavailable">Bu ürünün ödeme bağlantısı geçici olarak kullanılamıyor.</div>
    )
  }
</section>

<script>
  import { analytics, fileTypeFromDownloadUrl, resolveDownloadSource, trackAnalyticsEvent } from '../lib/analytics';

  const STORAGE_KEY = 'excelarsiv:last-checkout:v1';
  const POLL_MS = 7000;

  function readStoredCheckout() {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value ? JSON.parse(value) : null;
    } catch {
      return null;
    }
  }

  function writeStoredCheckout(value: any) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(value));
    } catch {
      // Strict privacy modes can disable localStorage; the active tab still works.
    }
  }

  async function postJson(url: string, body: any) {
    const response = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) {
      const error = new Error(payload?.error || 'REQUEST_FAILED') as Error & { code?: string };
      error.code = payload?.error || 'REQUEST_FAILED';
      throw error;
    }
    return payload;
  }

  function humanError(code: string | undefined) {
    const messages: Record<string, string> = {
      INVALID_EMAIL: 'Geçerli bir e-posta adresi girin.',
      RATE_LIMITED: 'Çok fazla ödeme denemesi yapıldı. Bir süre sonra tekrar deneyin.',
      PRODUCT_NOT_READY: 'Bu ürün geçici olarak satışa hazırlanıyor. Lütfen kısa süre sonra tekrar deneyin.',
      PRODUCT_NOT_FOR_SALE: 'Bu ürün şu anda satışa kapalıdır.',
      PRODUCT_READINESS_UNAVAILABLE: 'Satış sistemi geçici olarak kontrol edilemiyor. Lütfen kısa süre sonra tekrar deneyin.',
      CHECKOUT_NOT_FOUND: 'Bu ödeme oturumu bulunamadı. Satın alma işlemini yeniden başlatın.',
      ORDER_DOES_NOT_MATCH: 'Sipariş bu ürün, fiyat seviyesi veya e-posta ile eşleşmedi.',
      INVALID_ORDER_ID: 'Shopier sipariş numarasını kontrol edin.',
      VERIFICATION_TEMPORARILY_UNAVAILABLE: 'Shopier doğrulaması geçici olarak gecikiyor. Birkaç saniye sonra yeniden deneyin.',
      FILE_NOT_READY: 'Ödemeniz doğrulandı; ürün dosyasının teslim sürümü henüz hazır değil.',
      PAYMENT_NOT_CONFIRMED: 'Ödeme henüz doğrulanmadı.',
    };
    return (code && messages[code]) || 'İşlem tamamlanamadı. Lütfen yeniden deneyin.';
  }

  document.querySelectorAll('[data-checkout-root]').forEach((root) => {
    const productSlug = root.getAttribute('data-product-slug');
    const form = root.querySelector('[data-checkout-form]');
    if (!productSlug || !form) return;

    const emailInput = root.querySelector<HTMLInputElement>('[data-checkout-email]');
    const submitButton = root.querySelector('[data-checkout-submit]');
    const progress = root.querySelector('[data-checkout-progress]');
    const status = root.querySelector('[data-checkout-status]');
    const detail = root.querySelector('[data-checkout-detail]');
    const shopierLink = root.querySelector<HTMLAnchorElement>('[data-shopier-link]');
    const downloadButton = root.querySelector('[data-download-button]');
    const manualVerify = root.querySelector('[data-manual-verify]');
    const orderForm = root.querySelector('[data-order-form]');
    const orderIdInput = root.querySelector<HTMLInputElement>('[data-order-id]');
    let activeCheckout: any = null;
    let pollTimer: any = null;
    let pendingSince = 0;

    const setProgress = (headline: string, description = '') => {
      progress?.classList.remove('hidden');
      if (status) status.textContent = headline;
      if (detail) detail.textContent = description;
    };

    const showPending = (checkout: any) => {
      activeCheckout = checkout;
      pendingSince = pendingSince || Date.now();
      setProgress('Ödeme bekleniyor', 'Shopier ödeme ekranını tamamlayın. Sonrasında ExcelArşiv teslimat sayfasına dönerek dosyanızı indirin.');
      if (shopierLink && checkout.shopierUrl) {
        shopierLink.href = checkout.shopierUrl;
        shopierLink.classList.remove('hidden');
      }
      downloadButton?.classList.add('hidden');
      schedulePoll();
    };

    const showPaid = () => {
      if (pollTimer) window.clearTimeout(pollTimer);
      pollTimer = null;
      setProgress('Ödeme onaylandı', 'Excel dosyanız indirilmeye hazır.');
      shopierLink?.classList.add('hidden');
      downloadButton?.classList.remove('hidden');
      manualVerify?.classList.add('hidden');
    };

    const schedulePoll = () => {
      if (pollTimer) window.clearTimeout(pollTimer);
      pollTimer = window.setTimeout(checkStatus, POLL_MS);
    };

    const checkStatus = async () => {
      if (!activeCheckout) return;
      try {
        const result = await postJson('/api/checkout-status', {
          checkoutId: activeCheckout.checkoutId,
          checkoutSecret: activeCheckout.checkoutSecret,
        });
        if (result.status === 'paid') {
          showPaid();
          return;
        }
        if (result.status === 'expired') {
          setProgress('Ödeme oturumunun süresi doldu', 'Yeni bir satın alma işlemi başlatın.');
          return;
        }
        if (Date.now() - pendingSince > 45000) manualVerify?.classList.remove('hidden');
        setProgress(
          'Ödeme bekleniyor',
          result.verificationDelayed
            ? 'Shopier doğrulaması birkaç saniye gecikiyor; otomatik kontrol devam ediyor.'
            : 'Shopier ödeme onayı bekleniyor. Ödeme tamamlandıysa teslimat sayfasına dönebilirsiniz.',
        );
        schedulePoll();
      } catch (error: any) {
        if (Date.now() - pendingSince > 45000) manualVerify?.classList.remove('hidden');
        setProgress('Doğrulama devam ediyor', humanError(error?.code));
        schedulePoll();
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = emailInput?.value?.trim() || '';
      if (!emailInput?.checkValidity()) {
        emailInput?.reportValidity();
        return;
      }

      trackAnalyticsEvent(analytics.events.checkoutIntent, { packId: productSlug });
      submitButton?.setAttribute('disabled', '');
      setProgress('Ödeme hazırlanıyor', 'Shopier güvenli ödeme bağlantısı oluşturuluyor.');

      try {
        const checkout = await postJson('/api/checkout', { productSlug, email });
        const stored = { ...checkout, savedAt: Date.now(), deliveryUrl: '/teslimat' };
        writeStoredCheckout(stored);
        activeCheckout = stored;
        window.location.assign(checkout.shopierUrl);
      } catch (error: any) {
        setProgress('Ödeme başlatılamadı', humanError(error?.code));
      } finally {
        submitButton?.removeAttribute('disabled');
      }
    });

    downloadButton?.addEventListener('click', async () => {
      if (!activeCheckout) return;
      trackAnalyticsEvent(analytics.events.downloadStart, {
        templateId: productSlug,
        source: resolveDownloadSource(),
      });
      downloadButton.setAttribute('disabled', '');
      setProgress('Dosya hazırlanıyor', 'Güvenli indirme bağlantısı oluşturuluyor.');
      try {
        const result = await postJson('/api/download-token', {
          checkoutId: activeCheckout.checkoutId,
          checkoutSecret: activeCheckout.checkoutSecret,
        });
        const downloadUrl = String(result.downloadUrl);
        const link = document.createElement('a');
        link.href = downloadUrl;
        link.rel = 'nofollow';
        document.body.appendChild(link);
        link.click();
        link.remove();
        trackAnalyticsEvent(analytics.events.downloadComplete, {
          templateId: productSlug,
          fileType: fileTypeFromDownloadUrl(downloadUrl),
        });
        setProgress('İndirme başladı', 'Dosya bilgisayarınıza indiriliyor.');
        downloadButton.removeAttribute('disabled');
        downloadButton.classList.remove('hidden');
      } catch (error: any) {
        setProgress('Dosya indirilemedi', humanError(error?.code));
        downloadButton.removeAttribute('disabled');
        downloadButton.classList.remove('hidden');
      }
    });

    orderForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!activeCheckout) return;
      const shopierOrderId = orderIdInput?.value?.trim() || '';
      if (!shopierOrderId) return;
      setProgress('Sipariş doğrulanıyor', 'Shopier sipariş kaydı kontrol ediliyor.');
      try {
        const result = await postJson('/api/verify-order', {
          checkoutId: activeCheckout.checkoutId,
          checkoutSecret: activeCheckout.checkoutSecret,
          shopierOrderId,
        });
        if (result.status === 'paid') showPaid();
      } catch (error: any) {
        setProgress('Sipariş eşleşmedi', humanError(error?.code));
      }
    });

    const stored = readStoredCheckout();
    if (stored?.productSlug === productSlug && stored?.checkoutId && stored?.checkoutSecret) {
      activeCheckout = stored;
      pendingSince = stored.savedAt || Date.now();
      showPending(stored);
      checkStatus();
    }
  });
</script>

<style>
  .checkout-card{height:100%;padding:20px;border:1px solid #c5d4cb;border-radius:18px;background:#fff;box-shadow:0 12px 30px rgba(21,70,44,.06)}
  .checkout-card__head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}.checkout-card__kicker{margin:0;font-family:var(--font-mono);font-size:12px;font-weight:800;letter-spacing:.09em;color:#0b7440}.checkout-card h2{margin:5px 0 0;font-family:var(--font-display);font-size:21px;line-height:1.05;letter-spacing:-.025em;color:#14271d}.checkout-card__price{margin:0;white-space:nowrap;font-family:var(--font-mono);font-size:24px;font-weight:800;letter-spacing:-.04em;color:#10271b}.checkout-card__price small{font-size:14px}.checkout-card__lead{margin:10px 0 0;font-size:15px;line-height:1.6;color:#3a4a41}.checkout-card__form{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px;margin-top:16px}.checkout-card__form label{display:grid;gap:6px}.checkout-card__form label span{font-size:13px;font-weight:700;color:#2f3f36}.checkout-card input{width:100%;min-height:48px;padding:0 12px;border:1px solid #cbd8d0;border-radius:9px;background:#fff;color:#16261d;font-size:15px;outline:none}.checkout-card input::placeholder{color:#66766d;opacity:1}.checkout-card input:focus{border-color:#0b7a42;box-shadow:0 0 0 3px rgba(11,122,66,.08)}.checkout-card__form>button,.checkout-card__progress-actions button{align-self:end;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:48px;border:1px solid #0b743f;border-radius:11px;background:#0b743f;padding:0 18px;color:#fff;font-family:var(--font-body);font-size:15px;font-weight:700;cursor:pointer;white-space:nowrap}.checkout-card__form>button:hover,.checkout-card__progress-actions button:hover{background:#075f34}.checkout-card__form>button:disabled{cursor:wait;opacity:.62}.checkout-card__microcopy{display:flex;align-items:center;gap:7px;margin-top:11px;font-family:var(--font-body);font-size:13px;font-weight:600;color:#44554c}.checkout-card__microcopy i{width:3px;height:3px;border-radius:50%;background:#8a9a90}.checkout-card__hint{margin:7px 0 0;font-size:13.5px;line-height:1.6;color:#3a4a41}.checkout-card__hint a{color:#0b743f;font-weight:700;text-underline-offset:2px}.checkout-card__progress{margin-top:13px;padding-top:12px;border-top:1px solid #e1e8e3}.checkout-card__status{margin:0;font-size:14px;font-weight:800;color:#20352a}.checkout-card__detail{margin:4px 0 0;font-size:13px;line-height:1.55;color:#3a4a41}.checkout-card__progress-actions{display:flex;flex-wrap:wrap;align-items:center;gap:9px;margin-top:10px}.checkout-card__progress-actions a{font-size:14px;font-weight:700;color:#0b743f;text-decoration:none}.checkout-card details{margin-top:11px;padding-top:10px;border-top:1px solid #e1e8e3}.checkout-card summary{cursor:pointer;font-size:13px;color:#3a4a41}.checkout-card details form{display:grid;gap:7px;margin-top:9px}.checkout-card details button{min-height:44px;border:1px solid #cbd8d0;border-radius:8px;background:#fff;color:#234331;font-size:14px;font-weight:700}.checkout-card__unavailable{margin-top:16px;padding:11px;border-radius:9px;background:#fff3e8;color:#815528;font-size:14px}.hidden{display:none!important}
  @media(max-width:700px){.checkout-card{padding:17px}.checkout-card__form{grid-template-columns:1fr}.checkout-card__form>button{width:100%}.checkout-card__head{align-items:flex-end}.checkout-card h2{font-size:20px}.checkout-card__price{font-size:22px}}
</style>
