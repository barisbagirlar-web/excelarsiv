---
interface Props {
  name: string;
  priceTL: number;
  shopierUrl: string;
}

import Icon from '../components/Icon.astro';

const { name, priceTL, shopierUrl } = Astro.props;

const price = priceTL.toLocaleString('tr-TR');
---

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-rule-hairline bg-surface-elevated/95 p-3 backdrop-blur-sm sm:hidden">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4">
    <div class="min-w-0">
      <p class="truncate font-mono text-xs text-ink-500">{name}</p>
      <p class="price-numeric font-mono text-sm text-ink-700">{price} <span class="acronym">TL</span></p>
    </div>
    <div class="flex shrink-0 flex-col items-end gap-1.5">
      <a
        href={shopierUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 shrink-0 items-center bg-accent-primary px-5 font-mono text-sm text-white transition-colors duration-150 ease-out hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
      >
        Satın Al
      </a>
      <p class="flex items-center gap-1 font-mono text-[11px] text-ink-400">
        <Icon name="excel-lock" size={12} />
        Shopier ile Güvenli Ödeme
      </p>
    </div>
  </div>
</div>
