---
import '../styles/global.css';
import '../styles/mobile-commerce.css';
import iconSprite from '../icons/sprite.svg?raw';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileCommerceBar from '../components/MobileCommerceBar.astro';

interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const {
  title,
  description,
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
} = Astro.props;
const site = Astro.site ?? new URL('https://excelarsiv.com/');
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL('/og.png', site).toString();
const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', site).toString(),
      name: 'Excel Arşiv',
      url: site.toString(),
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', site).toString(),
      name: 'Excel Arşiv',
      url: site.toString(),
      inLanguage: 'tr-TR',
      publisher: { '@id': new URL('/#organization', site).toString() },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description: description ?? '',
      inLanguage: 'tr-TR',
      isPartOf: { '@id': new URL('/#website', site).toString() },
    },
  ],
});
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description ?? ''} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Excel Arşiv" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? ''} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Excel Arşiv — işletmeler için finansal Excel çalışma sistemleri" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? ''} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={orgLd} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-N2HLKS660W"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-N2HLKS660W');
    </script>
    <slot name="head" />
  </head>
  <body class="font-body text-ink-700 antialiased">
    <Fragment set:html={iconSprite} />
    <a href="#icerik" class="sr-only focus:not-sr-only focus:absolute focus:left-0 focus:top-0 focus:z-50 focus:bg-accent-primary focus:px-4 focus:py-3 focus:text-white">İçeriğe geç</a>
    <AnnouncementBar />
    <SiteHeader pageTitle={title} />
    <main id="icerik"><slot /></main>
    <SiteFooter />
    <MobileCommerceBar />
  </body>
</html>