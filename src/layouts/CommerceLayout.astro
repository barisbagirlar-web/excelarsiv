---
import '../styles/global.css';
import '../styles/mobile-commerce.css';
import '../styles/package-readability-fix.css';
import '../styles/product-detail-readability.css';
import '../styles/commerce-readability.css';
import iconSprite from '../icons/sprite.svg?raw';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileCommerceBar from '../components/MobileCommerceBar.astro';
import AnalyticsBootstrap from '../components/AnalyticsBootstrap.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { getProductSeoByPath } from '../data/productSeo';
import { YAZAR, yazarPersonId, yazarPersonLd } from '../data/yazar';
import { SATICI } from '../data/satici';

interface Props {
  title: string;
  description?: string;
  robots?: string;
  ogType?: string;
}

const {
  title,
  description,
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  ogType = 'website',
} = Astro.props;
const site = Astro.site ?? new URL('https://excelarsiv.com/');
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL('/og.png', site).toString();
const productSeo = getProductSeoByPath(Astro.url.pathname);
const resolvedTitle = productSeo?.title ?? title;
const resolvedDescription = productSeo?.description ?? description ?? '';
const ga4MeasurementId = 'G-N2HLKS660W';
const rawGscVerification = process.env.GSC_VERIFICATION_TOKEN?.trim() ?? '';
const gscVerification = /^[A-Za-z0-9_-]{10,256}$/.test(rawGscVerification) ? rawGscVerification : '';
const orgDescription =
  'Excel Arşiv — Türkiye\'deki işletmeler için finans, muhasebe ve operasyon odaklı hazır Excel çalışma sistemleri.';
const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', site).toString(),
      name: 'Excel Arşiv',
      url: site.toString(),
      description: orgDescription,
      logo: {
        '@type': 'ImageObject',
        url: ogImage,
        width: 1200,
        height: 1200,
      },
      email: YAZAR.eposta,
      taxID: SATICI.vkn,
      sameAs: [...YAZAR.sameAs],
      founder: { '@id': yazarPersonId(site) },
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'TR',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        email: YAZAR.eposta,
        telephone: SATICI.telefonE164,
        contactType: 'customer support',
        availableLanguage: 'tr-TR',
        areaServed: 'TR',
      },
    },
    yazarPersonLd(site),
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', site).toString(),
      name: 'Excel Arşiv',
      url: site.toString(),
      inLanguage: 'tr-TR',
      publisher: { '@id': new URL('/#organization', site).toString() },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: new URL('/sablonlar?q={search_term_string}', site).toString(),
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: resolvedTitle,
      description: resolvedDescription,
      inLanguage: 'tr-TR',
      isPartOf: { '@id': new URL('/#website', site).toString() },
    },
  ],
});
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="robots" content={robots} />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="tr" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Excel Arşiv" />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Excel Arşiv — işletmeler için finansal Excel çalışma sistemleri" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={orgLd} />
    <slot name="head" />
  </head>
  <body class="font-body text-ink-700 antialiased">
    <Fragment set:html={iconSprite} />
    <a href="#icerik" class="sr-only focus:not-sr-only focus:absolute focus:left-0 focus:top-0 focus:z-50 focus:bg-accent-primary focus:px-4 focus:py-3 focus:text-white">İçeriğe geç</a>
    <AnnouncementBar />
    <SiteHeader pageTitle={resolvedTitle} />
    <main id="icerik"><slot /></main>
    {productSeo?.guideSlug && (
      <aside class="seo-guide-bridge" aria-label="İlgili rehber">
        <div>
          <p>{productSeo.primaryQuery}</p>
          <strong>Satın almadan önce yöntemi görün.</strong>
          <a href={`/rehber/${productSeo.guideSlug}`}>{productSeo.guideLinkLabel ?? 'İlgili rehberi okuyun'} →</a>
        </div>
      </aside>
    )}
    <SiteFooter />
    <MobileCommerceBar />
    <ConsentBanner />
    <AnalyticsBootstrap measurementId={ga4MeasurementId} />
  </body>
</html>

<style>
  .seo-guide-bridge{width:min(1180px,calc(100% - 48px));margin:-60px auto 72px;padding:0 0 8px}.seo-guide-bridge>div{display:grid;grid-template-columns:minmax(0,.45fr) minmax(0,.8fr) auto;gap:18px;align-items:center;padding:18px 20px;border:1px solid #d7e2db;border-radius:16px;background:#f5f9f6}.seo-guide-bridge p{margin:0;font-family:var(--font-mono);font-size:9px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#0b7440}.seo-guide-bridge strong{font-size:15px;color:#173023}.seo-guide-bridge a{font-size:11px;font-weight:800;color:#0b7440;text-decoration:none}.seo-guide-bridge a:hover{text-decoration:underline}@media(max-width:760px){.seo-guide-bridge{width:min(100% - 28px,1180px);margin:-36px auto 48px}.seo-guide-bridge>div{grid-template-columns:1fr;gap:7px}.seo-guide-bridge a{margin-top:4px}}
</style>
