---
import '../styles/global.css';
import iconSprite from '../icons/sprite.svg?raw';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const site = Astro.site ?? new URL('https://excelarsiv.com/');

const pathname = Astro.url.pathname;

const menu = [
  { label: 'Şablonlar', href: '/sablonlar' },
  { label: 'Paketler', href: '/paketler' },
  { label: 'Nasıl Çalışır', href: '/nasil-calisir' },
  { label: 'Rehber', href: '/rehber' },
  { label: 'İletişim', href: '/iletisim' },
];

const isActive = (href: string) =>
  href === '/sablonlar' ? pathname.startsWith('/sablon') : pathname === href;

const legalLinks = [
  { label: 'Lisans', href: '/lisans' },
  { label: 'Mesafeli Satış Sözleşmesi', href: '/mesafeli-satis-sozlesmesi' },
  { label: 'Teslimat ve İade', href: '/teslimat-ve-iade' },
  { label: 'KVKK Aydınlatma', href: '/kvkk-aydinlatma' },
  { label: 'Çerez Politikası', href: '/cerez-politikasi' },
];

const year = new Date().getFullYear();

const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('#website', site).toString(),
      name: 'Excel Arşiv',
      url: site.toString(),
      inLanguage: 'tr-TR',
    },
    {
      '@type': 'Organization',
      '@id': new URL('#organization', site).toString(),
      name: 'Excel Arşiv',
      url: site.toString(),
    },
  ],
});
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Cache-Control" content="no-store" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description ?? ''} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Excel Arşiv" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? ''} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/images/excel-logo.png" as="image" />
    <!-- Font preload — kritik ağırlıklar ve subsetler -->
    <link rel="preload" href="/fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-800-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jbmono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={orgLd} />
    <slot name="head" />
  </head>
  <body class="font-body text-ink-700 antialiased">
    <Fragment set:html={iconSprite} />
    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:absolute focus:left-0 focus:top-0 focus:z-50 focus:bg-accent-primary focus:px-4 focus:py-3 focus:text-white"
    >
      İçeriğe geç
    </a>
    <div class="window">
      <div class="titlebar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <img src="/images/excel-logo.png" alt="" width="18" height="17" class="titlebar-logo" />
        <span class="file">excelarsiv.com — Kurumsal_Şablonlar.xlsx</span>
        <span class="cf good"><span class="pulse"></span>Otomatik Kaydet: Açık</span>
      </div>
      <nav class="ribbon" aria-label="Ana menü">
        <a
          href="/"
          class={`tab${pathname === '/' ? ' active' : ''}`}
          aria-current={pathname === '/' ? 'page' : undefined}
        >
          Ana Sayfa
        </a>
        {
          menu.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class={`tab${active ? ' active' : ''}`}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>
      <div class="formulabar">
        <span class="namebox">A1</span><span class="fx" aria-hidden="true">fx</span>
        <div class="fstack" aria-hidden="true">
          <span>=EĞER(ziyaretçi="usta";"hoş_geldin";"zanaatı_gör")</span>
          <span>=XLOOKUP(kategori;A:A;B:B)</span>
          <span>=ETOPLA(Stok!D:D;">"&MinEşik)</span>
        </div>
      </div>
      <main id="icerik">
        <slot />
      </main>
      <div class="cfbar" aria-hidden="true">
        <i style="--w:34%"></i
        ><i style="--w:22%;background:var(--cf-warn-bg)"></i
        ><i style="--w:9%;background:var(--cf-bad-bg)"></i
        ><i style="--w:35%;background:var(--xl-header)"></i>
      </div>
      <nav class="legalbar" aria-label="Yasal bağlantılar">
        {
          legalLinks.map((item, index) => (
            <>
              <a href={item.href}>{item.label}</a>
              {index < legalLinks.length - 1 && <span class="sep" aria-hidden="true">·</span>}
            </>
          ))
        }
        <span class="sep" aria-hidden="true">·</span>
        <span>© {year} Excel Arşiv · Tüm hakları saklıdır</span>
      </nav>
      <footer class="statusbar">
        <span
          ><span class="pulse" style="background:#fff"></span>
          <span class="ststack" aria-hidden="true"
            ><span>Hazır</span><span>Hesaplanıyor: %47…</span
            ><span>Hazır · 12 şablon güncel</span></span
          >
          &nbsp;· Şablon: 12 · JS: 0 KB
        </span>
        <span class="status-right">
          <span class="sheetpages" aria-hidden="true"><b>Girdi</b> Hesap Çıktı</span>
          <span class="zoom">− <span class="bar"></span> + &nbsp;%100</span>
        </span>
      </footer>
    </div>
  </body>
</html>
