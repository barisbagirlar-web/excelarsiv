---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { shopierCatalog } from '../lib/shopier';

const recoveryProducts = Object.entries(shopierCatalog.products)
  .map(([slug, product]) => ({
    slug,
    name: product.name,
    priceTL: shopierCatalog.tiers[product.tier].priceTL,
  }))
  .sort((a, b) => a.name.localeCompare(b.name, 'tr'));
---

<CommerceLayout
  title="Ödeme Sonrası Excel İndirme — Excel Arşiv"
  description="Shopier ödemenizi doğrulayın ve satın aldığınız Excel dosyasını güvenli şekilde ExcelArşiv üzerinden bilgisayarınıza indirin."
>
  <section class="mx-auto max-w-3xl px-4 pb-24 pt-8">
    <SectionLabel number={1} label="Ödeme Sonrası Teslimat" />
    <h1 class="display mt-6">Ödemenizi tamamladınız. Excel'inizi buradan indirin.</h1>
    <p class="lead mt-5 max-w-2xl">
      Shopier ödeme sayfasından ExcelArşiv'e döndüğünüzde siparişiniz otomatik kontrol edilir. Ödeme onaylandıysa aşağıdaki <strong>Excel'i İndir</strong> butonu açılır ve dosya doğrudan bilgisayarınıza iner.
    </p>

    <ol class="mt-8 grid gap-px overflow-hidden border border-rule-strong bg-rule-strong md:grid-cols-3" aria-label="Ödeme sonrası indirme adımları">
      <li class="bg-surface-1 p-4">
        <span class="font-mono text-[10px] font-bold text-accent-primary">01</span>
        <strong class="mt-1 block text-sm text-ink-800">Shopier'de ödeme tamamlandı</strong>
        <p class="mt-2 text-xs leading-relaxed text-ink-500">Shopier sipariş onay ekranındaki ExcelArşiv'e dönüş bağlantısına tıklayın.</p>
      </li>
      <li class="bg-surface-1 p-4">
        <span class="font-mono text-[10px] font-bold text-accent-primary">02</span>
        <strong class="mt-1 block text-sm text-ink-800">Ödeme otomatik doğrulanır</strong>
        <p class="mt-2 text-xs leading-relaxed text-ink-500">Bu sayfa Shopier siparişinizi güvenli biçimde kontrol eder. Genellikle birkaç saniye sürer.</p>
      </li>
      <li class="bg-surface-1 p-4">
        <span class="font-mono text-[10px] font-bold text-accent-primary">03</span>
        <strong class="mt-1 block text-sm text-ink-800">Excel bilgisayarınıza iner</strong>
        <p class="mt-2 text-xs leading-relaxed text-ink-500">Onaydan sonra yalnızca size ait kısa süreli güvenli indirme bağlantısı oluşturulur.</p>
      </li>
    </ol>

    <div class="mt-8 border border-rule-strong bg-surface-1 p-6" data-delivery-root>
      <div data-empty-state>
        <h2 class="font-display text-xl text-ink-800">Satın alma kaydı bu tarayıcıda otomatik bulunamadı</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-500">
          Ödemeyi bu cihazda başlattıysanız kayıt normalde otomatik bulunur. Başka bir cihazdan ödeme yaptıysanız,
          tarayıcı verileri silindiyse, Shopier onay ekranını kapattıysanız veya Shopier’de farklı e-posta kullandıysanız
          aşağıdaki alanlarla (ürün + Shopier e-posta + sipariş numarası) indirmeyi geri açabilirsiniz.
        </p>

        <details class="mt-6 border-t border-rule-hairline pt-5" open>
          <summary class="cursor-pointer font-mono text-xs text-ink-600">Shopier siparişimle indirme hakkımı bul</summary>
          <form class="mt-4 grid gap-4" data-recovery-form>
            <label class="block">
              <span class="font-mono text-xs text-ink-600">Satın aldığınız Excel</span>
              <select required class="mt-2 min-h-12 w-full border border-rule-strong bg-white px-3 text-sm text-ink-800 outline-none focus:border-accent-primary" data-recovery-product>
                <option value="">Ürün seçin</option>
                {recoveryProducts.map((product) => (
                  <option value={product.slug}>{product.name} — {product.priceTL.toLocaleString('tr-TR')} TL</option>
                ))}
              </select>
            </label>
            <label class="block">
              <span class="font-mono text-xs text-ink-600">Shopier'de kullandığınız e-posta</span>
              <input required type="email" autocomplete="email" maxlength="254" class="mt-2 min-h-12 w-full border border-rule-strong bg-white px-3 font-mono text-sm text-ink-800 outline-none focus:border-accent-primary" data-recovery-email />
            </label>
            <label class="block">
              <span class="font-mono text-xs text-ink-600">Shopier sipariş numarası</span>
              <input required type="text" maxlength="80" class="mt-2 min-h-12 w-full border border-rule-strong bg-white px-3 font-mono text-sm text-ink-800 outline-none focus:border-accent-primary" data-recovery-order />
            </label>
            <button type="submit" class="min-h-12 bg-accent-primary px-5 font-mono text-sm text-white hover:bg-accent-hover disabled:opacity-60" data-recovery-submit>
              Ödememi Doğrula ve İndirmeyi Aç
            </button>
            <p class="text-xs leading-relaxed text-ink-400" data-recovery-message aria-live="polite"></p>
          </form>
        </details>

        <a href="/sablonlar" class="mt-6 inline-flex min-h-11 items-center border border-rule-strong px-5 font-mono text-sm text-ink-700 hover:border-accent-primary">
          Şablonlara Git
        </a>
      </div>

      <div class="hidden" data-active-state aria-live="polite">
        <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-400">Ödeme Sonrası Teslimat</p>
        <h2 class="mt-2 font-display text-xl text-ink-800" data-product-name></h2>
        <p class="mt-2 font-mono text-sm text-ink-600" data-amount></p>
        <div class="mt-5 border-t border-rule-hairline pt-5">
          <p class="font-mono text-sm text-ink-700" data-status></p>
          <p class="mt-2 text-xs leading-relaxed text-ink-400" data-detail></p>
          <button
            type="button"
            class="mt-5 hidden min-h-12 bg-accent-primary px-6 font-mono text-sm font-bold text-white hover:bg-accent-hover disabled:opacity-60"
            data-download
          >
            Excel'i Bilgisayarıma İndir ↓
          </button>
          <a href="#" target="_blank" rel="noopener noreferrer sponsored" class="mt-4 hidden font-mono text-xs text-accent-primary underline underline-offset-4" data-shopier-link>
            Shopier ödeme ekranını tekrar aç
          </a>
        </div>

        <details class="mt-6 hidden border-t border-rule-hairline pt-4" data-manual>
          <summary class="cursor-pointer font-mono text-xs text-ink-500">Ödeme yaptım ama doğrulama bekliyor</summary>
          <form class="mt-4" data-order-form>
            <label class="block">
              <span class="text-xs text-ink-500">Shopier sipariş numarası</span>
              <input type="text" maxlength="80" class="mt-2 min-h-11 w-full border border-rule-strong bg-white px-3 font-mono text-sm outline-none focus:border-accent-primary" data-order-id />
            </label>
            <button type="submit" class="mt-3 min-h-11 border border-rule-strong px-4 font-mono text-xs text-ink-700 hover:border-accent-primary">
              Siparişi Doğrula
            </button>
          </form>
        </details>
      </div>
    </div>
  </section>
</CommerceLayout>

<script>
  import { analytics, fileTypeFromDownloadUrl, resolveDownloadSource, trackAnalyticsEvent } from '../lib/analytics';

  const STORAGE_KEY = 'excelarsiv:last-checkout:v1';
  const root = document.querySelector('[data-delivery-root]');
  const emptyState = root?.querySelector('[data-empty-state]');
  const activeState = root?.querySelector('[data-active-state]');
  const productName = root?.querySelector('[data-product-name]');
  const amount = root?.querySelector('[data-amount]');
  const status = root?.querySelector('[data-status]');
  const detail = root?.querySelector('[data-detail]');
  const download = root?.querySelector('[data-download]');
  const shopierLink = root?.querySelector('[data-shopier-link]');
  const manual = root?.querySelector('[data-manual]');
  const orderForm = root?.querySelector('[data-order-form]');
  const orderId = root?.querySelector('[data-order-id]');
  const recoveryForm = root?.querySelector('[data-recovery-form]');
  const recoveryProduct = root?.querySelector('[data-recovery-product]');
  const recoveryEmail = root?.querySelector('[data-recovery-email]');
  const recoveryOrder = root?.querySelector('[data-recovery-order]');
  const recoverySubmit = root?.querySelector('[data-recovery-submit]');
  const recoveryMessage = root?.querySelector('[data-recovery-message]');

  let checkout = null;
  let startedAt = Date.now();
  let timer = null;

  function loadStored() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
    } catch {
      return null;
    }
  }

  function saveStored(value) {
    checkout = value;
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(value));
    } catch {
      // Strict privacy modes may block storage; current page still remains usable.
    }
  }

  checkout = loadStored();

  async function postJson(url, body) {
    const response = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) {
      const error = new Error(payload?.error || 'REQUEST_FAILED');
      error.code = payload?.error || 'REQUEST_FAILED';
      throw error;
    }
    return payload;
  }

  function setStatus(headline, description = '') {
    if (status) status.textContent = headline;
    if (detail) detail.textContent = description;
  }

  function activateCheckout(value) {
    saveStored(value);
    startedAt = Date.now();
    emptyState?.classList.add('hidden');
    activeState?.classList.remove('hidden');
    if (productName) productName.textContent = value.productName || 'Excel ürünü';
    if (amount) amount.textContent = value.amountTL ? `${Number(value.amountTL).toLocaleString('tr-TR')} TL` : '';
    if (shopierLink && value.shopierUrl) {
      shopierLink.href = value.shopierUrl;
      shopierLink.classList.remove('hidden');
    } else {
      shopierLink?.classList.add('hidden');
    }
  }

  function showPaid() {
    if (timer) window.clearTimeout(timer);
    timer = null;
    setStatus('Ödemeniz onaylandı', 'Excel dosyanız hazır. Aşağıdaki butona basarak doğrudan bilgisayarınıza indirebilirsiniz.');
    download?.classList.remove('hidden');
    shopierLink?.classList.add('hidden');
    manual?.classList.add('hidden');
  }

  function schedule() {
    if (timer) window.clearTimeout(timer);
    timer = window.setTimeout(checkStatus, 7000);
  }

  async function checkStatus() {
    if (!checkout?.checkoutId || !checkout?.checkoutSecret) return;
    try {
      const result = await postJson('/api/checkout-status', {
        checkoutId: checkout.checkoutId,
        checkoutSecret: checkout.checkoutSecret,
      });
      if (result.status === 'paid') return showPaid();
      if (result.status === 'expired') {
        setStatus('Ödeme oturumunun süresi doldu', 'Ödeme yapmadıysanız ürünü yeniden seçerek yeni işlem başlatın. Ödeme yaptıysanız Shopier sipariş numarasıyla erişimi geri yükleyebilirsiniz.');
        manual?.classList.remove('hidden');
        return;
      }
      setStatus('Ödemeniz doğrulanıyor', result.verificationDelayed
        ? 'Shopier doğrulaması geçici olarak gecikiyor; otomatik kontrol devam ediyor.'
        : 'Shopier ödeme kaydı kontrol ediliyor. Onay birkaç saniye içinde bu ekrana yansır.');
      if (Date.now() - startedAt > 45000) manual?.classList.remove('hidden');
      schedule();
    } catch {
      setStatus('Doğrulama devam ediyor', 'Shopier bağlantısı geçici olarak yanıt vermedi. Otomatik kontrol yeniden denenecek; bu sayfayı kapatmayın.');
      if (Date.now() - startedAt > 45000) manual?.classList.remove('hidden');
      schedule();
    }
  }

  if (checkout?.checkoutId && checkout?.checkoutSecret) {
    activateCheckout(checkout);
    setStatus('Shopier ödemeniz kontrol ediliyor', 'Ödeme onayı alındığında Excel\'i İndir butonu otomatik açılır.');
    checkStatus();
  }

  download?.addEventListener('click', async () => {
    if (!checkout) return;
    const templateId = String(checkout.productSlug || 'unknown');
    trackAnalyticsEvent(analytics.events.downloadStart, {
      templateId,
      source: resolveDownloadSource(),
    });
    download.setAttribute('disabled', '');
    setStatus('Dosyanız hazırlanıyor', 'Size özel güvenli indirme bağlantısı oluşturuluyor.');
    try {
      const result = await postJson('/api/download-token', {
        checkoutId: checkout.checkoutId,
        checkoutSecret: checkout.checkoutSecret,
      });
      const downloadUrl = String(result.downloadUrl);
      const link = document.createElement('a');
      link.href = downloadUrl;
      link.rel = 'nofollow';
      document.body.appendChild(link);
      link.click();
      link.remove();
      trackAnalyticsEvent(analytics.events.downloadComplete, {
        templateId,
        fileType: fileTypeFromDownloadUrl(downloadUrl),
      });
      setStatus('İndirme başladı', 'Excel dosyanız bilgisayarınıza indiriliyor.');
    } catch (error) {
      setStatus(
        'Dosya indirilemedi',
        error.code === 'FILE_NOT_READY'
          ? 'Ödemeniz kayıtlı; satış dosyasının özel teslim deposuna yüklenmesi bekleniyor.'
          : 'Geçici bir hata oluştu. İndirme butonunu yeniden kullanabilirsiniz.',
      );
    } finally {
      download.removeAttribute('disabled');
    }
  });

  orderForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const shopierOrderId = orderId?.value?.trim() || '';
    if (!checkout || !shopierOrderId) return;
    setStatus('Siparişiniz doğrulanıyor', 'Shopier sipariş kaydı kontrol ediliyor.');
    try {
      const result = await postJson('/api/verify-order', {
        checkoutId: checkout.checkoutId,
        checkoutSecret: checkout.checkoutSecret,
        shopierOrderId,
      });
      if (result.status === 'paid') showPaid();
    } catch {
      setStatus('Sipariş eşleşmedi', 'Sipariş numarası, e-posta, ürün seviyesi ve tutarın aynı olması gerekir.');
    }
  });

  recoveryForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const productSlug = recoveryProduct?.value || '';
    const email = recoveryEmail?.value?.trim() || '';
    const shopierOrderId = recoveryOrder?.value?.trim() || '';
    if (!productSlug || !email || !shopierOrderId) return;

    recoverySubmit?.setAttribute('disabled', '');
    if (recoveryMessage) recoveryMessage.textContent = 'Shopier siparişi doğrulanıyor…';
    try {
      const result = await postJson('/api/recover-purchase', { productSlug, email, shopierOrderId });
      const restored = { ...result, savedAt: Date.now(), deliveryUrl: '/teslimat' };
      activateCheckout(restored);
      showPaid();
    } catch (error) {
      const messages = {
        ORDER_DOES_NOT_MATCH: 'Sipariş; seçilen ürünün fiyat seviyesi, e-posta veya tutarıyla eşleşmedi.',
        ORDER_ALREADY_USED: 'Bu Shopier siparişi başka bir Excel ürünü için daha önce kullanılmış.',
        INVALID_ORDER_ID: 'Shopier sipariş numarasını kontrol edin.',
        RATE_LIMITED: 'Çok fazla doğrulama denemesi yapıldı. Bir süre sonra yeniden deneyin.',
        VERIFICATION_TEMPORARILY_UNAVAILABLE: 'Shopier doğrulaması geçici olarak kullanılamıyor. Birkaç dakika sonra yeniden deneyin.',
      };
      if (recoveryMessage) recoveryMessage.textContent = messages[error.code] || 'Satın alma geri yüklenemedi. Bilgileri kontrol edip yeniden deneyin.';
    } finally {
      recoverySubmit?.removeAttribute('disabled');
    }
  });
</script>
