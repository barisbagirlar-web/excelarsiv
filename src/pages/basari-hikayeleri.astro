    solution: 'Sipariş kuru, tahsilat kuru, üretim maliyeti, navlun ve finansman gideri tek analizde toplandı.',
    outcome: 'Örnek sonuç: operasyonel kâr ile kur farkından doğan sonuç ayrı satırlarda gösterilir.',
  },
  {
    city: 'Sakarya',
    sector: 'Makine ve ekipman',
    title: 'Bakım planı arıza listesinden maliyet önceliğine dönüştü',
    challenge: 'Bakım işleri tarih bazlı takip ediliyor ancak üretim kaybı ve arıza tekrarıyla önceliklendirilmiyordu.',
    solution: 'Makine, bakım tarihi, arıza geçmişi, duruş süresi ve maliyet etkisi ortak tabloda işlendi.',
    outcome: 'Örnek sonuç: bakım sırası yalnız tarihe göre değil, operasyonel risk ve parasal etkiye göre belirlenir.',
  },
  {
    city: 'Diyarbakır',
    sector: 'Bölgesel dağıtım',
    title: 'Müşteri vadeleri satış hacminden ayrı risk göstergesine dönüştü',
    challenge: 'Yüksek satış yapan müşteriler güçlü görünürken uzayan tahsilat süreleri nakit riskini büyütebiliyordu.',
