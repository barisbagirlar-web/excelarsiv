---
import CommerceLayout from '../../layouts/CommerceLayout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Button from '../../components/Button.astro';
import { getCollection } from 'astro:content';
import { SEKTORLER, type Sektor } from '../../data/sektorler';

const templates = await getCollection('templates');
const byId = new Map(templates.map((t) => [t.id, t.data.name]));

export async function getStaticPaths() {
  return SEKTORLER.map((sektor) => ({
    params: { slug: sektor.slug },
    props: { sektor },
  }));
}

interface Props {
  sektor: Sektor;
}

const { sektor } = Astro.props;
const rows = sektor.products
  .map((product) => ({ ...product, name: byId.get(product.slug) }))
  .filter((row): row is typeof row & { name: string } => Boolean(row.name));
---

<CommerceLayout title={`${sektor.title} Excel Sistemleri — Excel Arşiv`} description={sektor.description}>
  <section class="mx-auto max-w-3xl px-4 pb-24 pt-8">
    <SectionLabel number={9} label="Sektör Dikey" />
    <h1 class="display mt-6">{sektor.title}</h1>
    <p class="lead mt-6">{sektor.lead}</p>
    <ul class="mt-10 space-y-4">
      {
        rows.map((product) => (
          <li class="border-t border-rule-hairline pt-4">
            <a class="font-mono text-sm text-accent-primary underline underline-offset-4" href={`/sablon/${product.slug}`}>
              {product.name}
            </a>
            <p class="mt-1 text-sm text-ink-500">{product.neden}</p>
            <a class="mt-2 inline-block text-xs text-ink-400 underline" href={`/demo/${product.slug}`}>Proof Demo</a>
          </li>
        ))
      }
    </ul>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/sablonlar">Tüm şablonlar</Button>
      <Button href="/neden-excel-arsiv" variant="secondary">Neden Excel Arşiv?</Button>
    </div>
  </section>
</CommerceLayout>
