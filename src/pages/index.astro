---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../utils/slug';

const templates = await getCollection('templates');
const featured = [...templates].sort((a, b) => b.data.priceTL - a.data.priceTL).slice(0, 6);

const categoryLabels: Record<string, string> = {
  'finansal-analiz': 'Finansal Analiz',
  'nakit-akisi': 'Nakit Akışı',
  'muhasebe-ve-vergi': 'Muhasebe ve Vergi',
  'butce-ve-planlama': 'Bütçe ve Planlama',
  'stok-ve-uretim': 'Stok ve Üretim',
  'satis-ve-fiyatlama': 'Satış ve Fiyatlama',
  'personel-ve-bordro': 'Personel ve Bordro',
};

const categories = Object.entries(categoryLabels).map(([slug, name]) => ({
  slug,
  name,
  count: templates.filter((template) => template.data.category === slug).length,
}));

const searchIndex = templates.map((template) => ({
  name: template.data.name,
  summary: template.data.summary,
  category: categoryLabels[template.data.category] ?? template.data.category,
  url: `/sablon/${slugify(template.data.name)}`,
}));

const site = Astro.site ?? new URL('https://excelarsiv.com/');
const itemListLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Öne Çıkan Finansal Excel Şablonları',
  itemListElement: featured.map((template, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/sablon/${slugify(template.data.name)}`, site).href,
    item: {
      '@type': 'Product',
      name: template.data.name,
      description: template.data.summary,
      offers: {
        '@type': 'Offer',
        price: template.data.priceTL,
        priceCurrency: 'TRY',
        availability: 'https://schema.org/InStock',
      },
    },
  })),
});
---

<Layout
  mode="commerce"
  title="Excel Şablonları ve İşletme Çözümleri | Excel Arşiv"
  description="Nakit akışı, kasa, cari hesap, kârlılık, stok ve bütçe yönetimi için hazır finansal Excel şablonları ve işletme çözümleri."
>
  <script slot="head" type="application/ld+json" set:html={itemListLd} />

  <main class="home-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-seo sr-only">
        <h1 id="hero-title">Excel Şablonları ve İşletme Çözümleri</h1>
        <p>
          İşletmeler için hazırlanmış profesyonel Excel şablonlarıyla nakit akışınızı, kasa takibinizi,
          cari hesaplarınızı, kârlılığınızı ve raporlamanızı daha kolay yönetin.
        </p>
      </div>

      <div class="hero-visual">
        <img
          src="/images/hero.png"
          width="2172"
          height="724"
          alt="Excel şablonları ve finansal işletme çözümlerini gösteren yönetim paneli"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="hero-search-wrap">
        <form class="hero-search" id="hero-search" action="/sablonlar" method="get" role="search">
          <label class="sr-only" for="hero-search-input">Excel şablonu ara</label>
          <svg class="search-leading" aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-4-4"></path>
          </svg>
          <input
            id="hero-search-input"
            type="search"
            name="q"
            placeholder="Hazır şablonlarda arama yapın..."
            autocomplete="off"
            minlength="2"
            maxlength="80"
          />
          <button type="submit" aria-label="Şablonlarda ara">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-4-4"></path>
            </svg>
          </button>
          <div class="hero-search-results" id="hero-search-results" hidden></div>
        </form>
        <a class="all-templates" href="/sablonlar">Tüm şablonları inceleyin <span>→</span></a>
      </div>
    </section>

    <section class="trust-strip" aria-label="Satın alma avantajları">
      <div><strong>Demo ile inceleyin</strong><span>Satın almadan önce dosyanın yapısını görün.</span></div>
      <div><strong>KDV dahil fiyat</strong><span>Ürün sayfasındaki toplam fiyat üzerinden karar verin.</span></div>
      <div><strong>Tek seferlik ödeme</strong><span>Abonelik olmadan ürünü satın alın.</span></div>
      <div><strong>Dijital teslimat</strong><span>Dosyanızı ödeme sonrasında kullanmaya başlayın.</span></div>
    </section>

    <section class="section categories" aria-labelledby="categories-title">
      <div class="section-heading">
        <div>
          <span>İHTİYACA GÖRE SEÇİN</span>
          <h2 id="categories-title">Aradığınız çözümü kategoriye göre bulun</h2>
        </div>
        <p>Dosya adına göre değil, çözmek istediğiniz işletme problemine göre ilerleyin.</p>
      </div>

      <div class="category-grid">
        {categories.map((category) => (
          <a href={`/sablonlar/${category.slug}`} class="category-card">
            <div>
              <strong>{category.name}</strong>
              <span>{category.count} hazır sistem</span>
            </div>
            <b>→</b>
          </a>
        ))}
      </div>
    </section>

    <section class="section featured" aria-labelledby="featured-title">
      <div class="section-heading">
        <div>
          <span>ÖNE ÇIKAN ŞABLONLAR</span>
          <h2 id="featured-title">İşletmede doğrudan kullanılan Excel sistemleri</h2>
        </div>
        <a href="/sablonlar">Tümünü incele →</a>
      </div>

      <div class="product-grid">
        {featured.map((template) => {
          const t = template.data;
          const url = `/sablon/${slugify(t.name)}`;
          return (
            <article class="product-card">
              <a class="product-preview" href={url} aria-label={`${t.name} detayını aç`}>
                <div class="preview-top"><span>{t.fileFormat.toUpperCase()}</span><b>{categoryLabels[t.category]}</b></div>
                <div class="preview-body">
                  <div class="preview-kpis"><i></i><i></i><i></i></div>
                  <div class="preview-chart"><i></i><i></i><i></i><i></i><i></i><i></i></div>
                  <div class="preview-table"><i></i><i></i><i></i><i></i></div>
                </div>
              </a>
              <div class="product-content">
                <div class="product-meta"><span>{t.sheetCount} çalışma sayfası</span><span>{t.hasMacros ? 'Makrolu' : 'Makrosuz'}</span></div>
                <h3><a href={url}>{t.name}</a></h3>
                <p>{t.summary}</p>
                <ul>
                  {t.outputs.slice(0, 3).map((output) => <li>{output}</li>)}
                </ul>
                <div class="product-footer">
                  <div><small>KDV dahil</small><strong>{t.priceTL.toLocaleString('tr-TR')} TL</strong></div>
                  <a href={url}>İncele <span>→</span></a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="value-section" aria-labelledby="value-title">
      <div class="value-copy">
        <span>EXCEL DOSYASI DEĞİL, ÇALIŞAN SİSTEM</span>
        <h2 id="value-title">Tabloyu değil, karar hızını satın alın.</h2>
        <p>
          Excel Arşiv ürünleri yalnızca veri toplamaz. Girdileri hesaplamaya, hesaplamaları yönetim
          çıktısına ve uyarıya dönüştüren kullanıma hazır çalışma sistemleri sunar.
        </p>
        <a class="primary-button" href="/nasil-calisir">Nasıl çalıştığını görün <b>→</b></a>
      </div>
      <div class="value-grid">
        <article><strong>Hazır hesaplama yapısı</strong><p>Formülleri ve veri akışı önceden kurulmuş dosyalar.</p></article>
        <article><strong>Yönetim çıktıları</strong><p>Raporlama için ayrıca tablo kurmadan sonuçlara ulaşın.</p></article>
        <article><strong>Açık ürün kapsamı</strong><p>Girdileri, çıktıları ve uyumluluğu satın almadan önce görün.</p></article>
        <article><strong>İşletme odaklı kullanım</strong><p>Kasa, tahsilat, stok, kredi ve gerçek kârlılık çözümleri.</p></article>
      </div>
    </section>

    <section class="section process" aria-labelledby="process-title">
      <div class="section-heading centered">
        <div>
          <span>3 ADIMDA BAŞLAYIN</span>
          <h2 id="process-title">Kurulum projesine dönüşmeden kullanın</h2>
        </div>
      </div>
      <div class="steps">
        <article><b>01</b><strong>Demo dosyasını inceleyin</strong><p>Sayfaları ve üretilecek çıktıları satın almadan önce görün.</p></article>
        <article><b>02</b><strong>İhtiyacınıza uygun sistemi seçin</strong><p>Kapsam, uyumluluk ve fiyat üzerinden karar verin.</p></article>
        <article><b>03</b><strong>Kendi verinizle çalıştırın</strong><p>Dosyayı indirin, verilerinizi girin ve raporları kullanın.</p></article>
      </div>
    </section>

    <section class="final-cta">
      <div><span>DAĞINIK EXCEL DOSYALARINI BIRAKIN</span><h2>Finansal kontrolü bugün kurun.</h2></div>
      <a href="/sablonlar">Şablonları İncele <b>→</b></a>
    </section>
  </main>

  <script id="template-search-index" type="application/json" set:html={JSON.stringify(searchIndex)} />

  <script>
    const normalizeText = (value) =>
      value
        .toLocaleLowerCase('tr-TR')
        .normalize('NFD')
        .replace(/\p{Diacritic}/gu, '')
        .trim();

    const input = document.querySelector('#hero-search-input');
    const results = document.querySelector('#hero-search-results');
    const indexNode = document.querySelector('#template-search-index');

    if (input instanceof HTMLInputElement && results instanceof HTMLElement && indexNode) {
      const templates = JSON.parse(indexNode.textContent || '[]');

      const closeResults = () => {
        results.hidden = true;
        results.replaceChildren();
      };

      input.addEventListener('input', () => {
        const query = normalizeText(input.value);
        if (query.length < 2) {
          closeResults();
          return;
        }

        const matches = templates
          .filter((template) =>
            normalizeText(`${template.name} ${template.summary} ${template.category}`).includes(query)
          )
          .slice(0, 6);

        results.replaceChildren();

        if (matches.length === 0) {
          const empty = document.createElement('p');
          empty.textContent = 'Eşleşen şablon bulunamadı.';
          results.append(empty);
        } else {
          matches.forEach((template) => {
            const link = document.createElement('a');
            link.href = template.url;

            const name = document.createElement('strong');
            name.textContent = template.name;

            const summary = document.createElement('span');
            summary.textContent = template.summary;

            link.append(name, summary);
            results.append(link);
          });
        }

        results.hidden = false;
      });

      document.addEventListener('click', (event) => {
        if (event.target instanceof Node && !document.querySelector('#hero-search')?.contains(event.target)) {
          closeResults();
        }
      });

      input.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeResults();
      });
    }
  </script>
</Layout>

<style>
  .home-page { --green:#107c41; --green-dark:#0b5f34; --ink:#17221d; --muted:#627168; --line:#dce6e0; --soft:#edf6f1; background:#f7f9f8; color:var(--ink); }
  .sr-only { position:absolute!important; width:1px!important; height:1px!important; padding:0!important; margin:-1px!important; overflow:hidden!important; clip:rect(0,0,0,0)!important; white-space:nowrap!important; border:0!important; }

  .hero { position:relative; max-width:1440px; margin:0 auto; padding:28px clamp(18px,3.5vw,52px) 92px; }
  .hero-visual { overflow:hidden; border:1px solid #d8e2dc; border-radius:24px; background:#eef2f6; box-shadow:0 28px 80px rgba(28,53,40,.12); }
  .hero-visual img { display:block; width:100%; height:auto; aspect-ratio:3/1; object-fit:cover; }
  .hero-search-wrap { position:absolute; left:50%; bottom:25px; z-index:5; display:grid; width:min(860px,calc(100% - 52px)); justify-items:center; transform:translateX(-50%); }
  .hero-search { position:relative; display:grid; grid-template-columns:32px minmax(0,1fr) 64px; align-items:center; width:100%; min-height:78px; padding:7px 8px 7px 24px; border:1px solid #a8ceb8; border-radius:22px; background:rgba(255,255,255,.98); box-shadow:0 22px 55px rgba(20,76,47,.19); backdrop-filter:blur(18px); }
  .hero-search:focus-within { border-color:var(--green); box-shadow:0 0 0 4px rgba(16,124,65,.12),0 24px 60px rgba(20,76,47,.2); }
  .hero-search input { min-width:0; height:62px; padding:0 18px; border:0; outline:0; background:transparent; color:var(--ink); font:inherit; font-size:clamp(17px,1.5vw,21px); }
  .hero-search input::placeholder { color:#7d8982; }
  .hero-search svg { fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; }
  .search-leading { width:27px; color:#86948c; }
  .hero-search button { display:grid; width:58px; height:58px; place-items:center; border:0; border-radius:17px; background:var(--green); color:white; cursor:pointer; transition:transform .18s ease,background .18s ease; }
  .hero-search button:hover { background:var(--green-dark); transform:translateY(-1px); }
  .hero-search button svg { width:26px; }
  .all-templates { margin-top:13px; color:var(--green-dark); font-size:13px; font-weight:800; text-decoration:none; }
  .all-templates span { margin-left:6px; }
  .hero-search-results { position:absolute; top:88px; left:0; right:0; overflow:hidden; border:1px solid var(--line); border-radius:18px; background:white; box-shadow:0 24px 60px rgba(24,49,35,.18); }
  .hero-search-results a { display:grid; gap:4px; padding:14px 18px; border-bottom:1px solid #e8eeeb; color:var(--ink); text-decoration:none; }
  .hero-search-results a:hover { background:#f1f8f4; }
  .hero-search-results strong { font-size:14px; }
  .hero-search-results span,.hero-search-results p { margin:0; color:var(--muted); font-size:12px; line-height:1.45; }
  .hero-search-results p { padding:18px; }

  .trust-strip { display:grid; grid-template-columns:repeat(4,1fr); max-width:1240px; margin:36px auto 0; overflow:hidden; border:1px solid var(--line); border-radius:18px; background:white; box-shadow:0 12px 35px rgba(28,53,40,.06); }
  .trust-strip div { display:grid; gap:6px; padding:24px 26px; }
  .trust-strip div+div { border-left:1px solid #e4ebe7; }
  .trust-strip strong { font-size:14px; }
  .trust-strip span { color:var(--muted); font-size:12px; line-height:1.5; }

  .section { max-width:1240px; margin:0 auto; padding:104px clamp(20px,5vw,72px); }
  .section-heading { display:flex; align-items:end; justify-content:space-between; gap:40px; margin-bottom:38px; }
  .section-heading>div { max-width:760px; }
  .section-heading span,.value-copy>span,.final-cta span { color:var(--green-dark); font-size:11px; font-weight:900; letter-spacing:.11em; text-transform:uppercase; }
  .section-heading h2,.value-copy h2,.final-cta h2 { margin:10px 0 0; font-family:"Inter Tight",Inter,sans-serif; font-size:clamp(34px,4vw,52px); line-height:1.03; letter-spacing:-.045em; }
  .section-heading p { max-width:400px; margin:0; color:var(--muted); line-height:1.65; }
  .section-heading>a { color:var(--green-dark); font-weight:800; text-decoration:none; white-space:nowrap; }
  .centered { justify-content:center; text-align:center; }

  .category-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }
  .category-card { display:flex; min-height:104px; align-items:center; justify-content:space-between; gap:18px; padding:22px; border:1px solid var(--line); border-radius:16px; background:white; color:var(--ink); text-decoration:none; transition:transform .2s,border-color .2s,box-shadow .2s; }
  .category-card:hover { transform:translateY(-3px); border-color:#91c6a8; box-shadow:0 16px 35px rgba(28,53,40,.09); }
  .category-card div { display:grid; gap:7px; }
  .category-card strong { font-size:15px; }
  .category-card span { color:var(--muted); font-size:11px; }
  .category-card b { color:var(--green); font-size:18px; }

  .featured { max-width:none; background:#edf4f0; }
  .featured>.section-heading,.featured>.product-grid { max-width:1240px; margin-left:auto; margin-right:auto; }
  .product-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
  .product-card { overflow:hidden; border:1px solid #d9e4de; border-radius:18px; background:white; box-shadow:0 10px 28px rgba(28,53,40,.06); transition:transform .2s,box-shadow .2s; }
  .product-card:hover { transform:translateY(-5px); box-shadow:0 24px 48px rgba(28,53,40,.12); }
  .product-preview { display:block; height:215px; padding:15px; background:linear-gradient(145deg,#e5f1ea,#f9fbfa); color:inherit; text-decoration:none; }
  .preview-top { display:flex; justify-content:space-between; padding:10px 12px; border-radius:10px 10px 0 0; background:#176b42; color:white; font-size:9px; font-weight:800; }
  .preview-body { display:grid; grid-template-columns:1.15fr .85fr; grid-template-rows:auto 1fr; gap:9px; height:145px; padding:13px; border:1px solid #d6e1db; border-top:0; border-radius:0 0 10px 10px; background:white; }
  .preview-kpis { grid-column:1/-1; display:grid; grid-template-columns:repeat(3,1fr); gap:7px; }
  .preview-kpis i { height:27px; border-radius:5px; background:#e9f1ed; }
  .preview-kpis i:first-child { background:#c6e3d2; }
  .preview-chart { display:flex; align-items:flex-end; gap:5px; padding:9px; border:1px solid #ecf1ee; }
  .preview-chart i { flex:1; border-radius:3px 3px 0 0; background:#84c39e; }
  .preview-chart i:nth-child(1){height:32%}.preview-chart i:nth-child(2){height:58%}.preview-chart i:nth-child(3){height:44%}.preview-chart i:nth-child(4){height:75%}.preview-chart i:nth-child(5){height:62%}.preview-chart i:nth-child(6){height:91%}
  .preview-table { display:grid; align-content:start; gap:7px; padding:10px; border:1px solid #ecf1ee; }
  .preview-table i { height:8px; border-radius:3px; background:#e3ebe7; }
  .preview-table i:first-child { background:#aed5bf; }
  .product-content { padding:23px; }
  .product-meta { display:flex; gap:14px; margin-bottom:12px; color:#748078; font-size:9px; font-weight:800; text-transform:uppercase; }
  .product-content h3 { min-height:48px; margin:0 0 10px; font-size:17px; line-height:1.35; }
  .product-content h3 a { color:var(--ink); text-decoration:none; }
  .product-content>p { min-height:62px; margin:0; color:var(--muted); font-size:12px; line-height:1.65; }
  .product-content ul { display:grid; gap:8px; min-height:78px; margin:18px 0 22px; padding:0; list-style:none; }
  .product-content li { position:relative; padding-left:17px; color:#4f5d55; font-size:11px; }
  .product-content li:before { content:'✓'; position:absolute; left:0; color:var(--green); font-weight:900; }
  .product-footer { display:flex; align-items:end; justify-content:space-between; padding-top:18px; border-top:1px solid #e5ece8; }
  .product-footer div { display:grid; gap:3px; }
  .product-footer small { color:#7b8780; font-size:9px; }
  .product-footer strong { font-size:21px; }
  .product-footer>a { padding:10px 13px; border-radius:10px; background:var(--soft); color:var(--green-dark); font-size:11px; font-weight:800; text-decoration:none; }

  .value-section { display:grid; grid-template-columns:.9fr 1.1fr; gap:70px; align-items:center; max-width:1240px; margin:0 auto; padding:108px clamp(20px,5vw,72px); }
  .value-copy p { margin:23px 0 28px; color:var(--muted); font-size:16px; line-height:1.75; }
  .primary-button { display:inline-flex; min-height:52px; align-items:center; gap:20px; padding:0 20px; border-radius:11px; background:var(--green); color:white; font-size:13px; font-weight:800; text-decoration:none; box-shadow:0 14px 30px rgba(16,124,65,.2); }
  .value-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; }
  .value-grid article { padding:25px; border:1px solid var(--line); border-radius:16px; background:white; }
  .value-grid strong { font-size:15px; }
  .value-grid p { margin:10px 0 0; color:var(--muted); font-size:12px; line-height:1.6; }

  .steps { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  .steps article { display:grid; gap:12px; padding:29px; border:1px solid var(--line); border-radius:17px; background:white; }
  .steps b { display:grid; width:43px; height:43px; place-items:center; border-radius:11px; background:var(--soft); color:var(--green); font-size:12px; }
  .steps strong { font-size:17px; }
  .steps p { margin:0; color:var(--muted); font-size:13px; line-height:1.65; }

  .final-cta { display:flex; align-items:end; justify-content:space-between; gap:40px; max-width:1240px; margin:0 auto 108px; padding:52px 58px; border-radius:22px; background:#0b5f34; color:white; box-shadow:0 30px 70px rgba(11,95,52,.22); }
  .final-cta span { color:#b9e4ca; }
  .final-cta h2 { color:white; }
  .final-cta>a { display:inline-flex; min-height:52px; align-items:center; gap:18px; padding:0 20px; border-radius:11px; background:white; color:var(--green-dark); font-weight:800; text-decoration:none; white-space:nowrap; }

  @media(max-width:1080px){
    .hero { padding-bottom:104px; }
    .category-grid { grid-template-columns:repeat(2,1fr); }
    .product-grid { grid-template-columns:repeat(2,1fr); }
    .trust-strip { grid-template-columns:repeat(2,1fr); margin-inline:20px; }
    .trust-strip div:nth-child(3) { border-left:0; border-top:1px solid #e4ebe7; }
    .trust-strip div:nth-child(4) { border-top:1px solid #e4ebe7; }
    .value-section { grid-template-columns:1fr; }
  }

  @media(max-width:760px){
    .hero { padding:16px 14px 108px; }
