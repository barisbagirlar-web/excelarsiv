---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import TrustStrip from '../components/home/TrustStrip.astro';
import CategorySection from '../components/home/CategorySection.astro';
import FeaturedTemplates from '../components/home/FeaturedTemplates.astro';
import ValueSection from '../components/home/ValueSection.astro';
import GainSection from '../components/home/GainSection.astro';
import ProcessSection from '../components/home/ProcessSection.astro';
import PurchaseProcess from '../components/home/PurchaseProcess.astro';
import FinalCTA from '../components/home/FinalCTA.astro';

import { getFeaturedTemplates, getTemplateSearchIndex } from '../lib/templates';

const featuredTemplates = await getFeaturedTemplates(6);
const searchIndex = await getTemplateSearchIndex();
---

<CommerceLayout
  title="Excel Şablonları ve İşletme Çözümleri | Excel Arşiv"
  description="Kasa, nakit akışı, cari hesap, stok ve kârlılık işleriniz için hazır Excel dosyaları. Demo dosyayla inceleyin, Shopier ile ödeyin, e-postayla alın."
>
  <HeroSection searchIndex={searchIndex} />
  <TrustStrip />
  <CategorySection />
  <FeaturedTemplates templates={featuredTemplates} />
  <ValueSection />
  <GainSection />
  <ProcessSection />
  <PurchaseProcess />
  <FinalCTA />
</CommerceLayout>
