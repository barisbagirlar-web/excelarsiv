---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import TemplateCard from '../components/TemplateCard.astro';
import { slugify } from '../utils/slug';

const templates = await getCollection('templates');
const featured = templates.slice(0, 3);

const categories = [
  { slug: 'finansal-analiz', name: 'Finansal Analiz' },
  { slug: 'nakit-akisi', name: 'Nakit Akışı' },
  { slug: 'muhasebe-ve-vergi', name: 'Muhasebe ve Vergi' },
  { slug: 'butce-ve-planlama', name: 'Bütçe ve Planlama' },
  { slug: 'stok-ve-uretim', name: 'Stok ve Üretim' },
  { slug: 'satis-ve-fiyatlama', name: 'Satış ve Fiyatlama' },
  { slug: 'personel-ve-bordro', name: 'Personel ve Bordro' },
];

const categoryName = (slug: string) => categories.find((c) => c.slug === slug)?.name ?? slug;

const roiRows = [
  ['Banka ve cari mutabakat', '4 saat / ay', '30 dk / ay'],
  ['Rapor hazırlama', '8 saat / ay', '1 saat / ay'],
  ['Hata riski', 'Yüksek', 'Düşük'],
  ['Aylık toplam', '12 saat / ay', '1,5 saat / ay'],
];

const methodology = [
  {
    title: 'İhtiyaç analizi',
    description: 'Dosyanın çözeceği iş problemini, çıktı biçimini ve raporlama dönemini tanımlıyoruz.',
  },
  {
    title: 'Model kurulumu',
    description: 'Formüller, adlandırılmış aralıklar, veri doğrulama ve sayfa korumalarıyla yapıyı kuruyoruz.',
  },
  {
    title: 'Gerçek veriyle test',
    description: 'Farklı Excel sürümlerinde ve gerçek iş senaryolarıyla sonuçları doğruluyoruz.',
  },
  {
    title: 'Belgeleme',
    description: 'Girdi alanlarını, hesaplama mantığını ve uyarıları dosyanın içinde açıklıyoruz.',
  },
];

const cardVariants = ['sparkline', 'hm', 'bars'] as const;
---

<Layout
  title="Excel Arşiv — İşletmeniz için Hazır Excel Çalışma Tabloları"
  description="Kasa, nakit akışı, cari hesap, stok ve kârlılık işleriniz için hazır Excel dosyaları. Demo dosyayla inceleyin, Shopier ile ödeyin, e-postayla alın."
>
  <!-- C1 · Sütun başlıkları (dekoratif) -->
  <div class="colheads" aria-hidden="true">
    <span class="corner"></span><span>A</span><span class="sel">B</span><span>C</span><span>D</span
    ><span>E</span><span>F</span><span>G</span><span>H</span><span>I</span>
  </div>
  <div class="sheet-body">
    <!-- C1 · Satır başlıkları (dekoratif) -->
    <div class="rowheads" aria-hidden="true">
      <span>1</span><span class="sel">2</span><span>3</span><span>4</span><span>5</span
      ><span>6</span><span>7</span><span>8</span><span>9</span><span>10</span><span>11</span
      ><span>12</span>
    </div>
    <!-- C1 · Hero — 3 bölge: names/zone-a + hero-center + dash + roam -->
    <header class="hero">
      <div class="names" aria-hidden="true">
        <small>TANIMLI ADLAR:</small><b>KASA_TOTAL</b><b>STOK_MIN</b><b>KDV_ORAN</b><b>NET_KAR</b>
      </div>

      <div class="zone-a" aria-label="Canlı girdi önizlemesi">
        <div class="za-head mono"><span>GİRDİ · Sayfa1!A1:B5</span><span class="cf good">canlı</span></div>
        <table class="za">
          <tr>
            <th></th>
            <th>A</th>
            <th>B</th>
          </tr>
          <tr>
            <td>1</td>
            <td style="text-align:left">Gelir</td>
            <td><span class="type t1">₺128.400</span></td>
          </tr>
          <tr>
            <td>2</td>
            <td style="text-align:left">Gider</td>
            <td><span class="type t2">₺86.150</span></td>
          </tr>
          <tr>
            <td>3</td>
            <td style="text-align:left">Net</td>
            <td class="netcell"><span class="calcfx"></span><span class="netv">₺42.250</span><i class="cmnt"></i></td>
          </tr>
          <tr>
            <td>4</td>
            <td style="text-align:left">KDV</td>
            <td class="editcell"><span class="cursor"></span></td>
          </tr>
        </table>
        <div class="za-link mono">
          → B3 = <b>B1-B2</b> · Dashboard'a bağlandı <span class="cf good">✓</span>
        </div>
      </div>

      <div class="hero-center">
        <p class="kicker">HÜCRE B2 · BİRLEŞTİRİLMİŞ</p>
        <h1 class="display">
          Rakam sizden,<br /><em>mühendislik</em> bizden.
        </h1>
        <p class="lead">
          Formülleri test edilmiş, yapısı denetlenmiş, indirildiği anda çalışan kurumsal Excel şablonları. Soldaki hücreler gibi: yaz, hesaplasın, dashboard'a aksın.
        </p>
        <div class="cta-row">
          <a class="btn primary" href="/sablonlar">Şablonları İncele <span class="ar">→</span></a>
          <a class="btn" href="/nasil-calisir">Nasıl Çalışır <span class="dn">↓</span></a>
        </div>
        <div class="trust">
          <span class="cf good">KDV Dahil</span><span class="cf good">VUK Uyumlu</span
          ><span class="cf warn">v3.2 · 47 Test</span>
        </div>
      </div>

      <aside class="dash" aria-label="Örnek dashboard">
        <span class="balloon" style="top:-14px;right:14px">=B4*KDV_ORAN</span>
        <div class="dash-tabs"><a class="active">Dashboard</a><a>Veri</a><a>Grafik</a></div>
        <div class="dash-body">
          <div class="kpis">
            <div class="kpi">
              <small>ŞABLON</small>
              <span class="row"
                ><b class="odo" role="img" aria-label="12"
                  ><span class="d" style="--v:1;--dl:.5s"><i><span>0</span><span>1</span></i></span
                  ><span class="d" style="--v:2;--dl:.6s"><i><span>0</span><span>1</span><span>2</span></i></span></b
                ></span
              >
            </div>
            <div class="kpi">
              <small>TEST CASE</small>
              <span class="row"
                ><b class="odo" role="img" aria-label="47"
                  ><span class="d" style="--v:4;--dl:.7s"><i><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span></i></span
                  ><span class="d" style="--v:7;--dl:.8s"><i><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span></i></span></b
                ></span
              >
            </div>
            <div class="kpi">
              <small>DOĞRULUK</small>
              <span class="row"
                ><i>%</i><b class="odo" role="img" aria-label="98"
                  ><span class="d" style="--v:9;--dl:.9s"><i><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span></i></span
                  ><span class="d" style="--v:8;--dl:1s"><i><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span></i></span></b
                ></span
              >
            </div>
            <div class="kpi">
              <small>İNDİRME</small>
              <span class="row"
                ><b class="odo" role="img" aria-label="2400"
                  ><span class="d" style="--v:2;--dl:1.1s"><i><span>0</span><span>1</span><span>2</span></i></span
                  ><span class="d" style="--v:4;--dl:1.2s"><i><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span></i></span
                  ><span class="d" style="--v:0;--dl:1.3s"><i><span>0</span></i></span
                  ><span class="d" style="--v:0;--dl:1.4s"><i><span>0</span></i></span></b
                ><i>+</i></span
              >
            </div>
          </div>
          <div class="livebar mono">
            <span class="pulse"></span>KASA
            <span class="live"><span>₺48.200</span><span>₺49.140</span><span>₺48.750</span></span>
            <span class="cf good"><b class="upar">▲</b> canlı</span>
          </div>
          <div class="charts">
            <div class="panel">
              <div class="cap"><span>NAKİT AKIŞI · 7 AY</span><span class="cf good"><b class="upar">▲</b> %18</span></div>
              <svg class="lc" viewBox="0 0 320 130" preserveAspectRatio="none" aria-hidden="true">
                <g class="gridl"><line x1="0" y1="32" x2="320" y2="32"/><line x1="0" y1="65" x2="320" y2="65"/><line x1="0" y1="98" x2="320" y2="98"/></g>
                <path class="area" d="M0,104 L53,88 L106,94 L160,62 L213,70 L266,40 L320,30 L320,130 L0,130 Z"/>
                <polyline class="ln2" points="0,112 53,102 106,106 160,86 213,90 266,70 320,62"/>
                <polyline class="ln" points="0,104 53,88 106,94 160,62 213,70 266,40 320,30"/>
                <g class="dots"><circle cx="0" cy="104" r="3.5"/><circle cx="53" cy="88" r="3.5"/><circle cx="106" cy="94" r="3.5"/><circle cx="160" cy="62" r="3.5"/><circle cx="213" cy="70" r="3.5"/><circle cx="266" cy="40" r="3.5"/><circle cx="320" cy="30" r="3.5"/></g>
              </svg>
              <div class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
              <div class="legend"><span><i style="background:var(--ch-1)"></i>Gider</span><span><i style="background:var(--ch-6)"></i>Gelir</span></div>
            </div>
            <div class="panel">
              <div class="cap"><span>TAHSİLAT</span></div>
              <div class="donut" aria-hidden="true"></div>
              <div class="legend" style="justify-content:center;margin-top:12px"><span><i style="background:var(--xl-green)"></i>Tahsil</span><span><i style="background:var(--xl-grid)"></i>Bekleyen</span></div>
            </div>
          </div>
        </div>
      </aside>
      <div class="roam" aria-hidden="true"></div>
    </header>
  </div>

  <!-- C2 · Kategori sekmeleri -->
  <nav class="sheet-tabs" aria-label="Kategoriler">
    {
      categories.map((cat, index) => (
        <a href={`/sablonlar/${cat.slug}`} class={index === 0 ? 'active' : undefined}>
          {cat.name}
        </a>
      ))
    }
    <span class="plus" title="Yeni şablon yakında">+</span>
  </nav>

  <!-- C3 · Showcase: Excel'in görsel silahları -->
  <section class="showcase">
    <div class="sec-head"><span class="namebox">C4</span><h2 class="h2">Excel'in Görsel Silahları — Şablonların İçinde</h2></div>
    <div class="tiles">
      <div class="tile">
        <span class="tag">CF-01 · KOŞULLU BİÇİM</span><h3>Veri Çubukları</h3>
        <div class="dbrow"><span>OCA</span><span class="db"><i style="--w:64%;animation-delay:.5s"></i></span><span>64</span></div>
        <div class="dbrow"><span>ŞUB</span><span class="db"><i style="--w:82%;animation-delay:.7s"></i></span><span>82</span></div>
        <div class="dbrow"><span>MAR</span><span class="db"><i style="--w:47%;animation-delay:.9s"></i></span><span>47</span></div>
        <div class="dbrow"><span>NİS</span><span class="db"><i style="--w:91%;animation-delay:1.1s"></i></span><span>91</span></div>
      </div>
      <div class="tile">
        <span class="tag">CF-02 · SPARKLINE</span><h3>Eğilim Çizgisi</h3>
        <svg class="sp" viewBox="0 0 200 44" preserveAspectRatio="none" aria-hidden="true"><polyline points="0,34 25,28 50,31 75,20 100,24 125,14 150,18 175,8 200,10"/><circle class="last" cx="200" cy="10" r="3"/></svg>
        <div class="dbrow" style="margin-top:10px"><span>NET</span><span class="db"><i style="--w:76%;animation-delay:1.3s"></i></span><span class="cf good">▲</span></div>
      </div>
      <div class="tile">
        <span class="tag">CF-03 · ICON SETS</span><h3>Yön Göstergeleri</h3>
        <div class="iset"><div><span>Brüt Kâr</span><b class="up">▲ %24</b></div><div><span>Stok Devri</span><b class="fl">→ 4,2</b></div><div><span>Fire</span><b class="dn2">▼ %1,8</b></div><div><span>Tahsilat</span><b class="up">▲ %96</b></div></div>
      </div>
      <div class="tile">
        <span class="tag">CF-04 · COLOR SCALE</span><h3>Isı Haritası</h3>
        <div class="hm" aria-hidden="true"><i style="--a:.15;--d:.4s"></i><i style="--a:.35;--d:.5s"></i><i style="--a:.55;--d:.6s"></i><i style="--a:.8;--d:.7s"></i><i style="--a:.95;--d:.8s"></i><i style="--a:.6;--d:.9s"></i><i style="--a:.25;--d:.5s"></i><i style="--a:.45;--d:.6s"></i><i style="--a:.7;--d:.7s"></i><i style="--a:.9;--d:.8s"></i><i style="--a:.5;--d:.9s"></i><i style="--a:.3;--d:1s"></i><i style="--a:.1;--d:.6s"></i><i style="--a:.3;--d:.7s"></i><i style="--a:.5;--d:.8s"></i><i style="--a:.65;--d:.9s"></i><i style="--a:.85;--d:1s"></i><i style="--a:.4;--d:1.1s"></i></div>
      </div>
    </div>

    <!-- C4 · Öne çıkan şablonlar -->
    <div class="sec-head" style="margin-top:44px"><span class="namebox">B14</span><h2 class="h2">Öne Çıkan Şablonlar</h2><a class="all" href="/sablonlar">Tümünü Gör <span class="ar">→</span></a></div>
    {/*
      ÖRNEK VERİ — GATE-2'de koleksiyonla değişecek.
      Koleksiyon boşsa referanstaki 3 statik kart render edilir.
    */}
    {
      featured.length > 0 ? (
        <div class="cards">
          {
            featured.map((template, index) => (
              <TemplateCard
                slug={slugify(template.data.name)}
                name={template.data.name}
                summary={template.data.summary}
                sheetCount={template.data.sheetCount}
                priceTL={template.data.priceTL}
                category={categoryName(template.data.category)}
                version={template.data.version}
                variant={cardVariants[index]}
                sheetMap={template.data.sheetMap}
              />
            ))
          }
        </div>
      ) : (
        <div class="cards">
          <article class="wb"><div class="wb-title"><span class="xic">X</span>nakit-akisi.xlsx<span class="cf good" style="margin-left:auto">v3.2</span></div>
            <div class="wb-body"><svg class="sp" viewBox="0 0 200 44" preserveAspectRatio="none" aria-hidden="true"><polyline points="0,36 28,30 56,33 84,22 112,26 140,15 168,19 200,8"/><circle class="last" cx="200" cy="8" r="3"/></svg>
            <table><tr><th></th><th>A</th><th>B</th><th>C</th></tr><tr><td>1</td><td>Dönem</td><td>Akış</td><td>Durum</td></tr><tr><td>2</td><td>Q1</td><td class="sel">₺48.200</td><td class="cf good">▲</td></tr><tr><td>3</td><td>Q2</td><td>₺61.750</td><td class="cf good">▲</td></tr></table></div>
            <div class="wb-foot"><span class="wb-tab">Nakit Akışı</span><span class="cf good price">₺1.290</span></div></article>
          <article class="wb"><div class="wb-title"><span class="xic">X</span>kdv-hesap.xlsx<span class="cf good" style="margin-left:auto">v2.8</span></div>
            <div class="wb-body"><div class="hm" aria-hidden="true" style="margin-bottom:10px"><i style="--a:.2;--d:.4s"></i><i style="--a:.5;--d:.5s"></i><i style="--a:.85;--d:.6s"></i><i style="--a:.35;--d:.7s"></i><i style="--a:.65;--d:.8s"></i><i style="--a:.95;--d:.9s"></i></div>
            <table><tr><th></th><th>A</th><th>B</th><th>C</th></tr><tr><td>1</td><td>Matrah</td><td>KDV</td><td>Oran</td></tr><tr><td>2</td><td>8.200</td><td class="sel">1.640</td><td>%20</td></tr><tr><td>3</td><td>4.500</td><td>450</td><td>%10</td></tr></table></div>
            <div class="wb-foot"><span class="wb-tab">Muhasebe ve Vergi</span><span class="cf good price">₺890</span></div></article>
          <article class="wb"><div class="wb-title"><span class="xic">X</span>stok-takip.xlsx<span class="cf warn" style="margin-left:auto">v4.0</span></div>
            <div class="wb-body"><div class="bars" style="height:64px;margin-top:0" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
            <table><tr><th></th><th>A</th><th>B</th><th>C</th></tr><tr><td>1</td><td>SKU</td><td>Mevcut</td><td>Sinyal</td></tr><tr><td>2</td><td>ST-01</td><td class="sel">180</td><td class="cf good">▲</td></tr><tr><td>3</td><td>ST-02</td><td>4</td><td class="cf warn">→</td></tr></table></div>
            <div class="wb-foot"><span class="wb-tab">Stok ve Üretim</span><span class="cf good price">₺1.490</span></div></article>
        </div>
      )
    }
  </section>

  <!-- C5 · ROI — .za tablosu; "1,5 saat / ay" .netv stili (CF yeşil) -->
  <section class="border-t border-rule-hairline">
    <div class="container-site grid-12 section-enter items-start">
      <div class="col-span-12 lg:col-span-4">
        <p class="kicker">ROI</p>
        <h2 class="h2 mt-3">Mutabakat ve raporlama süresi neye gidiyor?</h2>
        <p class="lead mt-3">
          Örnek senaryo: Aylık banka/cari mutabakatı ve yönetim raporu hazırlayan bir işletmede, hazır yapılı dosyalarla geçen sürenin değişimi.
        </p>
        <a href="/iletisim" class="btn mt-6">Şirketinize özel hesaplama <span class="ar">→</span></a>
      </div>
      <div class="col-span-12 mt-8 lg:col-span-8 lg:mt-0">
        <table class="za">
          <tr>
            <th style="text-align:left;width:auto">Metrik</th>
            <th>Mevcut durum</th>
            <th>Excel Arşiv ile</th>
          </tr>
          {
            roiRows.map(([metric, before, after], index) => (
              <tr>
                <td style="text-align:left;width:auto">{metric}</td>
                <td class="tabular">{before}</td>
                <td>
                  {index === roiRows.length - 1 ? (
                    <span class="netv tabular">{after}</span>
                  ) : (
                    <span class="tabular">{after}</span>
                  )}
                </td>
              </tr>
            ))
          }
        </table>
      </div>
    </div>
  </section>

  <!-- C5 · Üretim süreci — 4 kolon hairline ayrım, numaralar mono -->
  <section class="border-t border-rule-hairline bg-surface-1">
    <div class="container-site grid-12 section-enter items-start">
      <div class="col-span-12 lg:col-span-4">
        <p class="kicker">ÜRETİM SÜRECİ</p>
        <h2 class="h2 mt-3">Bu dosyalar nasıl hazırlanıyor?</h2>
        <p class="lead mt-3">Her şablon aynı dört adımla üretilir; çıktısı gerçek iş verisiyle test edilmiş dosyadır.</p>
      </div>
      <ol class="col-span-12 mt-6 grid grid-cols-1 gap-px bg-rule-hairline sm:grid-cols-2 lg:col-span-8 lg:grid-cols-4">
        {
          methodology.map((item, index) => (
            <li class="relative flex flex-col bg-surface-0 p-6">
              <span aria-hidden="true" class="mono text-xl text-xl-ink-300 tabular">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="h3 mt-4">{item.title}</h3>
              <p class="body-sm mt-2 text-ink-500">{item.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- C5 · Final CTA — hero grid zemini üzerinde ortalanır -->
  <section class="hero-pattern border-t border-rule-hairline bg-surface-1">
    <div class="container-site section-enter flex flex-col items-center text-center">
      <p class="kicker">BAŞLANGIÇ</p>
      <h2 class="display">
        Bugün <em>başlayın</em>
      </h2>
      <p class="lead mt-3">
        Demo dosyayla inceleyin, beğenin, ödeyin — teslimat e-postayla. Kredi kartı bilginiz yalnızca Shopier'de işlenir.
      </p>
      <div class="cta-row">
        <a class="btn primary" href="/sablonlar">Şablonları İncele <span class="ar">→</span></a>
        <a class="btn" href="/nasil-calisir">Nasıl Çalışır <span class="dn">↓</span></a>
      </div>
      <p class="mono mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-[11px] text-xl-ink-300">
        <span><span class="cf good">VUK</span> uyumlu şablonlar</span>
        <span><span class="cf good">TFRS</span> uyumlu yapılar</span>
        <span><span class="cf warn">Shopier</span> · Güvenli Ödeme</span>
      </p>
    </div>
  </section>
</Layout>
