---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../utils/slug';

const templates = await getCollection('templates');
const featured = [...templates].sort((a, b) => b.data.priceTL - a.data.priceTL).slice(0, 6);

const categoryMeta = [
  { slug: 'finansal-analiz', name: 'Finansal Analiz', description: 'Kârlılık, oranlar ve yönetim kararları', icon: '↗' },
  { slug: 'nakit-akisi', name: 'Nakit Akışı', description: 'Ödeme, tahsilat ve nakit görünürlüğü', icon: '₺' },
  { slug: 'muhasebe-ve-vergi', name: 'Muhasebe ve Vergi', description: 'Kontrol, mutabakat ve vergi takibi', icon: '✓' },
  { slug: 'butce-ve-planlama', name: 'Bütçe ve Planlama', description: 'Hedef, senaryo ve sapma analizi', icon: '◎' },
  { slug: 'stok-ve-uretim', name: 'Stok ve Üretim', description: 'Stok maliyeti ve nakde bağlanan sermaye', icon: '▦' },
  { slug: 'satis-ve-fiyatlama', name: 'Satış ve Fiyatlama', description: 'Fiyat, komisyon ve gerçek marj kontrolü', icon: '%' },
  { slug: 'personel-ve-bordro', name: 'Personel ve Bordro', description: 'Personel maliyeti ve bordro planlama', icon: '⌁' },
].map((category) => ({
  ...category,
  count: templates.filter((template) => template.data.category === category.slug).length,
}));

const site = Astro.site ?? new URL('https://excelarsiv.com/');
const itemListLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Öne Çıkan Finansal Excel Şablonları',
  itemListElement: featured.map((template, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/sablon/${slugify(template.data.name)}`, site).href,
    item: {
      '@type': 'Product',
      name: template.data.name,
      description: template.data.summary,
      offers: {
        '@type': 'Offer',
        price: template.data.priceTL,
        priceCurrency: 'TRY',
        availability: 'https://schema.org/InStock',
      },
    },
  })),
});
---

<Layout
  mode="commerce"
  title="Hazır Finansal Excel Tabloları ve KOBİ Yönetim Sistemleri | Excel Arşiv"
  description="Nakit akışı, kasa, cari hesap, kârlılık, stok ve bütçe yönetimi için kullanıma hazır finansal Excel tabloları. Demo dosyasını inceleyin, tek seferlik ödeme ile kullanmaya başlayın."
>
  <script slot="head" type="application/ld+json" set:html={itemListLd} />

  <div class="home-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow"><span></span> Finansal kontrolü kuran hazır Excel sistemleri</div>
        <h1 id="hero-title">İşletmenizin parasını<br /><em>tek ekranda yönetin.</em></h1>
        <p class="hero-lead">
          Kasa, nakit akışı, tahsilat, kredi, stok ve gerçek kârlılık için sıfırdan dosya kurmayın.
          Formülleri hazırlanmış, kullanım alanları açıklanmış Excel sistemlerini indirin ve aynı gün çalışmaya başlayın.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#one-cikanlar">Öne Çıkan Sistemler <span>→</span></a>
          <a class="button secondary" href="/sablonlar">Tüm Şablonları Gör</a>
        </div>
        <div class="trust-row" aria-label="Satın alma avantajları">
          <span><b>✓</b> Demo dosyası</span>
          <span><b>✓</b> KDV dahil fiyat</span>
          <span><b>✓</b> Tek seferlik ödeme</span>
          <span><b>✓</b> Kullanım açıklamaları</span>
        </div>
      </div>

      <div class="hero-product" aria-label="Excel finans paneli örneği">
        <div class="product-window">
          <div class="window-bar"><span class="window-dots"><i></i><i></i><i></i></span><strong>Finans_Kontrol_Paneli.xlsx</strong><span class="saved">✓ Kaydedildi</span></div>
          <div class="sheet-tabs"><span class="active">Yönetim Paneli</span><span>Nakit Akışı</span><span>Tahsilat</span></div>
          <div class="dashboard">
            <div class="metric green"><small>GÜNCEL KASA</small><strong>₺482.600</strong><span>Son 30 gün +%12,4</span></div>
            <div class="metric"><small>BEKLEYEN TAHSİLAT</small><strong>₺168.250</strong><span>8 açık işlem</span></div>
            <div class="metric"><small>AYLIK NET KÂR</small><strong>₺94.800</strong><span>Hedefin %106'sı</span></div>
            <div class="chart-card">
              <div class="chart-head"><span>12 Haftalık Nakit Görünümü</span><b>Pozitif</b></div>
              <div class="chart" aria-hidden="true">
                <span style="--h:42%"></span><span style="--h:55%"></span><span style="--h:48%"></span><span style="--h:67%"></span><span style="--h:61%"></span><span style="--h:78%"></span><span style="--h:88%"></span><span style="--h:82%"></span>
                <svg viewBox="0 0 600 180" preserveAspectRatio="none"><polyline points="0,145 85,118 170,130 255,83 340,95 425,54 510,33 600,46" /></svg>
              </div>
              <div class="chart-labels"><span>1. Hafta</span><span>6. Hafta</span><span>12. Hafta</span></div>
            </div>
            <div class="alert-card"><span>!</span><div><strong>3 ödeme için erken uyarı</strong><small>Nakit açığı oluşmadan önce aksiyon alın.</small></div><b>İncele →</b></div>
          </div>
        </div>
        <div class="floating-proof proof-one"><strong>{templates.length}</strong><span>hazır finans sistemi</span></div>
        <div class="floating-proof proof-two"><strong>7</strong><span>iş yönetim alanı</span></div>
      </div>
    </section>

    <section class="problem-strip" aria-label="Çözülen iş problemleri">
      <div><strong>Para nerede?</strong><span>Kasa ve banka hareketlerini tek yerde görün.</span></div>
      <div><strong>Ne zaman açık vereceğim?</strong><span>Ödeme gününden önce nakit açığını fark edin.</span></div>
      <div><strong>Gerçekte ne kadar kazanıyorum?</strong><span>Gizli maliyetleri dahil ederek net kârı ölçün.</span></div>
    </section>

    <section class="section categories" aria-labelledby="categories-title">
      <div class="section-heading">
        <div><span class="section-kicker">İHTİYACA GÖRE SEÇİN</span><h2 id="categories-title">Hangi finansal sorunu çözmek istiyorsunuz?</h2></div>
        <p>Dosya adına göre değil, çözmek istediğiniz işletme problemine göre ilerleyin.</p>
      </div>
      <div class="category-grid">
        {categoryMeta.map((category) => (
          <a href={`/sablonlar/${category.slug}`} class="category-card">
            <span class="category-icon">{category.icon}</span>
            <div><h3>{category.name}</h3><p>{category.description}</p></div>
            <span class="category-count">{category.count} sistem</span>
            <span class="category-arrow">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section featured" id="one-cikanlar" aria-labelledby="featured-title">
      <div class="section-heading">
        <div><span class="section-kicker">ÖNE ÇIKAN ÇALIŞMALAR</span><h2 id="featured-title">İşletmede doğrudan kullanılan Excel sistemleri</h2></div>
        <a class="text-link" href="/sablonlar">Tümünü incele →</a>
      </div>
      <div class="product-grid">
        {featured.map((template) => {
          const t = template.data;
          return (
            <article class="product-card">
              <a class="product-preview" href={`/sablon/${slugify(t.name)}`} aria-label={`${t.name} detayını aç`}>
                <div class="preview-toolbar"><span></span><span></span><span></span><b>{t.fileFormat.toUpperCase()}</b></div>
                <div class="preview-sheet">
                  <div class="preview-kpis"><i></i><i></i><i></i></div>
                  <div class="preview-chart"><span></span><span></span><span></span><span></span><span></span><span></span></div>
                  <div class="preview-table"><i></i><i></i><i></i><i></i></div>
                </div>
                <span class="preview-category">{categoryMeta.find((category) => category.slug === t.category)?.name}</span>
              </a>
              <div class="product-content">
                <div class="product-meta"><span>{t.sheetCount} çalışma sayfası</span><span>{t.hasMacros ? 'Makrolu' : 'Makrosuz'}</span></div>
                <h3><a href={`/sablon/${slugify(t.name)}`}>{t.name}</a></h3>
                <p>{t.summary}</p>
                <ul>
                  {t.outputs.slice(0, 3).map((output) => <li>{output}</li>)}
                </ul>
                <div class="product-footer">
                  <div><small>KDV dahil</small><strong>{t.priceTL.toLocaleString('tr-TR')} TL</strong></div>
                  <a href={`/sablon/${slugify(t.name)}`}>İncele <span>→</span></a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="value-section" aria-labelledby="value-title">
      <div class="value-copy">
        <span class="section-kicker">EXCEL DOSYASI DEĞİL, ÇALIŞAN SİSTEM</span>
        <h2 id="value-title">Tabloyu değil, karar hızını satın alın.</h2>
        <p>
          Ücretsiz şablonların çoğu yalnızca veri toplar. Excel Arşiv sistemleri; girdiyi hesaplamaya,
          hesaplamayı yönetim çıktısına dönüştürmek için yapılandırılır.
        </p>
        <a class="button primary" href="/nasil-calisir">Sistem Nasıl Çalışıyor? <span>→</span></a>
      </div>
      <div class="comparison">
        <div class="comparison-head"><span>Ücretsiz / Dağınık Dosya</span><span>Excel Arşiv Sistemi</span></div>
        <div><span>Formülleri kendiniz kurarsınız</span><strong>Formüller hazır gelir</strong></div>
        <div><span>Hata kontrolü size kalır</span><strong>Girdi ve çıktı yapısı tanımlıdır</strong></div>
        <div><span>Raporu ayrıca hazırlarsınız</span><strong>Yönetim çıktıları otomatik oluşur</strong></div>
        <div><span>Nasıl kullanılacağı belirsizdir</span><strong>Demo ve kullanım açıklaması vardır</strong></div>
      </div>
    </section>

    <section class="section how" aria-labelledby="how-title">
      <div class="section-heading centered">
        <div><span class="section-kicker">3 ADIMDA KULLANIMA BAŞLAYIN</span><h2 id="how-title">Beklemeden, kurulum projesine dönüşmeden</h2></div>
      </div>
      <div class="steps">
        <article><span>01</span><h3>Demo dosyasını inceleyin</h3><p>Sayfaları, girdi alanlarını ve üretilecek çıktıları satın almadan önce görün.</p></article>
        <article><span>02</span><h3>İhtiyacınıza uygun sistemi alın</h3><p>Ürün sayfasındaki kapsam, uyumluluk ve fiyat bilgileri üzerinden karar verin.</p></article>
        <article><span>03</span><h3>Kendi verinizle çalıştırın</h3><p>Dosyayı indirin, belirtilen alanlara verilerinizi girin ve raporları kullanın.</p></article>
      </div>
    </section>

    <section class="assurance">
      <div><span class="assurance-icon">✓</span><strong>Satın almadan önce kapsam görünür</strong><p>Her üründe girdiler, çıktılar, sayfa yapısı, uyumluluk ve uygun olmayan kullanım alanları açıkça belirtilir.</p></div>
      <div><span class="assurance-icon">₺</span><strong>Fiyatlar KDV dahil gösterilir</strong><p>Sürpriz ücret olmadan, ürün sayfasında görülen toplam fiyat üzerinden satın alma kararı verirsiniz.</p></div>
      <div><span class="assurance-icon">?</span><strong>Satış sonrası iletişim kanalı</strong><p>Dosya teslimatı ve kullanım kapsamıyla ilgili sorular için iletişim sayfasından destek talebi iletebilirsiniz.</p></div>
    </section>

    <section class="final-cta">
      <div><span class="section-kicker">DAĞINIK EXCEL DOSYALARINI BIRAKIN</span><h2>Finansal kontrolü bugün kurun.</h2><p>İhtiyacınıza uygun sistemi seçin, demo dosyasını inceleyin ve kendi verinizle çalışmaya başlayın.</p></div>
      <div class="final-actions"><a class="button light" href="/sablonlar">Şablonları İncele <span>→</span></a><a class="button ghost" href="/iletisim">Doğru sistemi sor</a></div>
    </section>
  </div>
</Layout>

<style>
  .home-page { --green:#107c41; --green-dark:#0b5f34; --ink:#17221d; --muted:#65736b; --line:#dfe8e3; --soft:#eef7f2; }
  .hero { display:grid; grid-template-columns:minmax(0,1fr) minmax(480px,.95fr); gap:clamp(46px,6vw,92px); align-items:center; max-width:1240px; margin:auto; padding:clamp(72px,9vw,132px) clamp(20px,5vw,72px) 84px; }
  .eyebrow,.section-kicker { color:var(--green-dark); font-size:12px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .eyebrow { display:flex; align-items:center; gap:9px; margin-bottom:22px; }
  .eyebrow span { width:26px; height:2px; background:var(--green); }
  h1,h2,h3,p { margin-top:0; }
  h1 { max-width:720px; margin-bottom:26px; color:var(--ink); font-family:"Inter Tight",Inter,sans-serif; font-size:clamp(48px,5.8vw,78px); line-height:.97; letter-spacing:-.055em; }
  h1 em { color:var(--green); font-style:normal; }
  .hero-lead { max-width:680px; margin-bottom:30px; color:#536159; font-size:clamp(17px,1.55vw,20px); line-height:1.65; }
  .hero-actions,.final-actions { display:flex; flex-wrap:wrap; gap:12px; }
  .button { display:inline-flex; min-height:50px; align-items:center; justify-content:center; gap:20px; padding:0 20px; border:1px solid transparent; border-radius:11px; font-size:14px; font-weight:800; text-decoration:none; transition:transform .2s ease,box-shadow .2s ease,background .2s ease; }
  .button:hover { transform:translateY(-2px); }
  .button.primary { background:var(--green); color:white; box-shadow:0 12px 28px rgba(16,124,65,.2); }
  .button.secondary { border-color:#cad8d0; background:white; color:var(--ink); }
  .trust-row { display:flex; flex-wrap:wrap; gap:12px 22px; margin-top:28px; color:#536159; font-size:12px; font-weight:700; }
  .trust-row b { color:var(--green); }
  .hero-product { position:relative; }
  .product-window { overflow:hidden; border:1px solid #d9e2dd; border-radius:20px; background:white; box-shadow:0 38px 90px rgba(33,54,43,.16); transform:rotate(1deg); }
  .window-bar { display:flex; align-items:center; gap:12px; padding:13px 16px; border-bottom:1px solid #dfe8e3; background:#f7f9f8; color:#48554e; font-size:11px; }
  .window-bar strong { flex:1; text-align:center; font-weight:700; }
  .window-dots { display:flex; gap:5px; }.window-dots i{width:8px;height:8px;border-radius:50%;background:#ccd6d1}.window-dots i:first-child{background:#ef9b92}.window-dots i:nth-child(2){background:#edc86f}.window-dots i:last-child{background:#75c28e}
  .saved { color:var(--green); font-weight:700; }
  .sheet-tabs { display:flex; gap:6px; padding:10px 16px 0; border-bottom:1px solid #e3ebe7; background:#fbfcfb; font-size:10px; font-weight:700; }
  .sheet-tabs span { padding:9px 12px; color:#77847d; }.sheet-tabs .active{border-bottom:2px solid var(--green);color:var(--green)}
  .dashboard { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; padding:18px; background:linear-gradient(180deg,#fff,#f7faf8); }
  .metric { display:grid; gap:6px; padding:15px; border:1px solid #e0e8e4; border-radius:12px; background:white; }.metric.green{background:#eef8f2;border-color:#cde7d8}.metric small{color:#7a8780;font-size:8px;font-weight:800;letter-spacing:.09em}.metric strong{color:#233129;font-size:20px;letter-spacing:-.04em}.metric span{color:#6e7c74;font-size:9px}.metric.green strong,.metric.green span{color:#0b6638}
  .chart-card { grid-column:1/-1; padding:16px; border:1px solid #e0e8e4; border-radius:12px; background:white; }.chart-head{display:flex;justify-content:space-between;color:#536159;font-size:10px;font-weight:800}.chart-head b{color:var(--green)}
  .chart { position:relative; display:flex; height:150px; align-items:flex-end; gap:8px; margin-top:12px; padding:12px 4px 0; border-bottom:1px solid #dfe8e3; background:repeating-linear-gradient(to bottom,#fff 0,#fff 35px,#eef2f0 36px); }.chart>span{z-index:1;flex:1;height:var(--h);border-radius:4px 4px 0 0;background:linear-gradient(180deg,#b5ddc5,#dceee3)}.chart svg{position:absolute;inset:12px 4px 0;width:calc(100% - 8px);height:calc(100% - 12px);z-index:2}.chart polyline{fill:none;stroke:var(--green);stroke-width:4;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke}.chart-labels{display:flex;justify-content:space-between;margin-top:8px;color:#849089;font-size:8px}
  .alert-card { grid-column:1/-1; display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:12px; padding:12px 14px; border-radius:10px; background:#fff7df; color:#785a00; }.alert-card>span{display:grid;width:24px;height:24px;place-items:center;border-radius:50%;background:#f3ca52;font-weight:900}.alert-card div{display:grid;gap:2px}.alert-card strong{font-size:10px}.alert-card small{font-size:8px}.alert-card>b{font-size:9px}
  .floating-proof { position:absolute; display:grid; min-width:116px; gap:2px; padding:13px 15px; border:1px solid #d8e2dc; border-radius:12px; background:rgba(255,255,255,.94); box-shadow:0 18px 40px rgba(33,54,43,.12); backdrop-filter:blur(12px); }.floating-proof strong{color:var(--green);font-size:24px}.floating-proof span{color:#65736b;font-size:10px;font-weight:700}.proof-one{left:-34px;bottom:32px}.proof-two{right:-25px;top:42px}
  .problem-strip { display:grid; grid-template-columns:repeat(3,1fr); max-width:1240px; margin:0 auto; border:1px solid #dce6e0; border-radius:18px; background:white; box-shadow:0 16px 40px rgba(33,54,43,.06); }.problem-strip div{display:grid;gap:7px;padding:25px 28px}.problem-strip div+div{border-left:1px solid #e3ebe7}.problem-strip strong{color:var(--ink);font-size:15px}.problem-strip span{color:var(--muted);font-size:13px;line-height:1.5}
  .section { max-width:1240px; margin:auto; padding:112px clamp(20px,5vw,72px); }.section-heading{display:flex;align-items:end;justify-content:space-between;gap:36px;margin-bottom:38px}.section-heading>div{max-width:760px}.section-heading h2,.value-copy h2,.final-cta h2{margin:10px 0 0;color:var(--ink);font-family:"Inter Tight",Inter,sans-serif;font-size:clamp(34px,4vw,52px);line-height:1.04;letter-spacing:-.045em}.section-heading>p{max-width:390px;margin-bottom:4px;color:var(--muted);line-height:1.65}.text-link{color:var(--green-dark);font-weight:800;text-decoration:none;white-space:nowrap}
  .category-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; }.category-card{position:relative;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:16px;min-height:112px;padding:22px 24px;border:1px solid #dce6e0;border-radius:15px;background:white;color:var(--ink);text-decoration:none;transition:transform .2s,border-color .2s,box-shadow .2s}.category-card:hover{transform:translateY(-3px);border-color:#91c6a8;box-shadow:0 15px 32px rgba(33,54,43,.08)}.category-icon{display:grid;width:48px;height:48px;place-items:center;border-radius:12px;background:var(--soft);color:var(--green);font-size:20px;font-weight:900}.category-card h3{margin-bottom:5px;font-size:16px}.category-card p{margin:0;color:var(--muted);font-size:12px}.category-count{align-self:start;padding:5px 8px;border-radius:999px;background:#f1f5f3;color:#65736b;font-size:9px;font-weight:800}.category-arrow{position:absolute;right:24px;bottom:18px;color:var(--green);font-weight:900}
