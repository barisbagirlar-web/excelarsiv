---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import TrustStrip from '../components/home/TrustStrip.astro';
import PremiumFeaturedTemplates from '../components/home/PremiumFeaturedTemplates.astro';
import CommandCenter from '../components/home/CommandCenter.astro';
import ProofGallery from '../components/home/ProofGallery.astro';
import CategorySection from '../components/home/CategorySection.astro';
import GainSection from '../components/home/GainSection.astro';
import MoatStrip from '../components/home/MoatStrip.astro';
import PurchaseProcess from '../components/home/PurchaseProcess.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
import ExperienceRail from '../components/home/ExperienceRail.astro';
import { getAllTemplates, getTemplateSearchIndex } from '../lib/templates';

const allTemplates = await getAllTemplates();
const coreFeaturedTemplates = allTemplates.slice(0, 6);
const demandPickSlug = 'cari-hesap-tahsilat-ve-musteri-risk-takip-sistemi';
const demandPick = allTemplates.find((template) => template.slug === demandPickSlug);
const featuredTemplates = demandPick && !coreFeaturedTemplates.some((template) => template.slug === demandPickSlug)
  ? [...coreFeaturedTemplates, demandPick]
  : coreFeaturedTemplates;
const searchIndex = await getTemplateSearchIndex();
const homeItemListLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': new URL('/#itemlist', Astro.site).toString(),
  numberOfItems: featuredTemplates.length,
  itemListElement: featuredTemplates.map((template, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/sablon/${template.slug}`, Astro.site).toString(),
    name: template.name,
  })),
});
---

<CommerceLayout
  title="Excel Şablonları ve Finans Yönetim Sistemleri | Excel Arşiv"
  description="KOBİ'ler için kasa defteri, nakit akış tablosu, cari hesap, stok takip, kârlılık ve maliyet hesaplama Excel şablonları. Gerçek ekranları ve demoları inceleyin."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={homeItemListLd} />
  </Fragment>
  <HeroSection searchIndex={searchIndex} />
  <TrustStrip />
  <ExperienceRail />

  <div id="urunler" data-experience-stage>
    <PremiumFeaturedTemplates templates={featuredTemplates} />
  </div>

  <div id="sistem" data-experience-stage data-mobile-deferred-rich>
    <CommandCenter />
  </div>

  <div id="kanit" data-experience-stage data-mobile-deferred-rich>
    <ProofGallery />
  </div>

  <div id="kategoriler" data-experience-stage>
    <CategorySection />
  </div>

  <div id="deger" data-experience-stage data-mobile-deferred-rich>
    <GainSection />
  </div>

  <div id="moat" data-experience-stage>
    <MoatStrip />
  </div>

  <div id="satin-alma" data-experience-stage>
    <div data-mobile-deferred-rich>
      <PurchaseProcess />
    </div>
    <FinalCTA />
  </div>
</CommerceLayout>

<style>
  [data-experience-stage] {
    scroll-margin-top: 92px;
    content-visibility: auto;
    contain-intrinsic-size: auto 760px;
  }

  @media (max-width: 720px) {
    [data-mobile-deferred-rich] {
      display: none;
    }
  }
</style>
