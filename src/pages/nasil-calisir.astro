---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';

const steps = [
  {
    title: 'Satın alma',
    description: 'Ürün sayfasında e-posta adresinizi girip “Satın Al — Shopier ile öde” düğmesine basarsınız. ExcelArşiv seçtiğiniz gerçek ürünü ödeme oturumuna bağlar ve Shopier güvenli ödeme ekranını açar.',
  },
  {
    title: 'Ödeme doğrulama',
    description: 'Kart bilgileri ExcelArşiv’de tutulmaz. Ödeme Shopier’de tamamlandıktan sonra ExcelArşiv sipariş kaydını ürün seviyesi, tutar ve e-posta bilgileriyle sunucu tarafında doğrular.',
  },
  {
    title: 'Teslimat',
    description: 'Ödeme doğrulandığında ürün sayfasındaki “Excel’i İndir” düğmesi açılır. Aynı satın alma kaydına /teslimat ekranından da erişebilir ve dosyayı doğrudan bilgisayarınıza indirebilirsiniz.',
  },
  {
    title: 'Lisans ve güncelleme',
    description: 'Tek lisans tek kullanıcı içindir. Güncelleme koşulları ürün sayfasında belirtilir; yeni satış sürümleri satın alma kaydına bağlı olarak güvenli teslim edilir.',
  },
];

const howToLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Excel Arşiv şablonu satın alma ve güvenli indirme',
  step: steps.map((step, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: step.title,
    text: step.description,
  })),
});
---

<CommerceLayout
  title="Nasıl Çalışır — Excel Arşiv"
  description="Excel şablonunu seçme, Shopier ile ödeme, ödeme doğrulama ve ExcelArşiv üzerinden güvenli indirme adımları."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={howToLd} />
  </Fragment>
  <section class="mx-auto max-w-3xl px-4 pb-24 pt-8">
    <SectionLabel address="A1" label="Akış" />
    <h1 class="display mt-6">Nasıl çalışır</h1>
    <p class="lead mt-6 max-w-xl">
      Ürünü seçersiniz, Shopier’de ödersiniz, ödeme doğrulanır ve Excel dosyanızı ExcelArşiv’den indirirsiniz.
    </p>
    <ol class="mt-10 space-y-8">
      {
        steps.map((step, index) => (
          <li class="border-l border-rule-strong pl-6">
            <p class="font-mono text-sm text-accent-primary">ADIM {String(index + 1).padStart(2, '0')}</p>
            <h2 class="h3 mt-2">{step.title}</h2>
            <p class="body-sm mt-2">{step.description}</p>
          </li>
        ))
      }
    </ol>
    <div class="mt-12 border-t border-rule-hairline pt-8">
      <Button href="/sablonlar">Şablonları İncele</Button>
    </div>
  </section>
</CommerceLayout>
