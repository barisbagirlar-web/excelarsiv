---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import CatalogSearch from '../components/catalog/CatalogSearch.astro';
import CatalogFilters from '../components/catalog/CatalogFilters.astro';
import TemplateGrid from '../components/catalog/TemplateGrid.astro';
import { categories } from '../lib/categories';
import { getAllTemplates } from '../lib/templates';

const templates = await getAllTemplates();
const minPriceTL = templates.length > 0 ? Math.min(...templates.map((template) => template.priceTL)) : undefined;
const categoryCounts = Object.fromEntries(
  categories.map((category) => [
    category.slug,
    templates.filter((template) => template.categorySlug === category.slug).length,
  ]),
);
const catalogLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': new URL('/sablonlar#itemlist', Astro.site).toString(),
  numberOfItems: templates.length,
  itemListElement: templates.map((template, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/sablon/${template.slug}`, Astro.site).toString(),
    name: template.name,
  })),
});
const catalogPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': new URL('/sablonlar#collection', Astro.site).toString(),
  url: new URL('/sablonlar', Astro.site).toString(),
  name: 'Excel Şablonları ve İşletme Karar Sistemleri',
  inLanguage: 'tr-TR',
  isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
  mainEntity: { '@id': new URL('/sablonlar#itemlist', Astro.site).toString() },
});
const catalogBreadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Excel Şablonları', item: new URL('/sablonlar', Astro.site).toString() },
  ],
});
---

<CommerceLayout
  title="Excel Şablonları ve İşletme Karar Sistemleri — Excel Arşiv"
  description="Nakit akışı, kârlılık, tahsilat, stok ve finans yönetimi için hazır Excel sistemleri. Ürünleri karşılaştırın, filtreleyin ve demo ile inceleyin."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={catalogLd} />
    <script type="application/ld+json" set:html={catalogPageLd} />
    <script type="application/ld+json" set:html={catalogBreadcrumbLd} />
  </Fragment>
  <section class="catalog-intro" aria-labelledby="catalog-title">
    <div class="site-container catalog-intro__inner">
      <div class="catalog-intro__copy">
        <span>EXCEL ARŞİV · İŞLETME SİSTEMLERİ</span>
        <h1 id="catalog-title">Excel Şablonları</h1>
        <p>Finans, nakit, tahsilat, stok ve operasyon için kullanıma hazır Excel karar sistemleri.</p>
      </div>

      <div class="catalog-intro__proof" aria-label="Katalog güvenceleri">
        <div><b>{templates.length}</b><span>satışta sistem</span></div>
        <div><b>{categories.length}</b><span>işletme alanı</span></div>
        {minPriceTL && <div><b>{minPriceTL.toLocaleString('tr-TR')} TL</b><span>başlayan fiyat</span></div>}
        <div class="catalog-intro__trust"><i>✓</i><span>Demo + gerçek ürün ekranları</span></div>
      </div>
    </div>
  </section>

  <section id="katalog" class="catalog-section" aria-labelledby="catalog-list-title">
    <div class="site-container">
      <div class="catalog-command">
        <div class="catalog-command__head">
          <div>
            <span class="catalog-command__eyebrow">ÜRÜNLER</span>
            <h2 id="catalog-list-title">İhtiyacınıza uygun sistemi bulun.</h2>
          </div>
          <p class="catalog-command__result" aria-live="polite"><strong data-result-count>{templates.length}</strong> ürün</p>
        </div>

        <div class="catalog-command__search">
          <CatalogSearch />
        </div>

        <div class="catalog-command__filters">
          <CatalogFilters counts={categoryCounts} totalCount={templates.length} />
          <button type="button" class="catalog-command__clear" data-catalog-clear hidden>Filtreleri temizle</button>
        </div>
      </div>

      <TemplateGrid templates={templates} />

      <aside class="catalog-help" aria-label="Satın alma güvenceleri">
        <div class="catalog-help__item"><span>01</span><div><strong>Gerçek Excel ekran görüntüsü</strong><p>Her kart, ürünün kendi çalışma dosyasından alınmış ekranı 4:3 çerçevede gösterir.</p></div></div>
        <div class="catalog-help__item"><span>02</span><div><strong>Detayda gerçek Excel ekranları</strong><p>Ürün sayfasında gerçek çalışma ekranlarını ve demo akışını ayrıca inceleyebilirsiniz.</p></div></div>
        <div class="catalog-help__item"><span>03</span><div><strong>Shopier ile güvenli ödeme</strong><p>Fiyat, teslimat ve ödeme adımları ürün sayfasında açık biçimde gösterilir.</p></div></div>
      </aside>
    </div>
  </section>
</CommerceLayout>

<style>
  .catalog-intro {
    border-bottom: 1px solid var(--xl-grid);
    background:
      radial-gradient(720px 220px at 84% 0%, rgba(16,124,65,.08), transparent 72%),
      #fff;
  }
  .catalog-intro__inner {
    display: grid;
    grid-template-columns: minmax(0,1fr) auto;
    gap: 36px;
    align-items: end;
    padding-block: clamp(26px,4vw,42px) 24px;
  }
  .catalog-intro__copy > span,
  .catalog-command__eyebrow {
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: .1em;
    color: var(--xl-green-dark);
  }
  .catalog-intro h1 {
    margin: 7px 0 0;
    font-family: var(--font-display);
    font-size: clamp(30px,4vw,44px);
    line-height: 1;
    letter-spacing: -.035em;
    color: var(--xl-ink-900);
  }
  .catalog-intro__copy p {
    max-width: 720px;
    margin: 10px 0 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--xl-ink-3);
  }
  .catalog-intro__proof {
    display: flex;
    align-items: stretch;
    gap: 0;
    border: 1px solid var(--xl-grid);
    border-radius: 14px;
    background: rgba(255,255,255,.9);
    overflow: hidden;
  }
  .catalog-intro__proof > div {
    display: grid;
    align-content: center;
    min-width: 112px;
    min-height: 58px;
    padding: 9px 14px;
    border-right: 1px solid var(--xl-grid);
  }
  .catalog-intro__proof > div:last-child { border-right: 0; }
  .catalog-intro__proof b { font: 800 13px var(--font-mono); color: var(--xl-ink-900); }
  .catalog-intro__proof span { margin-top: 3px; font-size: 8.5px; color: var(--xl-ink-3); }
  .catalog-intro__proof .catalog-intro__trust {
    grid-template-columns: 18px 1fr;
    gap: 7px;
    align-items: center;
    min-width: 170px;
  }
  .catalog-intro__trust i {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 6px;
    background: #e3f3e9;
    color: var(--xl-green-dark);
    font-size: 10px;
    font-style: normal;
    font-weight: 800;
  }
  .catalog-intro__trust span { margin: 0; line-height: 1.35; }

  .catalog-section {
    padding-block: 26px clamp(72px,8vw,104px);
    background:
      linear-gradient(rgba(16,124,65,.018) 1px,transparent 1px),
      linear-gradient(90deg,rgba(16,124,65,.018) 1px,transparent 1px),
      #fbfcfb;
    background-size: 30px 30px;
  }
  .catalog-command {
    padding: 18px;
    border: 1px solid var(--xl-border);
    border-radius: 18px;
    background: rgba(255,255,255,.96);
    box-shadow: 0 12px 34px rgba(20,54,35,.055);
  }
  .catalog-command__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 14px;
  }
  .catalog-command__head h2 {
    margin: 5px 0 0;
    font-family: var(--font-display);
    font-size: clamp(21px,2.4vw,29px);
    line-height: 1.05;
    letter-spacing: -.03em;
    color: var(--xl-ink-900);
  }
  .catalog-command__result {
    flex: 0 0 auto;
    margin: 0;
    padding: 7px 10px;
    border: 1px solid var(--xl-grid);
    border-radius: 999px;
    background: var(--xl-paper);
    font: 700 9px var(--font-mono);
    color: var(--xl-ink-3);
  }
  .catalog-command__result strong { color: var(--xl-ink-900); }
  .catalog-command__search { max-width: 760px; }
  .catalog-command__filters {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-top: 12px;
  }
  .catalog-command__clear {
    flex: 0 0 auto;
    min-height: 36px;
    padding: 0 10px;
    border: 0;
    background: transparent;
    font: 700 9px var(--font-mono);
    color: var(--xl-green-dark);
    cursor: pointer;
  }
  .catalog-command__clear:hover { text-decoration: underline; }
  .catalog-section > .site-container > :global(.template-grid-wrap) { margin-top: 20px; }

  .catalog-help {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 1px;
    margin-top: 28px;
    overflow: hidden;
    border: 1px solid var(--xl-grid);
    border-radius: 18px;
    background: var(--xl-grid);
  }
  .catalog-help__item {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 10px;
    padding: 18px;
    background: #fff;
  }
  .catalog-help__item > span {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 9px;
    background: #e7f4ec;
    font: 800 8px var(--font-mono);
    color: var(--xl-green-dark);
  }
  .catalog-help__item strong { display:block; font-size: 11px; color: var(--xl-ink-900); }
  .catalog-help__item p { margin: 5px 0 0; font-size: 9.5px; line-height: 1.5; color: var(--xl-ink-3); }

  @media(max-width:1050px) {
    .catalog-intro__inner { grid-template-columns: 1fr; gap: 16px; }
    .catalog-intro__proof { width: 100%; }
    .catalog-intro__proof > div { flex: 1; }
  }
  @media(max-width:780px) {
    .catalog-intro__proof { display:grid; grid-template-columns:repeat(2,1fr); }
    .catalog-intro__proof > div { min-width:0; border-bottom:1px solid var(--xl-grid); }
    .catalog-intro__proof > div:nth-child(2n) { border-right:0; }
    .catalog-intro__proof > div:nth-last-child(-n+2) { border-bottom:0; }
    .catalog-help { grid-template-columns:1fr; }
    .catalog-command__head { align-items:flex-start; }
  }
  @media(max-width:620px) {
    .catalog-intro__inner { padding-block:22px 18px; }
    .catalog-intro h1 { font-size:32px; }
    .catalog-intro__proof { display:none; }
    .catalog-section { padding-top:16px; }
    .catalog-command { padding:14px; border-radius:16px; }
    .catalog-command__head { gap:12px; }
    .catalog-command__head h2 { font-size:22px; }
    .catalog-command__filters { display:block; overflow:hidden; }
    .catalog-command__clear { margin-top:6px; }
  }
</style>
