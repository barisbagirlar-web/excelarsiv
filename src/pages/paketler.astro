---
import { getCollection } from 'astro:content';
import CommerceLayout from '../layouts/CommerceLayout.astro';

const templates = await getCollection('templates');
const packageEntry = templates.find((entry) => entry.id === 'kobi-finans-yonetim-paketi');
const packagePrice = packageEntry?.data.priceTL.toLocaleString('tr-TR') ?? '7.900';
const packageHref = packageEntry ? `/sablon/${packageEntry.id}` : '/sablonlar';
const demoHref = packageEntry?.data.demoFile ?? '/sablonlar';

const moduleSlugs = [
  'akilli-kasa-defteri-ve-nakit-kontrol-sistemi',
  '13-haftalik-nakit-akisi-ve-odeme-planlama-sistemi',
  'cari-hesap-tahsilat-ve-musteri-risk-takip-sistemi',
  'banka-kredi-ve-taksit-takip-sistemi',
  'cek-senet-ve-vade-risk-sistemi',
  'vergi-sgk-ve-maas-karsilik-ayirma-sistemi',
  'aylik-patron-finans-paneli',
];

const modules = moduleSlugs.map((slug, index) => {
  const entry = templates.find((t) => t.id === slug);
  return {
    code: String(index + 1).padStart(2, '0'),
    slug,
    name: entry?.data.name ?? '',
    summary: entry?.data.summary ?? '',
    outputs: entry?.data.outputs.slice(0, 3) ?? [],
    priceTL: entry?.data.priceTL ?? 0,
    url: entry ? `/sablon/${entry.id}` : '/sablonlar',
  };
});

const individualTotal = modules.reduce((sum, module) => sum + module.priceTL, 0);
const individualTotalText = individualTotal.toLocaleString('tr-TR');
const savings = (individualTotal - (packageEntry?.data.priceTL ?? 0)).toLocaleString('tr-TR');

const faq = [
  {
    question: 'Bu paket kimler için uygundur?',
    answer: "Finans süreçlerini tek pakette toplamak isteyen KOBİ'ler, aylık yönetim toplantısı için özet arayanlar ve bireysel sistemleri paket fiyatına almak isteyenler için. Tek bir işi çözmek isteyenler için bireysel sistemler daha uygundur.",
  },
  {
    question: 'İçindeki sistemler ayrı ayrı da kullanılabilir mi?',
    answer: 'Evet. Paketteki her sistem bağımsız çalışır; paketin avantajı aynı kullanım mantığı ve konsolide aylık yönetim özeti üretmesidir.',
  },
  {
    question: 'Dosyalar hemen teslim edilir mi?',
    answer: 'Ödeme Shopier onayından sonra indirme bağlantısı satın alma e-postanıza gönderilir.',
  },
  {
    question: 'Satın almadan önce demo görebilir miyim?',
    answer: 'Evet. Demo dosyası satın almadan önce incelenebilir; sayfadaki demo bağlantısından indirilir.',
  },
  {
    question: 'Ek ücret veya abonelik var mı?',
    answer: 'Hayır. Fiyat KDV dahil tek seferlik ödemedir; abonelik yoktur. Mevzuat değişikliği olursa güncel sürüm satın alma döneminden itibaren 12 ay ücretsiz sunulur.',
  },
  {
    question: 'Mac / Windows / Excel sürümü uyumu nasıl?',
    answer: 'Excel 2016 ve üzeri gerekir; Mac uyumludur. Kullanılan işlevler standart Excel işlevleridir.',
  },
  {
    question: 'Google Sheets ile çalışır mı?',
    answer: 'Evet, paket Google Sheets ile tam uyumludur. Kullanılan işlevler standart Excel işlevleridir; Excel üzerinde tam uyumlu çalışır.',
  },
];
---

<CommerceLayout
  title="KOBİ Finans Yönetim Paketi | Excel Arşiv"
  description="Kasa, nakit akışı, cari hesap, banka, çek-senet, dönem sonu ve yönetim raporlamasını aynı Excel sistem ailesinde birleştiren KOBİ Finans Yönetim Paketi."
>
  <section class="pkg-hero">
    <div class="site-container pkg-hero__inner">
      <div class="pkg-hero__copy">
        <span class="pkg-kicker">KOBİ FİNANS YÖNETİM PAKETİ</span>
        <h1>Tek tek dosya toplamayın, <em>işletmenize hazır kurulmuş finans sistemi</em> alın.</h1>
        <p>Kasa, nakit akışı, cari hesap, tahsilat, finans paneli ve raporlama ihtiyaçlarını tek pakette toplayan, hemen kullanılabilir hazır Excel sistemleri.</p>
        <div class="pkg-price"><strong>{packagePrice} TL</strong><span>KDV dahil · tek ödeme · kalıcı kullanım</span></div>
        <div class="pkg-hero__actions">
          <a href={packageHref} class="pkg-btn pkg-btn--primary">Paketi İncele <span aria-hidden="true">→</span></a>
          <a href="#paket-icerigi" class="pkg-btn pkg-btn--secondary">İçindeki Sistemleri Gör</a>
        </div>
        <ul class="pkg-chips">
          <li>7 sistem</li>
          <li>KDV dahil</li>
          <li>Tek seferlik ödeme</li>
          <li>E-posta ile teslim</li>
          <li>Demo incelenebilir</li>
        </ul>
      </div>

      <div class="pkg-hero__visual" aria-hidden="true">
        <div class="pkg-window">
          <div class="pkg-window__top"><i></i><i></i><i></i><b>KOBI_Finans_Yonetim.xlsx</b><span>CANLI</span></div>
          <div class="pkg-window__tabs"><strong>Yönetim</strong><span>Nakit</span><span>Cari</span><span>Banka</span><span>Risk</span></div>
          <div class="pkg-window__metrics"><div><small>Nakit</small><b>₺1,25M</b><em>▲ %12</em></div><div><small>Net kâr</small><b>₺415K</b><em>▲ %8</em></div><div><small>Tahsilat</small><b>%92</b><em>▲ %4</em></div></div>
          <div class="pkg-window__body">
            <svg viewBox="0 0 420 150" preserveAspectRatio="none"><path d="M0 126 L52 115 L104 119 L156 89 L208 98 L260 68 L312 76 L364 42 L420 25 L420 150 L0 150 Z" fill="rgba(16,124,65,.09)"/><polyline points="0,126 52,115 104,119 156,89 208,98 260,68 312,76 364,42 420,25" fill="none" stroke="#16864b" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <div class="pkg-window__risk"><span><b>Nakit tamponu</b><em>Güçlü</em></span><span><b>Tahsilat</b><em>%92</em></span><span><b>Vade baskısı</b><em>İzle</em></span></div>
          </div>
        </div>
        <div class="pkg-float pkg-float--one"><small>7 sistem</small><strong>Tek aile</strong></div>
        <div class="pkg-float pkg-float--two"><small>Tek ödeme</small><strong>{packagePrice} TL</strong></div>
      </div>
    </div>
  </section>

  <section class="pkg-fit">
    <div class="site-container">
      <div class="pkg-sec-head">
        <div><span class="pkg-kicker">BU PAKET KİM İÇİN?</span><h2>Finansı dağınık dosyalarla değil, tek düzenle yönetmek isteyenler için.</h2></div>
      </div>
      <div class="pkg-fit__grid">
        <article><b>KOBİ sahipleri</b><p>Finansı dağınık değil, tek merkezden görmek isteyenler.</p></article>
        <article><b>Muhasebe / finans sorumluları</b><p>Tekrar eden takibi düzenli hale getirmek isteyenler.</p></article>
        <article><b>Yönetici / patron</b><p>Kâr, nakit ve tahsilatı hızlı görmek isteyenler.</p></article>
        <article><b>Excel'i sıfırdan kurmak istemeyenler</b><p>Zaman kaybetmeden hazır yapı isteyenler.</p></article>
      </div>
    </div>
  </section>

  <section id="paket-icerigi" class="pkg-modules">
    <div class="site-container">
      <div class="pkg-sec-head">
        <div><span class="pkg-kicker">PAKETİN İÇİNDE NE VAR?</span><h2>Birlikte çalışan 7 hazır sistem.</h2></div>
        <p>Her sistem ayrı bir finans işini çözer; paket bu sistemleri aynı kullanım mantığı altında birleştirir.</p>
      </div>

      <article class="pkg-mod pkg-mod--featured">
        <div class="pkg-mod__copy">
          <span class="pkg-mod__code">{modules[0].code}</span>
          <h3>{modules[0].name}</h3>
          <p>{modules[0].summary}</p>
          <ul>{modules[0].outputs.map((output) => <li>✓ {output}</li>)}</ul>
        </div>
        <div class="pkg-mod__side">
          <span class="pkg-mod__label">Paket kapsamında</span>
          <strong class="pkg-mod__price">{modules[0].priceTL.toLocaleString('tr-TR')} TL</strong>
          <a href={modules[0].url}>İncele <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <div class="pkg-mod__grid">
        {modules.slice(1, 3).map((module) => (
          <article class="pkg-mod pkg-mod--medium">
            <div class="pkg-mod__copy">
              <span class="pkg-mod__code">{module.code}</span>
              <h3>{module.name}</h3>
              <p>{module.summary}</p>
            </div>
            <div class="pkg-mod__side">
              <strong class="pkg-mod__price">{module.priceTL.toLocaleString('tr-TR')} TL</strong>
              <a href={module.url}>İncele <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>

      <div class="pkg-mod__row">
        {modules.slice(3).map((module) => (
          <article class="pkg-mod pkg-mod--compact">
            <span class="pkg-mod__code">{module.code}</span>
            <h3>{module.name}</h3>
            <p>{module.summary}</p>
            <div class="pkg-mod__side"><strong class="pkg-mod__price">{module.priceTL.toLocaleString('tr-TR')} TL</strong><a href={module.url} aria-label="{module.name} sayfasını incele">İncele <span aria-hidden="true">→</span></a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pkg-why">
    <div class="site-container pkg-why__inner">
      <div class="pkg-why__copy">
        <span class="pkg-kicker">NEDEN PAKET?</span>
        <h2>Tek tek dosya almak yerine neden paket?</h2>
        <p>Tek tek alındığında her dosya farklı yapıda, dağınık ve yeniden kurulum gerektirir. Pakette tek karar verir, birlikte çalışan sistemlerin tamamını alırsınız.</p>
        <div class="pkg-why__math">
          <div><span>Tek tek toplam</span><s>{individualTotalText} TL</s></div>
          <div><span>Paket</span><strong>{packagePrice} TL</strong></div>
          <div class="pkg-why__save"><span>Fark</span><strong>{savings} TL tasarruf</strong></div>
        </div>
      </div>
      <div class="pkg-why__table">
        <div class="pkg-why__row is-head"><span>Kriter</span><b>Tek Tek Alım</b><b>Paket</b></div>
        <div class="pkg-why__row"><span>Karar süreci</span><b>Her ürün için ayrı</b><em>Tek karar</em></div>
        <div class="pkg-why__row"><span>Kurulum mantığı</span><b>Parça parça</b><em>Bütünsel</em></div>
        <div class="pkg-why__row"><span>Kullanım uyumu</span><b>Değişken</b><em>Daha tutarlı</em></div>
        <div class="pkg-why__row"><span>Zaman maliyeti</span><b>Yüksek</b><em>Daha düşük</em></div>
        <div class="pkg-why__row"><span>Toplam değer</span><b>Dağınık</b><em>Toplu</em></div>
      </div>
    </div>
  </section>

  <section class="pkg-manifest">
    <div class="site-container">
      <span class="pkg-kicker">DEĞER NEREDE OLUŞUYOR?</span>
      <h2>Bir Excel dosyasına değil, <em>tekrar kurmayacağınız düzene</em> ödeme yaparsınız.</h2>
      <p class="pkg-manifest__lead">Asıl değer yalnızca tabloda değil; kurgu, formül mantığı, kullanım akışı, görünürlük, kontrol, test ve teslim bütününde oluşur.</p>
      <div class="pkg-manifest__grid">
        <div><b>01</b><strong>Model mantığı</strong><p>Standart giriş–hesap–çıktı kurgusu, her sistemde aynı dilde çalışır.</p></div>
        <div><b>02</b><strong>Hızlı kullanım</strong><p>Kurulum aşamaları hazır geldiği için ilk günden veri girişine başlarsınız.</p></div>
        <div><b>03</b><strong>Kontrol görünürlüğü</strong><p>Kritik göstergeler aynı panelde toplanır; karar verilebilir hale gelir.</p></div>
        <div><b>04</b><strong>Tekrar kurmama</strong><p>Her dönem aynı modeli yeniden oluşturmaz, süreklilik kazanırsınız.</p></div>
      </div>
    </div>
  </section>

  <section class="pkg-steps">
    <div class="site-container">
      <div class="pkg-sec-head">
        <div><span class="pkg-kicker">SATIN ALMA DENEYİMİ</span><h2>Karar zor olabilir; satın alma süreci değil.</h2></div>
      </div>
      <ol class="pkg-steps__list">
        <li><b>01</b><strong>Demo ile görün</strong><p>Satın almadan önce demo dosyasını inceleyin.</p></li>
        <li><b>02</b><strong>Shopier ile güvenli ödeyin</strong><p>Ödeme Shopier altyapısında işlenir.</p></li>
        <li><b>03</b><strong>E-posta ile teslim alın</strong><p>Ödeme onayından sonra bağlantı e-postanıza gelir.</p></li>
        <li><b>04</b><strong>Hemen kullanmaya başlayın</strong><p>Veri girişine başlayın, özetleri aynı gün görün.</p></li>
      </ol>
    </div>
  </section>

  <section class="pkg-trust">
    <div class="site-container">
      <div class="pkg-sec-head">
        <div><span class="pkg-kicker">GÜVENCE</span><h2>Satın almadan önce bilmeniz gerekenler.</h2></div>
      </div>
      <div class="pkg-trust__grid">
        <div><b>KDV</b><strong>KDV dahil fiyat</strong><p>Sürpriz ek maliyet yok; fiyatın tamamı tek tutardır.</p></div>
        <div><b>Ödeme</b><strong>Tek seferlik ödeme</strong><p>Abonelik yok; bir kez öde, kalıcı kullan.</p></div>
        <div><b>Teslim</b><strong>E-posta ile dijital teslimat</strong><p>Ödeme onayından sonra bağlantı e-postanıza gelir.</p></div>
        <div><b>Demo</b><strong>Demo incelenebilir</strong><p>Karar vermeden önce dosyayı birebir inceleyin.</p></div>
      </div>
    </div>
  </section>

  <section class="pkg-offer">
    <div class="site-container">
      <div class="pkg-offer__card">
        <div class="pkg-offer__left">
          <span class="pkg-kicker">KOBİ FİNANS YÖNETİM PAKETİ</span>
          <h2>7 hazır sistem, tek karar.</h2>
          <p>Kasa, nakit akışı, cari hesap, banka, vade riski, karşılık ve patron panelini aynı çalışma düzeninde toplayan konsolide yönetim modeli.</p>
          <ul>
            <li>7 sistem tek pakette</li>
            <li>KOBİ sahipleri ve finans sorumluları için</li>
            <li>KDV dahil · tek ödeme · kalıcı kullanım</li>
            <li>E-posta ile dijital teslimat</li>
          </ul>
        </div>
        <div class="pkg-offer__right">
          <span class="pkg-offer__from">Tek tek alınsaydı {individualTotalText} TL</span>
          <strong class="pkg-offer__price">{packagePrice} <small>TL</small></strong>
          <span class="pkg-offer__note">KDV dahil · tek ödeme</span>
          <a href={packageHref} class="pkg-btn pkg-btn--primary">Paketi Satın Al <span aria-hidden="true">→</span></a>
          <a href={demoHref} class="pkg-offer__demo">Önce Demo İncele</a>
          <p class="pkg-offer__micro">Kart bilgisi sitede tutulmaz · Shopier ile ödeme · teslimat e-posta ile</p>
        </div>
      </div>
    </div>
  </section>

  <section class="pkg-faq">
    <div class="site-container">
      <div class="pkg-sec-head">
        <div><span class="pkg-kicker">SSS</span><h2>Sık sorulan sorular.</h2></div>
      </div>
      <div class="pkg-faq__list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <div class="pkg-sticky">
    <div><strong>{packagePrice} TL</strong><span>KDV dahil · tek ödeme</span></div>
    <a href={packageHref}>Paketi İncele</a>
  </div>
</CommerceLayout>

<style>
  /* --- ortak --- */
  .pkg-kicker{display:block;font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--xl-green)}
  .pkg-sec-head{display:flex;flex-direction:column;gap:10px;margin-bottom:30px}
  .pkg-sec-head h2{margin:0;font-family:var(--font-sans);font-size:clamp(28px,3vw,40px);line-height:1.05;letter-spacing:-.04em;color:var(--xl-ink-900)}
  .pkg-sec-head>p{max-width:600px;margin:0;font-size:14px;line-height:1.65;color:var(--xl-ink-3)}
  .pkg-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:44px;padding:0 18px;border-radius:12px;font-family:var(--font-mono);font-size:10.5px;font-weight:700;text-decoration:none;white-space:nowrap;transition:transform .15s ease,box-shadow .15s ease}
  .pkg-btn--primary{background:var(--xl-green);color:#fff;box-shadow:0 6px 18px rgba(11,90,51,.22)}
  .pkg-btn--primary:hover{transform:translateY(-1px);box-shadow:0 10px 24px rgba(11,90,51,.28)}
  .pkg-btn--secondary{border:1px solid var(--xl-border);background:#fff;color:var(--xl-ink-900)}
  .pkg-btn--secondary:hover{border-color:var(--xl-green);color:var(--xl-green)}

  /* --- S1 hero --- */
  .pkg-hero{padding-block:clamp(56px,6vw,80px) clamp(48px,5vw,64px);background:linear-gradient(180deg,#f2f7f3 0%,#fff 100%);border-bottom:1px solid var(--xl-grid)}
  .pkg-hero__inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(460px,1.05fr);gap:56px;align-items:center}
  .pkg-hero__copy h1{max-width:700px;margin:14px 0 0;font-family:var(--font-sans);font-size:clamp(34px,4.2vw,54px);line-height:1.02;letter-spacing:-.04em;color:var(--xl-ink-900)}
  .pkg-hero__copy h1 em{font-style:normal;color:var(--xl-green)}
  .pkg-hero__copy>p{max-width:600px;margin:18px 0 0;font-size:14.5px;line-height:1.7;color:var(--xl-ink-3)}
  .pkg-price{display:flex;align-items:flex-end;gap:14px;margin-top:24px}
  .pkg-price strong{font-family:var(--font-mono);font-size:32px;line-height:1;color:#0a6b39;letter-spacing:-.04em}
  .pkg-price span{padding-bottom:3px;font-family:var(--font-mono);font-size:9px;color:#68766d}
  .pkg-hero__actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
  .pkg-chips{display:flex;flex-wrap:wrap;gap:7px;margin:22px 0 0;padding:0;list-style:none}
  .pkg-chips li{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 11px;border:1px solid #d9e5dc;border-radius:999px;background:#f7faf7;font-family:var(--font-mono);font-size:9px;font-weight:600;color:#46634f}
  .pkg-chips li::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--xl-green)}
  .pkg-hero__visual{position:relative;min-width:0}
  .pkg-window{overflow:hidden;border:1px solid #cfdad2;border-radius:22px;background:#fff;box-shadow:0 26px 64px rgba(25,67,42,.14);transform:rotate(-1deg)}
  .pkg-window__top{display:flex;align-items:center;gap:6px;min-height:36px;padding:0 12px;background:#e9eeea;border-bottom:1px solid #d9e1db;font-family:var(--font-mono);font-size:8px;color:#748078}
  .pkg-window__top i{width:7px;height:7px;border-radius:50%;background:#ef6f68}
  .pkg-window__top i:nth-child(2){background:#eab94e}
  .pkg-window__top i:nth-child(3){background:#52b86f}
  .pkg-window__top b{margin-left:5px;font-weight:500}
  .pkg-window__top span{margin-left:auto;padding:4px 6px;border-radius:5px;background:#d9f0e2;color:#0c7040;font-weight:700}
  .pkg-window__tabs{display:flex;gap:4px;padding:10px 12px 0;border-bottom:1px solid #e0e6e1}
  .pkg-window__tabs>*{padding:7px 9px;font-family:var(--font-mono);font-size:8px;color:#718078}
  .pkg-window__tabs strong{border:1px solid #dfe5e0;border-bottom:0;border-radius:7px 7px 0 0;background:#f7fbf8;color:#0d7540}
  .pkg-window__metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:14px}
  .pkg-window__metrics>div{display:flex;flex-direction:column;gap:4px;padding:10px;border:1px solid #e1e7e2;border-radius:10px;background:#fafcfb}
  .pkg-window__metrics small{font-size:7px;color:#78857d}
  .pkg-window__metrics b{font-family:var(--font-mono);font-size:14px}
  .pkg-window__metrics em{font-family:var(--font-mono);font-size:7px;font-style:normal;color:#0d7a41}
  .pkg-window__body{display:grid;grid-template-columns:1.5fr .7fr;gap:14px;padding:0 14px 16px}
  .pkg-window__body svg{width:100%;height:150px}
  .pkg-window__risk{display:flex;flex-direction:column;justify-content:center;gap:7px}
  .pkg-window__risk span{display:flex;justify-content:space-between;gap:8px;padding:7px 8px;border-radius:8px;background:#f4f7f5;font-family:var(--font-mono);font-size:7.5px}
  .pkg-window__risk b{font-weight:500;color:#68766e}
  .pkg-window__risk em{font-style:normal;color:#0d7540;font-weight:700}
  .pkg-float{position:absolute;padding:10px 12px;border:1px solid #dbe4de;border-radius:12px;background:rgba(255,255,255,.96);box-shadow:0 14px 32px rgba(29,64,43,.12);display:flex;flex-direction:column;gap:3px}
  .pkg-float small{font-family:var(--font-mono);font-size:7.5px;color:#718078}
  .pkg-float strong{font-size:12px;color:#1c2b22}
  .pkg-float--one{left:-20px;bottom:24px}
