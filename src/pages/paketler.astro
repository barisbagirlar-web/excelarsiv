---
import { getCollection } from 'astro:content';
import CommerceLayout from '../layouts/CommerceLayout.astro';

const templates = await getCollection('templates');
const packageEntry = templates.find((entry) => entry.id === 'kobi-finans-yonetim-paketi');
const packagePriceTL = packageEntry?.data.priceTL ?? 7900;
const packagePrice = packagePriceTL.toLocaleString('tr-TR');
const packageHref = packageEntry ? `/sablon/${packageEntry.id}` : '/sablonlar';
const demoHref = packageEntry?.data.demoFile ?? '/sablonlar';
const packageScreens = packageEntry?.data.screenshots ?? [];
const heroShot = packageScreens[2] ?? packageScreens[0];
const sheetCount = packageEntry?.data.sheetCount ?? 14;

const flowNames = ['AYLIK_VERI', 'HESAP', 'KONTROLLER', 'KARAR', 'PANO', 'SENARYO_DUYARLILIK', 'RAPOR'];
const flowItems = flowNames
  .map((name) => {
    const sheet = packageEntry?.data.sheetMap?.find((s) => s.name === name);
    return sheet
      ? { code: String(flowNames.indexOf(name) + 1).padStart(2, '0'), name: sheet.name, purpose: sheet.purpose }
      : null;
  })
  .filter(Boolean);

const faq = packageEntry?.data.faq ?? [
  { question: 'Pakette hangi sistemler var?', answer: 'Paket kapsamı ürün sayfasında ayrıntılı olarak gösterilir.' },
];
---

<CommerceLayout
  title="KOBİ Finans Yönetim Paketi | Excel Arşiv"
  description="Kasa, banka, cari ve POS bakiyeleri ile stok alışı, operasyon, maaş ve kredi kalemlerini tek dosyada konsolide eden aylık yönetim modeli."
>
  <main class="pkg-page">
    <section class="pkg-hero">
      <div class="site-container pkg-hero__grid">
        <div class="pkg-hero__copy">
          <span class="pkg-eyebrow">KOBİ FİNANS YÖNETİM PAKETİ</span>
          <h1>Kasa, banka, cari ve POS bakiyelerini <em>tek karar dosyasında</em> yönetin.</h1>
          <p class="pkg-hero__lead">Kasa, banka, cari ve POS bakiyeleri ile nakit girişi, stok alışı, operasyon, maaş ve kredi kalemleri AYLIK_VERI sayfasında toplanır; HESAP net nakit değişimi, kapanış, kâr tahmini ve risk skorunu üretir.</p>

          <div class="pkg-hero__price">
            <strong>{packagePrice} TL</strong>
            <span>KDV dahil · tek ödeme · abonelik yok</span>
          </div>

          <div class="pkg-actions">
            <a class="pkg-btn pkg-btn--primary" href={packageHref}>Paketi satın al <span aria-hidden="true">→</span></a>
            <a class="pkg-btn pkg-btn--ghost" href={demoHref}>Önce demoyu incele</a>
          </div>

          <div class="pkg-proofline" aria-label="Satın alma güvenceleri">
            <span>{sheetCount} sayfa tek dosya</span>
            <span>Excel 2016+</span>
            <span>Shopier ile ödeme</span>
            <span>Dijital teslimat</span>
          </div>
        </div>

        <div class="pkg-hero__visual">
          <div class="pkg-visual-shell">
            <div class="pkg-visual-bar"><span></span><span></span><span></span><b>KOBİ Finans Yönetim Paketi</b></div>
            {heroShot ? (
              <img src={heroShot.src} alt={heroShot.alt} width="1280" height="760" loading="eager" fetchpriority="high" />
            ) : (
              <div class="pkg-visual-fallback">
                <strong>Yönetim Özeti</strong>
                <div class="pkg-fallback-kpis"><span>Nakit</span><span>Tahsilat</span><span>Risk</span></div>
              </div>
            )}
          </div>
          <div class="pkg-float pkg-float--systems"><small>Dosya kapsamı</small><strong>{sheetCount} sayfa</strong></div>
        </div>
      </div>
    </section>

    <section class="pkg-decision">
      <div class="site-container pkg-decision__grid">
        <div class="pkg-decision__intro">
          <span class="pkg-eyebrow">NEDEN BU DOSYA?</span>
          <h2>Sorun Excel kullanmak değil. <em>Karar için gereken bilginin dağınık olması.</em></h2>
          <p>Kasa bakiyesi bir yerde, banka ve cari hesap başka yerlerde, stok alışı ve kredi ödemesi ayrı listelerde olduğunda yönetici bütün resmi görmek için önce veriyi birleştirmek zorunda kalır.</p>
        </div>

        <div class="pkg-decision__compare">
          <div class="pkg-state pkg-state--before">
            <span>PARÇA PARÇA TAKİP</span>
            <ul>
              <li>Ayrı dosyalar ve farklı mantıklar</li>
              <li>Tekrarlanan manuel kontroller</li>
              <li>Karar öncesi veri birleştirme yükü</li>
            </ul>
          </div>
          <div class="pkg-state pkg-state--after">
            <span>TEK KARAR DOSYASI</span>
            <ul>
              <li>Konsolide aylık gösterge girişi</li>
              <li>Hesap ve kontrol katmanları hazır</li>
              <li>Karar, panel ve senaryo aynı dosyada</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="paket-icerigi" class="pkg-chain">
      <div class="site-container">
        <div class="pkg-section-head pkg-section-head--light">
          <div>
            <span class="pkg-eyebrow">{sheetCount} SAYFA · TEK KARAR DOSYASI</span>
            <h2>Her sayfa karar zincirinin bir halkası. <em>Birlikte aylık finans durumunu görünür kılar.</em></h2>
          </div>
          <p>Bu paket rastgele dosyaların bir araya gelmesi değildir. Aylık gösterge girişinden risk kararına uzanan tek dosyadır; her sayfa zincirin kontrol noktalarından biridir.</p>
        </div>

        <ol class="pkg-chain__rail">
          {flowItems.map((item) => (
            <li>
              <span class="pkg-chain__num">{item.code}</span>
              <strong>{item.name}</strong>
              <small>{item.purpose}</small>
            </li>
          ))}
        </ol>

        <div class="pkg-chain__value">
          <div><span>Tek dosya fiyatı</span><strong>{packagePrice} TL</strong></div>
          <i aria-hidden="true">→</i>
          <div class="is-focus"><span>Dosya kapsamı</span><strong>{sheetCount} sayfa</strong></div>
          <i aria-hidden="true">→</i>
          <div><span>Excel uyumu</span><strong>2016+</strong></div>
        </div>
      </div>
    </section>

    <section class="pkg-proof">
      <div class="site-container">
        <div class="pkg-section-head">
          <div>
            <span class="pkg-eyebrow">ÜRÜNÜ GÖRÜN</span>
            <h2>Satın almadan önce <em>gerçek dosya ekranlarını</em> inceleyin.</h2>
          </div>
          <p>Dosya yapısı soyut vaatlerle değil, ürünün kendi ekranlarıyla gösterilir. Demo dosyası da satın almadan önce indirilebilir.</p>
        </div>

        <div class="pkg-proof__gallery">
          {packageScreens.slice(0, 3).map((shot, index) => (
            <figure class:list={["pkg-shot", index === 0 && "pkg-shot--large"]}>
              <div class="pkg-shot__top"><span></span><span></span><span></span><b>{packageEntry?.data.sheetMap?.[index]?.name ?? `Ekran ${index + 1}`}</b></div>
              <img src={shot.src} alt={shot.alt} width="1280" height="760" loading={index === 0 ? 'eager' : 'lazy'} />
              <figcaption>
                <strong>{packageEntry?.data.sheetMap?.[index]?.name ?? `Ekran ${index + 1}`}</strong>
                <span>{packageEntry?.data.sheetMap?.[index]?.purpose ?? shot.alt}</span>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="pkg-proof__action">
          <a class="pkg-btn pkg-btn--ghost" href={demoHref}>Demo dosyasını indir <span aria-hidden="true">↓</span></a>
          <span>Satın almadan önce dosya yapısını kendi bilgisayarınızda inceleyin.</span>
        </div>
      </div>
    </section>

    <section class="pkg-value">
      <div class="site-container pkg-value__grid">
        <div class="pkg-value__copy">
          <span class="pkg-eyebrow">DEĞER NEREDE OLUŞUYOR?</span>
          <h2>Bir Excel dosyasına değil, <em>yeniden kurmak zorunda kalmayacağınız düzene</em> ödeme yaparsınız.</h2>
          <p>Değer; hangi verinin girileceğinin belirlenmesi, hesaplama mantığının kurulması, çıktıların ayrıştırılması ve sistemlerin birlikte kullanılabilir hale getirilmesinde oluşur.</p>
        </div>

        <div class="pkg-value__matrix">
          <div><span>01</span><strong>Hazır başlangıç</strong><p>Boş sayfadan sistem tasarlamak yerine doğrudan iş akışına geçin.</p></div>
          <div><span>02</span><strong>Görev ayrımı</strong><p>Her sistem belirli bir finans sorusuna odaklanır.</p></div>
          <div><span>03</span><strong>Bütünlük</strong><p>Kasa, banka, cari, POS, stok ve kredi göstergeleri aynı dosyada okunur.</p></div>
          <div><span>04</span><strong>Önce görme</strong><p>Demo ve ekran görüntüleriyle ne aldığınızı satın almadan önce kontrol edin.</p></div>
        </div>
      </div>
    </section>

    <section class="pkg-buyflow">
      <div class="site-container">
        <div class="pkg-section-head pkg-section-head--compact">
          <div>
            <span class="pkg-eyebrow">SATIN ALMA DENEYİMİ</span>
            <h2>Karar zor olabilir; <em>satın alma süreci değil.</em></h2>
          </div>
        </div>

        <ol class="pkg-buyflow__steps">
          <li><b>01</b><strong>Demoyu görün</strong><span>Dosya yapısını önce inceleyin.</span></li>
          <li><b>02</b><strong>Shopier ile ödeyin</strong><span>Kart işlemi Shopier altyapısında gerçekleşir.</span></li>
          <li><b>03</b><strong>Dijital teslim alın</strong><span>Fiziksel gönderim beklemeden ürüne ulaşın.</span></li>
          <li><b>04</b><strong>Kullanmaya başlayın</strong><span>Kendi işletme verilerinizi girin.</span></li>
        </ol>
      </div>
    </section>

    <section class="pkg-offer">
      <div class="site-container pkg-offer__grid">
        <div class="pkg-offer__copy">
          <span class="pkg-eyebrow">KİMLER İÇİN?</span>
          <h2>Birden fazla finans sürecini birlikte kontrol etmek isteyen işletmeler için.</h2>
          <p>Yalnızca tek bir basit ihtiyacınız varsa bireysel sistemlerden biri daha ekonomik olabilir. Bu dosya; kasa, banka, cari ve POS bakiyeleri ile stok alışı, operasyon, maaş ve kredi göstergelerini konsolide yönetmek isteyen kullanıcılar içindir.</p>
          <a href="/sablonlar" class="pkg-text-link">Tekil sistemleri incele <span aria-hidden="true">→</span></a>
        </div>

        <div class="pkg-offer__card">
          <span class="pkg-offer__label">KOBİ FİNANS YÖNETİM PAKETİ</span>
          <strong class="pkg-offer__price">{packagePrice} <small>TL</small></strong>
          <span class="pkg-offer__meta">KDV dahil · tek ödeme · abonelik yok</span>
          <a class="pkg-btn pkg-btn--primary pkg-btn--wide" href={packageHref}>Paketi satın al <span aria-hidden="true">→</span></a>
          <a class="pkg-offer__demo" href={demoHref}>Önce demo dosyasını incele</a>
          <div class="pkg-offer__trust"><span>Shopier ile ödeme</span><span>Dijital teslimat</span><span>Excel 2016+</span></div>
        </div>
      </div>
    </section>

    <section class="pkg-faq">
      <div class="site-container pkg-faq__grid">
        <div class="pkg-faq__intro">
          <span class="pkg-eyebrow">SIK SORULAN SORULAR</span>
          <h2>Satın almadan önce netleştirin.</h2>
          <p>Ürün kapsamı ve uyumluluk için ürün detayındaki güncel bilgiler esas alınır.</p>
        </div>
        <div class="pkg-faq__list">
          {faq.map((item) => (
            <details>
              <summary>{item.question}<span aria-hidden="true">+</span></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <div class="pkg-sticky" aria-label="Paket satın alma kısayolu">
      <div><strong>{packagePrice} TL</strong><span>KDV dahil · tek ödeme</span></div>
      <a href={packageHref}>Paketi satın al</a>
    </div>
  </main>
</CommerceLayout>

<style>
  .pkg-page{--pkg-green:#107c41;--pkg-green-dark:#073f27;--pkg-ink:#15211b;--pkg-muted:#66736c;--pkg-line:#dbe4de;--pkg-soft:#f3f7f4;--pkg-sand:#f2efe8;--pkg-font:"Inter","Segoe UI",Arial,sans-serif;--pkg-mono:"IBM Plex Mono","Roboto Mono","Segoe UI",monospace;font-family:var(--pkg-font);color:var(--pkg-ink);background:#fff;overflow:hidden}
  .pkg-page *{box-sizing:border-box}
  .pkg-page :is(h1,h2,h3,p,ul,ol,figure){margin-top:0}
  .pkg-eyebrow{display:inline-flex;font-family:var(--pkg-mono);font-size:10px;font-weight:700;line-height:1;letter-spacing:.12em;color:var(--pkg-green)}
  .pkg-section-head{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.7fr);gap:48px;align-items:end;margin-bottom:34px}
  .pkg-section-head--compact{grid-template-columns:1fr;margin-bottom:26px}
  .pkg-section-head h2{max-width:760px;margin:12px 0 0;font:800 clamp(30px,3.2vw,46px)/1.02 var(--pkg-font);letter-spacing:-.045em}
  .pkg-section-head h2 em{font-style:normal;color:var(--pkg-green)}
  .pkg-section-head>p{max-width:520px;margin:0;font-size:14px;line-height:1.7;color:var(--pkg-muted)}
  .pkg-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 18px;border-radius:12px;text-decoration:none;font:700 11px/1 var(--pkg-mono);transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}
  .pkg-btn:hover{transform:translateY(-1px)}
  .pkg-btn--primary{background:var(--pkg-green);color:#fff;box-shadow:0 10px 28px rgba(16,124,65,.2)}
  .pkg-btn--primary:hover{box-shadow:0 14px 34px rgba(16,124,65,.28)}
  .pkg-btn--ghost{border:1px solid #cddbd2;background:#fff;color:var(--pkg-ink)}
  .pkg-btn--ghost:hover{border-color:var(--pkg-green);color:var(--pkg-green)}
  .pkg-btn--wide{width:100%;min-height:52px}

  /* HERO */
  .pkg-hero{padding:64px 0 58px;background:radial-gradient(circle at 80% 12%,rgba(16,124,65,.10),transparent 34%),linear-gradient(180deg,#f5f9f6 0%,#fff 100%);border-bottom:1px solid #e4ebe6}
  .pkg-hero__grid{display:grid;grid-template-columns:minmax(0,.92fr) minmax(480px,1.08fr);gap:64px;align-items:center}
  .pkg-hero__copy h1{max-width:690px;margin:14px 0 0;font:850 clamp(40px,4.6vw,64px)/.98 var(--pkg-font);letter-spacing:-.055em}
  .pkg-hero__copy h1 em{font-style:normal;color:var(--pkg-green)}
  .pkg-hero__lead{max-width:600px;margin:20px 0 0;font-size:15px;line-height:1.72;color:var(--pkg-muted)}
  .pkg-hero__price{display:flex;align-items:flex-end;gap:14px;margin-top:28px}
  .pkg-hero__price strong{font:700 34px/1 var(--pkg-mono);letter-spacing:-.04em;color:var(--pkg-green-dark)}
  .pkg-hero__price span{padding-bottom:4px;font:500 9px/1.4 var(--pkg-mono);color:#738078}
  .pkg-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
  .pkg-proofline{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:24px;color:#5f7066}
  .pkg-proofline span{position:relative;padding-left:12px;font:600 9px/1.5 var(--pkg-mono)}
  .pkg-proofline span::before{content:"";position:absolute;left:0;top:.48em;width:5px;height:5px;border-radius:50%;background:var(--pkg-green)}
  .pkg-hero__visual{position:relative;min-width:0}
  .pkg-visual-shell{overflow:hidden;border:1px solid #cfdad2;border-radius:22px;background:#fff;box-shadow:0 28px 70px rgba(25,67,42,.16);transform:rotate(-.55deg)}
  .pkg-visual-bar{display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;background:#edf2ee;border-bottom:1px solid #dbe3dd}
  .pkg-visual-bar span{width:7px;height:7px;border-radius:50%;background:#ea6b65}.pkg-visual-bar span:nth-child(2){background:#e6b950}.pkg-visual-bar span:nth-child(3){background:#52b86f}
  .pkg-visual-bar b{margin-left:5px;font:500 8px/1 var(--pkg-mono);color:#66736b}
  .pkg-visual-shell img{display:block;width:100%;aspect-ratio:1.68/1;object-fit:cover;object-position:top center;background:#fff}
  .pkg-visual-fallback{display:grid;place-items:center;min-height:360px;background:linear-gradient(135deg,#f8fbf9,#e9f3ed)}
  .pkg-fallback-kpis{display:flex;gap:8px}.pkg-fallback-kpis span{padding:12px;border:1px solid var(--pkg-line);border-radius:10px;background:#fff}
  .pkg-float{position:absolute;z-index:2;display:flex;flex-direction:column;gap:3px;padding:11px 14px;border:1px solid #dbe5de;border-radius:13px;background:rgba(255,255,255,.97);box-shadow:0 14px 36px rgba(25,58,38,.13)}
  .pkg-float small{font:500 8px/1.2 var(--pkg-mono);color:#78847c}.pkg-float strong{font-size:13px;color:var(--pkg-ink)}
  .pkg-float--systems{left:-24px;bottom:26px}.pkg-float--saving{right:-18px;top:44px}

  /* DECISION */
  .pkg-decision{padding:64px 0;background:var(--pkg-sand);border-bottom:1px solid #e1ddd4}
  .pkg-decision__grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:62px;align-items:center}
  .pkg-decision__intro h2{max-width:620px;margin:12px 0 0;font:800 clamp(31px,3.5vw,48px)/1.02 var(--pkg-font);letter-spacing:-.045em}
  .pkg-decision__intro h2 em{font-style:normal;color:var(--pkg-green)}
  .pkg-decision__intro p{max-width:580px;margin:18px 0 0;font-size:14px;line-height:1.75;color:#647067}
  .pkg-decision__compare{display:grid;grid-template-columns:1fr 1fr;border:1px solid #d9d4c9;border-radius:20px;overflow:hidden;background:#fff}
  .pkg-state{padding:24px}.pkg-state+ .pkg-state{border-left:1px solid #e0ddd5}
  .pkg-state>span{font:700 9px/1 var(--pkg-mono);letter-spacing:.1em;color:#7b837e}
  .pkg-state ul{display:flex;flex-direction:column;gap:12px;margin:20px 0 0;padding:0;list-style:none}
  .pkg-state li{position:relative;padding-left:18px;font-size:13px;line-height:1.5;color:#58635c}
  .pkg-state li::before{content:"";position:absolute;left:0;top:.55em;width:7px;height:7px;border-radius:50%;background:#b8beb9}
  .pkg-state--after{background:#f0f7f2}.pkg-state--after>span{color:var(--pkg-green)}.pkg-state--after li{color:#31473a}.pkg-state--after li::before{background:var(--pkg-green)}

  /* CHAIN */
  .pkg-chain{padding:74px 0;background:var(--pkg-green-dark);color:#fff}
  .pkg-chain .pkg-eyebrow{color:#7bd29d}.pkg-section-head--light h2{color:#fff}.pkg-section-head--light h2 em{color:#7bd29d}.pkg-section-head--light>p{color:rgba(255,255,255,.66)}
  .pkg-chain__rail{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));margin:42px 0 0;padding:0;list-style:none;border-top:1px solid rgba(255,255,255,.16)}
  .pkg-chain__rail li{position:relative;min-width:0}.pkg-chain__rail li:not(:last-child)::after{content:"→";position:absolute;right:-7px;top:23px;z-index:2;color:#7bd29d;font:600 13px var(--pkg-mono)}
  .pkg-chain__rail a{display:flex;min-height:175px;flex-direction:column;gap:9px;padding:24px 14px 18px;border-right:1px solid rgba(255,255,255,.10);color:#fff;text-decoration:none;transition:background .18s ease}
  .pkg-chain__rail a:hover{background:rgba(255,255,255,.045)}
  .pkg-chain__num{font:700 9px var(--pkg-mono);color:#7bd29d}.pkg-chain__rail strong{font-size:14px;line-height:1.25}.pkg-chain__rail small{font-size:10.5px;line-height:1.5;color:rgba(255,255,255,.58)}
  .pkg-chain__value{display:flex;align-items:stretch;justify-content:flex-end;gap:0;margin-top:28px;border-top:1px solid rgba(255,255,255,.14)}
  .pkg-chain__value>div{display:flex;min-width:170px;flex-direction:column;gap:5px;padding:18px 20px}.pkg-chain__value span{font:500 8px var(--pkg-mono);color:rgba(255,255,255,.48)}.pkg-chain__value strong{font:700 19px var(--pkg-mono)}
  .pkg-chain__value .is-focus{background:#fff;color:var(--pkg-green-dark)}.pkg-chain__value .is-focus span{color:#66736c}.pkg-chain__value>i{display:grid;place-items:center;padding:0 12px;font-style:normal;color:#7bd29d}

  /* PROOF */
  .pkg-proof{padding:74px 0;background:#fff;border-bottom:1px solid #e5ebe7}
  .pkg-proof__gallery{display:grid;grid-template-columns:1.35fr .85fr;grid-template-rows:1fr 1fr;gap:16px}
  .pkg-shot{overflow:hidden;margin:0;border:1px solid #dbe4de;border-radius:18px;background:#f8faf8;box-shadow:0 18px 46px rgba(27,58,40,.08)}
  .pkg-shot--large{grid-row:1/3}.pkg-shot__top{display:flex;align-items:center;gap:5px;height:30px;padding:0 10px;background:#eef2ef;border-bottom:1px solid #dce4de}.pkg-shot__top span{width:6px;height:6px;border-radius:50%;background:#ea6b65}.pkg-shot__top span:nth-child(2){background:#e6b950}.pkg-shot__top span:nth-child(3){background:#52b86f}.pkg-shot__top b{margin-left:5px;font:500 7.5px var(--pkg-mono);color:#6b776f}
  .pkg-shot img{display:block;width:100%;height:auto;aspect-ratio:1.65/1;object-fit:cover;object-position:top center}.pkg-shot--large img{aspect-ratio:auto;min-height:430px}
  .pkg-shot figcaption{display:flex;justify-content:space-between;gap:16px;padding:12px 14px;border-top:1px solid #e5ebe6}.pkg-shot figcaption strong{font-size:12px}.pkg-shot figcaption span{max-width:62%;font-size:10px;line-height:1.4;color:#718078;text-align:right}
  .pkg-proof__action{display:flex;align-items:center;gap:16px;margin-top:22px}.pkg-proof__action>span{font-size:11.5px;color:#6c7971}

  /* VALUE */
