---
import { getCollection } from 'astro:content';
import CommerceLayout from '../layouts/CommerceLayout.astro';

const templates = await getCollection('templates');
const packageEntry = templates.find((entry) => entry.id === 'kobi-finans-yonetim-paketi');
const packagePrice = packageEntry?.data.priceTL.toLocaleString('tr-TR') ?? '7.900';
const packageHref = packageEntry ? `/sablon/${packageEntry.id}` : '/sablonlar';
const demoHref = packageEntry?.data.demoFile ?? '/sablonlar';

const moduleList = [
  {
    slug: 'akilli-kasa-defteri-ve-nakit-kontrol-sistemi',
    title: 'Akıllı Kasa Defteri ve Nakit Kontrolü',
    text: 'Günlük kasa hareketlerini kaydedin, bakiye ile fiili durumu karşılaştırın ve dönem sonu farklarını görün.',
  },
  {
    slug: '13-haftalik-nakit-akisi-ve-odeme-planlama-sistemi',
    title: '13 Haftalık Nakit Akışı ve Ödeme Planlama',
    text: 'Yaklaşan giriş ve çıkışları haftalık görün; ödeme yoğunluğunun arttığı dönemleri önceden takip edin.',
  },
  {
    slug: 'cari-hesap-tahsilat-ve-musteri-risk-takip-sistemi',
    title: 'Cari Hesap ve Tahsilat Takibi',
    text: 'Müşteri bakiyelerini, tahsilat durumunu ve vadesi yaklaşan alacakları daha düzenli izleyin.',
  },
  {
    slug: 'banka-kredi-ve-taksit-takip-sistemi',
    title: 'Banka, Kredi ve Taksit Takibi',
    text: 'Banka hesaplarını, kredi ödemelerini ve taksit tarihlerini tek yerde takip edin.',
  },
  {
    slug: 'cek-senet-ve-vade-risk-sistemi',
    title: 'Çek-Senet ve Vade Riski',
    text: 'Vadeli yükümlülükleri tarihlerine göre görün ve yoğunlaşan ödeme dönemlerini daha erken fark edin.',
  },
  {
    slug: 'stok-satis-ve-nakit-baglanma-sistemi',
    title: 'Stok ve İşletme Sermayesi Takibi',
    text: 'Stok hareketlerini yalnızca miktar olarak değil, nakdi bağlayan işletme sermayesi unsuru olarak izleyin.',
  },
  {
    slug: 'aylik-patron-finans-paneli',
    title: 'Yönetim / Patron Finans Özeti',
    text: 'Kasa, nakit, kârlılık ve kritik finans göstergelerini yönetim seviyesinde daha hızlı okuyun.',
  },
];

const modules = moduleList.map((module, index) => {
  const entry = templates.find((t) => t.id === module.slug);
  return {
    code: String(index + 1).padStart(2, '0'),
    slug: module.slug,
    name: module.title,
    text: module.text,
    outputs: entry?.data.outputs.slice(0, 3) ?? [],
    priceTL: entry?.data.priceTL ?? 0,
    url: entry ? `/sablon/${entry.id}` : '/sablonlar',
  };
});

const individualTotal = modules.reduce((sum, module) => sum + module.priceTL, 0);
const individualTotalText = individualTotal.toLocaleString('tr-TR');

const faq = [
  {
    question: 'Paketi satın almadan önce inceleyebilir miyim?',
    answer: 'Evet. Mevcut ürünlerde sunulan demo dosyalarıyla yapıyı ve çalışma mantığını satın almadan önce inceleyebilirsiniz.',
  },
  {
    question: 'Aylık abonelik ücreti var mı?',
    answer: 'Hayır. Paket tek seferlik satın alınır.',
  },
  {
    question: 'Fiyat KDV dahil mi?',
    answer: 'Evet. Sayfada gösterilen paket fiyatı KDV dahildir.',
  },
  {
    question: 'Hangi Excel sürümü gerekiyor?',
    answer: 'Paket Excel 2016 ve üzeri sürümler için hazırlanmıştır.',
  },
  {
    question: 'Dosyaları değiştirebilir miyim?',
    answer: 'Girdi alanları kullanım için açıktır. Dosyanın yapısına göre korunan alanlar bulunabilir; ürün detayında ilgili bilgiler ayrıca belirtilir.',
  },
  {
    question: 'Mac bilgisayarda kullanabilir miyim?',
    answer: 'Paket içeriğinde kullanılan standart Excel işlevleri Mac uyumluluğu gözetilerek hazırlanmıştır. Ürün detayındaki uyumluluk bilgisi esas alınmalıdır.',
  },
  {
    question: 'Paketteki sistemleri ayrı ayrı kullanabilir miyim?',
    answer: 'Evet. Paket tek bir dosyaya mahkûm bir yapı olarak değil, farklı finans ihtiyaçlarını kapsayan sistem ailesi olarak kurgulanmıştır.',
  },
  {
    question: 'Satın aldıktan sonra nasıl teslim edilir?',
    answer: 'Ödeme sonrasında dijital teslimat süreci başlatılır ve ürünler elektronik ortamda kullanıcıya ulaştırılır.',
  },
];
---

<CommerceLayout
  title="KOBİ Finans Yönetim Paketi | Excel Arşiv"
  description="Kasa, nakit akışı, cari hesap, banka, çek-senet, dönem sonu ve yönetim raporlamasını aynı Excel sistem ailesinde birleştiren KOBİ Finans Yönetim Paketi."
>
  <section class="pkg-hero">
    <div class="site-container pkg-hero__inner">
      <div class="pkg-hero__copy">
        <span class="pkg-kicker">KOBİ FİNANS YÖNETİM PAKETİ</span>
        <h1>Finansı ayrı ayrı dosyalarda değil, <em>tek bir yönetim düzeninde</em> toplayın.</h1>
        <p>Kasa, banka, cari hesap, nakit akışı, stok, ödeme yükümlülükleri ve yönetim özetini birbirinden kopuk Excel dosyalarıyla takip etmek yerine, işletmenizin günlük finansal kontrolünü hazır kurulmuş bir sistem yapısında yönetin.</p>
        <div class="pkg-price"><strong>{packagePrice} TL</strong><span>KDV dahil · Tek seferlik ödeme · Abonelik yok</span></div>
        <div class="pkg-hero__actions">
          <a href={packageHref} class="pkg-btn pkg-btn--primary">Paketi İncele <span aria-hidden="true">→</span></a>
          <a href={demoHref} class="pkg-btn pkg-btn--secondary">Önce Demo Dosyasını Gör</a>
        </div>
        <ul class="pkg-chips">
          <li>Excel 2016+ uyumlu</li>
          <li>KDV dahil</li>
          <li>Shopier ile güvenli ödeme</li>
          <li>Dijital teslimat</li>
        </ul>
      </div>

      <div class="pkg-hero__visual" aria-hidden="true">
        <div class="pkg-window">
          <div class="pkg-window__top"><i></i><i></i><i></i><b>KOBI_Finans_Yonetim.xlsx</b><span>CANLI</span></div>
          <div class="pkg-window__tabs"><strong>Yönetim</strong><span>Nakit</span><span>Cari</span><span>Banka</span><span>Risk</span></div>
          <div class="pkg-window__metrics"><div><small>Nakit</small><b>₺1,25M</b><em>▲ %12</em></div><div><small>Net kâr</small><b>₺415K</b><em>▲ %8</em></div><div><small>Tahsilat</small><b>%92</b><em>▲ %4</em></div></div>
          <div class="pkg-window__body">
            <svg viewBox="0 0 420 150" preserveAspectRatio="none"><path d="M0 126 L52 115 L104 119 L156 89 L208 98 L260 68 L312 76 L364 42 L420 25 L420 150 L0 150 Z" fill="rgba(16,124,65,.09)"/><polyline points="0,126 52,115 104,119 156,89 208,98 260,68 312,76 364,42 420,25" fill="none" stroke="#16864b" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <div class="pkg-window__risk"><span><b>Nakit tamponu</b><em>Güçlü</em></span><span><b>Tahsilat</b><em>%92</em></span><span><b>Vade baskısı</b><em>İzle</em></span></div>
          </div>
        </div>
        <div class="pkg-float pkg-float--one"><small>7 sistem</small><strong>Tek aile</strong></div>
        <div class="pkg-float pkg-float--two"><small>Tek ödeme</small><strong>{packagePrice} TL</strong></div>
      </div>
    </div>
  </section>

  <section class="pkg-problem">
    <div class="site-container">
      <span class="pkg-kicker">DAĞINIKLIĞI BİTİRİN</span>
      <h2>Finansı takip etmek zor değil. <em>Her şeyi ayrı yerde takip etmek zor.</em></h2>
      <p>Kasa başka dosyada, banka başka tabloda, cari hesap ayrı listede, ödeme takvimi başka yerde olduğunda asıl sorun Excel kullanmak değildir. Sorun, karar vermek için ihtiyaç duyduğunuz bilgilerin birbirinden kopuk olmasıdır.</p>
      <p>Excel Arşiv Finans Yönetim Paketi, günlük kayıtları ve yönetim için gerekli finansal görünümü aynı çalışma düzeni içinde toplamak için hazırlanmıştır.</p>
      <p class="pkg-problem__vurgu">Daha fazla dosya değil. Daha az dağınıklık.</p>
    </div>
  </section>

  <section class="pkg-fit">
    <div class="site-container">
      <div class="pkg-sec-head">
        <div><span class="pkg-kicker">SİZE UYGUN MU?</span><h2>İşletmenin rakamlarını takip etmek yetmiyorsa, bu paket sizin için.</h2></div>
      </div>
      <div class="pkg-fit__grid">
        <article><b>İşletme Sahibi</b><p>Nakit, borç, tahsilat, stok ve finansal görünümün ne durumda olduğunu farklı dosyalara bakmadan görmek isteyenler için.</p></article>
        <article><b>Finans / Muhasebe Sorumlusu</b><p>Tekrar eden kontrolleri, ödeme takibini ve yönetim raporlamasını daha düzenli bir çalışma yapısına taşımak isteyenler için.</p></article>
        <article><b>Yönetici / Patron</b><p>Detayların içinde kaybolmadan işletmenin finansal yönünü okuyabilmek isteyenler için.</p></article>
        <article><b>Sistemi Baştan Kurmak İstemeyenler</b><p>Formül, kontrol, sayfa yapısı ve raporlama düzenini sıfırdan geliştirmek yerine hazır bir başlangıç isteyenler için.</p></article>
      </div>
    </div>
  </section>

  <section id="paket-icerigi" class="pkg-modules">
    <div class="site-container">
      <div class="pkg-sec-head">
        <div><span class="pkg-kicker">TEK PAKET · BİRDEN FAZLA İŞ AKIŞI</span><h2>Günlük kayıttan yönetim özetine kadar aynı finans zinciri.</h2></div>
        <p>Paket yalnızca tabloların bir araya getirilmesi değildir. Her sistem işletmenin farklı bir finansal sorusuna cevap verir; birlikte kullanıldığında daha bütünlüklü bir kontrol düzeni oluşturur.</p>
      </div>

      <article class="pkg-mod pkg-mod--featured">
        <div class="pkg-mod__copy">
          <span class="pkg-mod__code">{modules[0].code}</span>
          <h3>{modules[0].name}</h3>
          <p>{modules[0].text}</p>
          <ul>{modules[0].outputs.map((output) => <li>✓ {output}</li>)}</ul>
        </div>
        <div class="pkg-mod__side">
          <span class="pkg-mod__label">Paket kapsamında</span>
          <strong class="pkg-mod__price">{modules[0].priceTL.toLocaleString('tr-TR')} TL</strong>
          <a href={modules[0].url}>İncele <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <div class="pkg-mod__grid">
        {modules.slice(1, 3).map((module) => (
          <article class="pkg-mod pkg-mod--medium">
            <div class="pkg-mod__copy">
              <span class="pkg-mod__code">{module.code}</span>
              <h3>{module.name}</h3>
              <p>{module.text}</p>
            </div>
            <div class="pkg-mod__side">
              <strong class="pkg-mod__price">{module.priceTL.toLocaleString('tr-TR')} TL</strong>
              <a href={module.url}>İncele <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>

      <div class="pkg-mod__row">
        {modules.slice(3).map((module) => (
          <article class="pkg-mod pkg-mod--compact">
            <span class="pkg-mod__code">{module.code}</span>
            <h3>{module.name}</h3>
            <p>{module.text}</p>
            <div class="pkg-mod__side"><strong class="pkg-mod__price">{module.priceTL.toLocaleString('tr-TR')} TL</strong><a href={module.url} aria-label="{module.name} sayfasını incele">İncele <span aria-hidden="true">→</span></a></div>
          </article>
        ))}
      </div>
      <p class="pkg-mod__close">Her dosyanın kendi görevi var. Paketin değeri, bunların aynı yönetim mantığında buluşmasında.</p>
    </div>
  </section>

  <section class="pkg-why">
    <div class="site-container pkg-why__inner">
      <div class="pkg-why__copy">
        <span class="pkg-kicker">TEK TEK ALMAK MI, SİSTEM KURMAK MI?</span>
        <h2>İhtiyaçlar birbirine bağlıysa, çözümün de birbirine bağlı olması gerekir.</h2>
        <p>İşletmede kasa ile nakit akışı, tahsilat ile cari hesap, stok ile işletme sermayesi birbirinden bağımsız değildir. Bu nedenle yalnızca tek bir dosyayı çözmek çoğu zaman yeterli olmaz.</p>
      </div>
      <div class="pkg-why__compare">
        <div class="pkg-why__col is-muted">
          <b>Tek tek alım</b>
          <ul>
            <li>Her ihtiyaç için ayrı karar</li>
            <li>Farklı kullanım düzenleri</li>
            <li>Parça parça takip</li>
            <li>Daha fazla manuel geçiş</li>
          </ul>
        </div>
        <div class="pkg-why__col is-win">
          <b>Finans Yönetim Paketi</b>
          <ul>
            <li>Tek satın alma kararı</li>
            <li>Birbiriyle uyumlu çalışma mantığı</li>
            <li>Daha bütünlüklü finans görünümü</li>
            <li>Ortak yönetim yaklaşımı</li>
          </ul>
        </div>
        <p class="pkg-why__close">Paket indirimi değil; <em>bütünlük avantajı</em> satın alırsınız.</p>
      </div>
    </div>
  </section>

  <section class="pkg-manifest">
    <div class="site-container">
      <span class="pkg-kicker">DEĞER NEREDE OLUŞUYOR?</span>
      <h2>Bir Excel dosyasına değil, <em>tekrar kurmayacağınız düzene</em> ödeme yaparsınız.</h2>
      <p class="pkg-manifest__lead">Hazır sistemin değeri hücrelerin sayısında değildir. İş probleminin tanımlanması, modelin kurulması, formül mantığının oluşturulması, giriş ve çıktıların ayrılması, kontrollerin eklenmesi ve dosyanın kullanılabilir hale getirilmesi aynı çalışmanın parçalarıdır.</p>
      <div class="pkg-manifest__grid">
        <div><b>Model</b><p>İş problemi önce yapıya çevrilir.</p></div>
        <div><b>Kontrol</b><p>Girdi ve hesaplama alanları birbirinden ayrılır.</p></div>
        <div><b>Test</b><p>Sonuçlar gerçek iş senaryolarıyla kontrol edilir.</p></div>
        <div><b>Teslim</b><p>Kullanıcı yalnızca dosya değil, nasıl çalıştığını anlayabileceği düzen alır.</p></div>
      </div>
      <span class="pkg-manifest__tag">MODEL · TEST · KONTROL · TESLİM</span>
    </div>
  </section>

  <section class="pkg-steps">
    <div class="site-container">
      <div class="pkg-sec-head">
        <div><span class="pkg-kicker">SATIN ALMA DENEYİMİ</span><h2>Karar zor olabilir; satın alma süreci değil.</h2></div>
      </div>
      <ol class="pkg-steps__list">
        <li><b>01</b><strong>Demo ile inceleyin</strong><p>Satın almadan önce örnek dosya yapısını ve kullanım mantığını görün.</p></li>
        <li><b>02</b><strong>Shopier ile güvenli ödeyin</strong><p>Kart işlemi Shopier altyapısı üzerinden gerçekleştirilir.</p></li>
        <li><b>03</b><strong>Dijital teslim alın</strong><p>Satın alma sonrasında dosyalar dijital olarak teslim edilir.</p></li>
        <li><b>04</b><strong>Kullanmaya başlayın</strong><p>Dosyayı açın, kendi işletme verilerinizi girin ve çalışma düzeninizi oluşturmaya başlayın.</p></li>
      </ol>
      <p class="pkg-steps__note">Kart bilgileriniz Excel Arşiv tarafından saklanmaz.</p>
    </div>
  </section>

  <section class="pkg-trust">
    <div class="site-container">
      <div class="pkg-sec-head">
        <div><span class="pkg-kicker">SATIN ALMADAN ÖNCE BİLMENİZ GEREKENLER</span><h2>Sürpriz ücret yok. Abonelik yok. Belirsiz teslimat yok.</h2></div>
      </div>
      <div class="pkg-trust__grid">
        <div><b>KDV</b><strong>KDV Dahil</strong><p>Gösterilen fiyat son kullanıcı fiyatıdır.</p></div>
        <div><b>Ödeme</b><strong>Tek Seferlik Ödeme</strong><p>Aylık veya yıllık abonelik ücreti bulunmaz.</p></div>
        <div><b>Demo</b><strong>Demo İnceleme</strong><p>Satın almadan önce ürünün sınırlı demo sürümünü inceleyebilirsiniz.</p></div>
        <div><b>Teslim</b><strong>Dijital Teslimat</strong><p>Fiziksel gönderim beklemezsiniz; ürün dijital olarak teslim edilir.</p></div>
      </div>
    </div>
  </section>

  <section class="pkg-offer">
    <div class="site-container">
      <div class="pkg-offer__card">
        <div class="pkg-offer__left">
          <span class="pkg-kicker">KOBİ FİNANS YÖNETİM PAKETİ</span>
          <h2>Finansal kontrol için tek tek dosya aramayı burada bitirin.</h2>
          <p>Kasa, banka, cari hesap, ödeme planlaması, nakit akışı, stok takibi ve yönetim görünümünü hazır sistemlerle tek çalışma düzenine taşıyın.</p>
          <p class="pkg-offer__kapsam">Hazır finans sistemleri + demo inceleme + dijital teslimat</p>
        </div>
        <div class="pkg-offer__right">
          <span class="pkg-offer__from">Tek tek alınsaydı {individualTotalText} TL</span>
          <strong class="pkg-offer__price">{packagePrice} <small>TL</small></strong>
          <span class="pkg-offer__note">KDV dahil · Tek ödeme</span>
          <a href={packageHref} class="pkg-btn pkg-btn--primary">Finans Yönetim Paketini İncele <span aria-hidden="true">→</span></a>
          <a href={demoHref} class="pkg-offer__demo">Önce Demo Dosyasını İncele</a>
          <p class="pkg-offer__micro">Shopier ile güvenli ödeme · Kart bilgisi sitede tutulmaz · Abonelik yok</p>
        </div>
      </div>
    </div>
  </section>

  <section class="pkg-price-case">
    <div class="site-container">
      <span class="pkg-kicker">FİYATI NASIL DEĞERLENDİRMELİ?</span>
      <h2>Fiyatı dosya sayısıyla değil, <em>yeniden yapmak zorunda kalmayacağınız işle</em> ölçün.</h2>
      <p>Bir işletme için iyi hazırlanmış finans çalışma düzeninin maliyeti yalnızca formül yazma süresi değildir. Hangi verinin girileceğini belirlemek, hesaplama mantığını kurmak, hatalı girişleri kontrol etmek, raporlama yapısını oluşturmak, test etmek ve kullanılabilir hale getirmek de aynı çalışmanın parçasıdır.</p>
      <p>Bu paketin amacı size daha fazla Excel sayfası vermek değil; bu kurulum sürecinin önemli bölümünü hazır halde sunmaktır.</p>
      <p class="pkg-price-case__vurgu">Hazır sistemin değeri, size bıraktığı dosyada değil; sizin yeniden kurmak zorunda kalmadığınız yapıda oluşur.</p>
    </div>
  </section>

  <section class="pkg-notfor">
    <div class="site-container pkg-notfor__inner">
      <div>
        <span class="pkg-kicker">HERKES İÇİN DEĞİL</span>
        <h2>Tek bir basit ihtiyacınız varsa tüm paketi almanız gerekmeyebilir.</h2>
      </div>
      <div class="pkg-notfor__body">
        <p>Yalnızca kasa takibi, yalnızca cari hesap veya yalnızca belirli bir hesaplama ihtiyacınız varsa bireysel sistemlerden biri sizin için daha ekonomik olabilir.</p>
        <p>Finans Yönetim Paketi; birden fazla finans sürecini birlikte kontrol etmek, işletmenin genel görünümünü güçlendirmek ve parça parça dosya toplamak istemeyen işletmeler için hazırlanmıştır.</p>
        <a href="/sablonlar" class="pkg-btn pkg-btn--secondary">Tekil Sistemleri İncele <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="pkg-faq">
    <div class="site-container">
      <div class="pkg-sec-head">
        <div><span class="pkg-kicker">SSS</span><h2>Sık sorulan sorular.</h2></div>
      </div>
      <div class="pkg-faq__list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="pkg-final">
    <div class="site-container">
      <div class="pkg-final__card">
        <span class="pkg-kicker">BAŞLAMAYA HAZIRSANIZ</span>
        <h2>İşletmenizin finansını daha fazla dosyayla değil, <em>daha iyi bir sistemle</em> yönetin.</h2>
        <p>Satın almadan önce inceleyin. İhtiyacınıza uygunsa tek seferlik ödeme ile finans çalışma düzeninizi hazır sistemlerle kurmaya başlayın.</p>
        <div class="pkg-final__actions">
          <a href={packageHref} class="pkg-btn pkg-btn--primary">KOBİ Finans Yönetim Paketini İncele <span aria-hidden="true">→</span></a>
          <a href="/sablonlar" class="pkg-btn pkg-btn--secondary">Tüm Excel Sistemlerini Gör</a>
        </div>
        <p class="pkg-final__meta">{packagePrice} TL · KDV dahil · Tek ödeme · Shopier ile güvenli ödeme</p>
      </div>
    </div>
  </section>

  <div class="pkg-sticky">
