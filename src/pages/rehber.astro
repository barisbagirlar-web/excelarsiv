---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'tr'));
const guidesLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': new URL('/rehber#itemlist', Astro.site).toString(),
  numberOfItems: guides.length,
  itemListElement: guides.map((guide, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/rehber/${guide.id}`, Astro.site).toString(),
    name: guide.data.title,
  })),
});
const guidesPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': new URL('/rehber#collection', Astro.site).toString(),
  url: new URL('/rehber', Astro.site).toString(),
  name: 'İşletmeler İçin Excel Rehberleri',
  inLanguage: 'tr-TR',
  isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
  mainEntity: { '@id': new URL('/rehber#itemlist', Astro.site).toString() },
});
const guidesBreadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Rehberler', item: new URL('/rehber', Astro.site).toString() },
  ],
});
---

<CommerceLayout
  title="İşletmeler İçin Excel Rehberleri | Excel Arşiv"
  description="Nakit akışı, stok, cari hesap ve kasa takibini Excel'de doğru kurmak için uygulamalı işletme rehberleri ve seçim çerçeveleri."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={guidesLd} />
    <script type="application/ld+json" set:html={guidesPageLd} />
    <script type="application/ld+json" set:html={guidesBreadcrumbLd} />
  </Fragment>
  <section class="border-b border-rule-hairline bg-surface-1">
    <div class="container-site section-enter">
      <SectionLabel number={1} label="Karar Rehberleri" />
      <h1 class="display mt-6">Excel dosyası değil, doğru kontrol sistemi nasıl kurulur?</h1>
      <p class="lead mt-6 max-w-2xl">İşletmelerin en sık para kaybettiği takip alanlarını tek tek ele alan, hangi verinin tutulacağını ve hangi kararın çıkarılacağını gösteren uygulama rehberleri.</p>
    </div>
  </section>

  <section>
    <div class="container-site section-enter">
      <div class="guide-grid">
        {guides.map((guide, index) => (
          <article class="guide-card">
            <span>{String(index + 1).padStart(2, '0')} · {guide.data.primaryQuery}</span>
            <h2><a href={`/rehber/${guide.id}`}>{guide.data.title}</a></h2>
            <p>{guide.data.description}</p>
            <a class="guide-card__link" href={`/rehber/${guide.id}`}>Rehberi aç →</a>
          </article>
        ))}
      </div>
      <div class="mt-12 border-t border-rule-hairline pt-8">
        <h2 class="h2">Ürünü doğrudan karşılaştırmak mı istiyorsunuz?</h2>
        <p class="body-sm mt-3 max-w-xl">Rehberler yöntemi açıklar; katalog ise hazır Excel sistemlerinin kapsamını, demo ekranlarını ve teknik bilgilerini yan yana görmenizi sağlar.</p>
        <div class="mt-6"><Button href="/sablonlar">Excel sistemlerini karşılaştırın</Button></div>
      </div>
    </div>
  </section>
</CommerceLayout>

<style>
  .guide-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.guide-card{display:flex;min-height:280px;flex-direction:column;padding:28px;border:1px solid #dce5df;border-radius:18px;background:#fff}.guide-card>span{font-family:var(--font-mono);font-size:8.5px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:#0b7440}.guide-card h2{margin:18px 0 0;font-family:var(--font-display);font-size:27px;line-height:1.07;letter-spacing:-.025em;color:#183024}.guide-card h2 a{color:inherit;text-decoration:none}.guide-card p{margin:14px 0 0;font-size:12px;line-height:1.65;color:#647169}.guide-card__link{margin-top:auto;padding-top:22px;font-size:10.5px;font-weight:800;color:#0b7440;text-decoration:none}@media(max-width:760px){.guide-grid{grid-template-columns:1fr}.guide-card{min-height:0;padding:22px}.guide-card h2{font-size:24px}}
</style>
