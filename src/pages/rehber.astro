---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
import { getCollection } from 'astro:content';
import { categories } from '../lib/categories';

const guides = (await getCollection('guides')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'tr'));
const categoryGroups = categories.map((category) => ({
  ...category,
  guides: guides.filter((guide) => guide.data.category === category.slug),
})).filter((group) => group.guides.length > 0);
const guidesLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': new URL('/rehber#itemlist', Astro.site).toString(),
  numberOfItems: guides.length,
  itemListElement: guides.map((guide, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/rehber/${guide.id}`, Astro.site).toString(),
    name: guide.data.title,
  })),
});
const guidesPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': new URL('/rehber#collection', Astro.site).toString(),
  url: new URL('/rehber', Astro.site).toString(),
  name: 'KOBİ ve İşletmeler İçin Excel Rehberleri',
  description: 'Finansal analiz, nakit akışı, muhasebe, bütçe, stok, satış ve personel yönetimi için uygulamalı Excel rehberleri.',
  inLanguage: 'tr-TR',
  isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
  mainEntity: { '@id': new URL('/rehber#itemlist', Astro.site).toString() },
});
const guidesBreadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Rehberler', item: new URL('/rehber', Astro.site).toString() },
  ],
});
---

<CommerceLayout
  title="KOBİ ve İşletmeler İçin Excel Rehberleri | Excel Arşiv"
  description="Nakit akışı, finansal analiz, bütçe, muhasebe, stok, satış ve personel yönetimini Excel'de kurmak için uygulamalı, ürün bağlantılı profesyonel rehberler."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={guidesLd} />
    <script type="application/ld+json" set:html={guidesPageLd} />
    <script type="application/ld+json" set:html={guidesBreadcrumbLd} />
  </Fragment>

  <section class="border-b border-rule-hairline bg-surface-1">
    <div class="container-site section-enter">
      <SectionLabel number={1} label="Uygulama Rehberleri" />
      <h1 class="display mt-6">İşletmenin kritik Excel sistemlerini doğru yöntemle nasıl kurarsınız?</h1>
      <p class="lead mt-6 max-w-3xl">Bu merkez, KOBİ'lerin ve finans ekiplerinin en sık karşılaştığı karar problemlerini yedi konu kümesinde toplar. Her rehber yalnız formülü anlatmaz; gerekli veri yapısını, kontrol mantığını, hata noktalarını, karar çıktısını ve ilgili hazır Excel sistemini birlikte gösterir.</p>
      <div class="hub-stats mt-8">
        <div><strong>{guides.length}</strong><span>uygulamalı rehber</span></div>
        <div><strong>{categoryGroups.length}</strong><span>konu kümesi</span></div>
        <div><strong>1:1</strong><span>rehber → ürün bağlantısı</span></div>
      </div>
    </div>
  </section>

  <section class="hub-nav-section">
    <div class="container-site section-enter">
      <p class="hub-kicker">KONU KÜMELERİ</p>
      <nav class="cluster-nav" aria-label="Rehber konu kümeleri">
        {categoryGroups.map((group) => (
          <a href={`#${group.slug}`}>
            <strong>{group.name}</strong>
            <span>{group.guides.length} rehber</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  {categoryGroups.map((group, groupIndex) => (
    <section id={group.slug} class="cluster-section">
      <div class="container-site section-enter">
        <div class="cluster-head">
          <div>
            <p>{String(groupIndex + 1).padStart(2, '0')} · {group.primaryQuery}</p>
            <h2>{group.name}</h2>
            <div>{group.description}</div>
          </div>
          <a href={`/sablonlar/${group.slug}`}>{group.name} şablonlarını karşılaştır →</a>
        </div>
        <div class="guide-grid">
          {group.guides.map((guide, index) => (
            <article class="guide-card">
              <span>{String(index + 1).padStart(2, '0')} · {guide.data.primaryQuery}</span>
              <h3><a href={`/rehber/${guide.id}`}>{guide.data.title}</a></h3>
              <p>{guide.data.description}</p>
              <a class="guide-card__link" href={`/rehber/${guide.id}`}>Adım adım rehberi aç →</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section>
    <div class="container-site section-enter">
      <div class="catalog-cta">
        <div>
          <p>HAZIR UYGULAMA KATMANI</p>
          <h2 class="h2">Yöntemi öğrendiniz; hazır sistemi karşılaştırın.</h2>
          <div class="body-sm mt-3 max-w-2xl">Rehberler doğru yöntemi ve kontrol mantığını açıklar. Şablon kataloğu ise aynı problemlerin hazır Excel sistemlerini, gerçek ekranlarını, çıktılarını ve teknik kapsamını yan yana gösterir.</div>
        </div>
        <Button href="/sablonlar">Excel sistemlerini karşılaştırın</Button>
      </div>
    </div>
  </section>
</CommerceLayout>

<style>
  .hub-stats{display:flex;flex-wrap:wrap;gap:10px}.hub-stats div{min-width:150px;padding:14px 16px;border:1px solid #d8e3dc;border-radius:12px;background:rgba(255,255,255,.68)}.hub-stats strong{display:block;font-family:var(--font-display);font-size:26px;color:#173022}.hub-stats span{display:block;margin-top:2px;font-size:9px;font-weight:700;color:#66746b}.hub-nav-section{padding-bottom:0}.hub-kicker,.cluster-head p,.catalog-cta>div>p{font-family:var(--font-mono);font-size:8px;font-weight:800;letter-spacing:.09em;color:#0b7440}.cluster-nav{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.cluster-nav a{display:flex;min-height:78px;flex-direction:column;justify-content:space-between;padding:14px;border:1px solid #dce5df;border-radius:12px;background:#fff;color:#21372b;text-decoration:none}.cluster-nav strong{font-size:11px}.cluster-nav span{font-size:8.5px;color:#748178}.cluster-section{scroll-margin-top:24px}.cluster-section+.cluster-section{padding-top:24px}.cluster-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;margin-bottom:22px;padding-bottom:18px;border-bottom:1px solid #dce5df}.cluster-head h2{margin:7px 0 0;font-family:var(--font-display);font-size:36px;line-height:1;letter-spacing:-.035em;color:#183024}.cluster-head div>div{margin-top:9px;max-width:640px;font-size:11px;line-height:1.6;color:#6a776f}.cluster-head>a{font-size:9.5px;font-weight:800;color:#0b7440;text-decoration:none;white-space:nowrap}.guide-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.guide-card{display:flex;min-height:290px;flex-direction:column;padding:24px;border:1px solid #dce5df;border-radius:16px;background:#fff}.guide-card>span{font-family:var(--font-mono);font-size:8px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#0b7440}.guide-card h3{margin:16px 0 0;font-family:var(--font-display);font-size:24px;line-height:1.08;letter-spacing:-.025em;color:#183024}.guide-card h3 a{color:inherit;text-decoration:none}.guide-card p{margin:12px 0 0;font-size:10.5px;line-height:1.65;color:#647169}.guide-card__link{margin-top:auto;padding-top:20px;font-size:9.5px;font-weight:800;color:#0b7440;text-decoration:none}.catalog-cta{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-top:30px;border-top:1px solid #dce5df}@media(max-width:960px){.cluster-nav{grid-template-columns:repeat(2,1fr)}.guide-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.cluster-nav,.guide-grid{grid-template-columns:1fr}.guide-card{min-height:0}.cluster-head,.catalog-cta{align-items:flex-start;flex-direction:column}.cluster-head h2{font-size:30px}.hub-stats div{flex:1;min-width:120px}}
</style>
