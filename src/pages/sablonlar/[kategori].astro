---
import CommerceLayout from '../../layouts/CommerceLayout.astro';
import CatalogHero from '../../components/catalog/CatalogHero.astro';
import CatalogSearch from '../../components/catalog/CatalogSearch.astro';
import CatalogFilters from '../../components/catalog/CatalogFilters.astro';
import TemplateGrid from '../../components/catalog/TemplateGrid.astro';
import { getTemplatesByCategory } from '../../lib/templates';
import { getCategoryName } from '../../lib/categories';

export async function getStaticPaths() {
  const { categories } = await import('../../lib/categories');
  return categories.map((category) => ({
    params: { kategori: category.slug },
    props: { categoryName: category.name },
  }));
}

interface Props {
  categoryName: string;
}

const { categoryName } = Astro.props;
const categorySlug = Astro.params.kategori!;

const templates = await getTemplatesByCategory(categorySlug);
const categoryLabel = getCategoryName(categorySlug);
---

<CommerceLayout
  title={`${categoryLabel} Şablonları — Excel Arşiv`}
  description={`${categoryLabel} alanında hazır Excel çalışma tabloları. Demo dosyayla inceleyin, Shopier ile güvenli ödeme yapın.`}
>
  <CatalogHero
    title={`${categoryLabel} Şablonları`}
    description={`${categoryLabel} alanında hazır Excel çalışma tabloları. Her ürünün demo dosyasını satın almadan inceleyebilirsiniz.`}
  />
  <section class="catalog-section">
    <div class="site-container">
      <CatalogSearch />
      <div class="catalog-section__filters">
        <CatalogFilters active={categorySlug} />
      </div>
      <TemplateGrid templates={templates} />
    </div>
  </section>
</CommerceLayout>

<style>
  .catalog-section {
    padding-block: clamp(32px, 5vw, 56px) clamp(64px, 8vw, 108px);
  }
  .catalog-section__filters {
    margin-top: 18px;
  }
  .catalog-section > .site-container > :last-child {
    margin-top: 32px;
  }
</style>
