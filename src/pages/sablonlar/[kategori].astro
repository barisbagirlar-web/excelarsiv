---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import SectionLabel from '../../components/SectionLabel.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CellGrid from '../../components/CellGrid.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { slugify } from '../../utils/slug';

export async function getStaticPaths() {
  const categories = [
    ['finansal-analiz', 'Finansal Analiz'],
    ['nakit-akisi', 'Nakit Akışı'],
    ['muhasebe-ve-vergi', 'Muhasebe ve Vergi'],
    ['butce-ve-planlama', 'Bütçe ve Planlama'],
    ['stok-ve-uretim', 'Stok ve Üretim'],
    ['satis-ve-fiyatlama', 'Satış ve Fiyatlama'],
    ['personel-ve-bordro', 'Personel ve Bordro'],
  ] as const;
  return categories.map(([slug, label]) => ({ params: { kategori: slug }, props: { categoryName: label } }));
}

interface Props {
  categoryName: string;
}

const { categoryName } = Astro.props;
const categorySlug = Astro.params.kategori!;

const templates = (await getCollection('templates')).filter(
  (template) => template.data.category === categorySlug
);
---

<Layout
  title={`${categoryName} Şablonları — Excel Arşiv`}
  description={`${categoryName} alanında hazır Excel çalışma tabloları. Demo dosyayla inceleyin, Shopier ile güvenli ödeme yapın.`}
>
  <section class="mx-auto max-w-6xl px-4 pb-24 pt-8">
    <Breadcrumbs crumbs={[{ label: 'Şablonlar', href: '/sablonlar' }, { label: categoryName }]} />
    <SectionLabel address="A1" label="Kategori" />
    <h1 class="display mt-6">{categoryName} Şablonları</h1>

    <div class="mt-8">
      <CategoryNav active={categorySlug} />
    </div>

    <div class="mt-8">
      <CellGrid>
        {
          templates.map((template) => (
            <TemplateCard
              slug={slugify(template.data.name)}
              name={template.data.name}
              summary={template.data.summary}
              sheetCount={template.data.sheetCount}
              priceTL={template.data.priceTL}
            />
          ))
        }
      </CellGrid>
    </div>

    <p class="mt-8 max-w-xl leading-relaxed text-ink-500">
      {categoryName} alanında hazır Excel çalışma tabloları. Her ürünün demo dosyasını satın almadan
      inceleyebilirsiniz.
    </p>
  </section>
</Layout>
