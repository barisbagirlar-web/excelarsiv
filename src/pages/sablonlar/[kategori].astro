---
import CommerceLayout from '../../layouts/CommerceLayout.astro';
import CatalogHero from '../../components/catalog/CatalogHero.astro';
import CatalogSearch from '../../components/catalog/CatalogSearch.astro';
import CatalogFilters from '../../components/catalog/CatalogFilters.astro';
import TemplateGrid from '../../components/catalog/TemplateGrid.astro';
import { getCollection } from 'astro:content';
import { getTemplatesByCategory } from '../../lib/templates';
import { categories, getCategoryName } from '../../lib/categories';

export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { kategori: category.slug },
    props: { categoryName: category.name },
  }));
}

interface Props {
  categoryName: string;
}

const { categoryName } = Astro.props;
const categorySlug = Astro.params.kategori!;
const templates = await getTemplatesByCategory(categorySlug);
const categoryLabel = getCategoryName(categorySlug);
const category = categories.find((item) => item.slug === categorySlug);
const guides = (await getCollection('guides'))
  .filter((guide) => guide.data.category === categorySlug)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'tr'));
const seoTitle = category?.seoTitle ?? `${categoryLabel} Excel Şablonları | Excel Arşiv`;
const seoDescription = category?.seoDescription ?? `${categoryLabel} alanında hazır Excel çalışma sistemlerini karşılaştırın ve demo ile inceleyin.`;
const primaryQuery = category?.primaryQuery ?? `${categoryLabel.toLocaleLowerCase('tr-TR')} excel`;
const heroDescription = category?.description ?? `${categoryLabel} alanında hazır Excel çalışma sistemleri.`;
const categoryLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': new URL(`/sablonlar/${categorySlug}#itemlist`, Astro.site).toString(),
  numberOfItems: templates.length,
  itemListElement: templates.map((template, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/sablon/${template.slug}`, Astro.site).toString(),
    name: template.name,
  })),
});
const categoryPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': new URL(`/sablonlar/${categorySlug}#collection`, Astro.site).toString(),
  url: new URL(`/sablonlar/${categorySlug}`, Astro.site).toString(),
  name: `${categoryLabel} Excel Şablonları`,
  inLanguage: 'tr-TR',
  isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
  mainEntity: { '@id': new URL(`/sablonlar/${categorySlug}#itemlist`, Astro.site).toString() },
});
const categoryBreadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Excel Şablonları', item: new URL('/sablonlar', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: categoryLabel, item: new URL(`/sablonlar/${categorySlug}`, Astro.site).toString() },
  ],
});
---

<CommerceLayout title={seoTitle} description={seoDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={categoryLd} />
    <script type="application/ld+json" set:html={categoryPageLd} />
    <script type="application/ld+json" set:html={categoryBreadcrumbLd} />
  </Fragment>
  <CatalogHero
    title={`${categoryLabel} Excel Şablonları`}
    description={`${heroDescription} Gerçek ürün ekranlarını ve demo akışını satın almadan önce inceleyin.`}
  />
  <section class="catalog-section">
    <div class="site-container">
      <p class="category-query">{primaryQuery}</p>
      <CatalogSearch />
      <div class="catalog-section__filters">
        <CatalogFilters active={categorySlug} />
      </div>
      <h2 class="sr-only">{categoryLabel} Excel şablonları kataloğu</h2>
      <TemplateGrid templates={templates} />
      {guides.length > 0 && (
        <aside class="category-guides" aria-labelledby="category-guides-title">
          <div class="category-guides__head">
            <p>UYGULAMA REHBERLERİ</p>
            <h2 id="category-guides-title">Bu kategoride doğru sistemi nasıl kurarsınız?</h2>
          </div>
          <div class="category-guides__grid">
            {guides.map((guide) => (
              <a href={`/rehber/${guide.id}`}>
                <span>{guide.data.primaryQuery}</span>
                <strong>{guide.data.title}</strong>
                <small>Rehberi aç →</small>
              </a>
            ))}
          </div>
        </aside>
      )}
    </div>
  </section>
</CommerceLayout>

<style>
  .catalog-section{padding-block:clamp(32px,5vw,56px) clamp(64px,8vw,108px)}.category-query{margin:0 0 12px;font-family:var(--font-mono);font-size:8.5px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--xl-green)}.catalog-section__filters{margin-top:18px}.catalog-section>.site-container>:last-child{margin-top:32px}.category-guides{margin-top:54px!important;padding-top:30px;border-top:1px solid var(--xl-grid)}.category-guides__head>p{margin:0;font-family:var(--font-mono);font-size:8.5px;font-weight:800;letter-spacing:.08em;color:var(--xl-green)}.category-guides__head h2{max-width:720px;margin:8px 0 0;font-family:var(--font-display);font-size:clamp(26px,3vw,38px);line-height:1.06;letter-spacing:-.03em;color:var(--xl-ink-900)}.category-guides__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:20px}.category-guides__grid a{display:grid;gap:8px;padding:20px;border:1px solid var(--xl-grid);border-radius:14px;background:#fff;color:var(--xl-ink-900);text-decoration:none}.category-guides__grid a:hover{border-color:#afc9b9}.category-guides__grid span{font-family:var(--font-mono);font-size:8px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--xl-green)}.category-guides__grid strong{font-size:16px;line-height:1.25}.category-guides__grid small{margin-top:5px;font-size:9.5px;font-weight:800;color:var(--xl-green)}@media(max-width:720px){.category-guides__grid{grid-template-columns:1fr}}
</style>
