---
import CommerceLayout from '../../layouts/CommerceLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SpecTable from '../../components/SpecTable.astro';
import PreviewGallery from '../../components/PreviewGallery.astro';
import SheetMapTable from '../../components/SheetMapTable.astro';
import EligibilityList from '../../components/EligibilityList.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import TemplateCard from '../../components/catalog/TemplateCard.astro';
import CellGrid from '../../components/CellGrid.astro';
import PurchaseBar from '../../components/PurchaseBar.astro';
import Notice from '../../components/Notice.astro';
import ProductHeroPremium from '../../components/product/ProductHeroPremium.astro';

export async function getStaticPaths() {
  const templates = await getCollection('templates');
  return templates.map((template) => ({
    params: { slug: template.id },
    props: { template },
  }));
}

interface Props {
  template: CollectionEntry<'templates'>;
}

const { template } = Astro.props;
const t = template.data;

const categoryLabels: Record<string, string> = {
  'finansal-analiz': 'Finansal Analiz',
  'nakit-akisi': 'Nakit Akışı',
  'muhasebe-ve-vergi': 'Muhasebe ve Vergi',
  'butce-ve-planlama': 'Bütçe ve Planlama',
  'stok-ve-uretim': 'Stok ve Üretim',
  'satis-ve-fiyatlama': 'Satış ve Fiyatlama',
  'personel-ve-bordro': 'Personel ve Bordro',
};
const categoryLabel = categoryLabels[t.category] ?? t.category;

const allTemplates = await getCollection('templates');
const related = allTemplates.filter((item) => t.related.includes(item.id));
const productUrl = new URL(`/sablon/${template.id}`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: t.name,
      description: t.summary,
      image: t.screenshots.map((image) => new URL(image.src, Astro.site).href),
      brand: { '@type': 'Brand', name: 'Excel Arşiv' },
      offers: {
        '@type': 'Offer',
        price: t.priceTL,
        priceCurrency: 'TRY',
        availability: 'https://schema.org/InStock',
        url: productUrl,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Şablonlar', item: new URL('/sablonlar', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: categoryLabel, item: new URL(`/sablonlar/${t.category}`, Astro.site).href },
        { '@type': 'ListItem', position: 4, name: t.name },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---

<CommerceLayout
  title={`${t.name} — Excel Arşiv`}
  description={`${t.summary} Ücretsiz demo ile deneyin; Shopier ile güvenli ödeme sonrası ExcelArşiv üzerinden doğrudan indirin.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="product-page">
    <Breadcrumbs
      crumbs={[
        { label: 'Şablonlar', href: '/sablonlar' },
        { label: categoryLabel, href: `/sablonlar/${t.category}` },
        { label: t.name },
      ]}
    />

    <ProductHeroPremium
      productSlug={template.id}
      name={t.name}
      summary={t.summary}
      categoryLabel={categoryLabel}
      priceTL={t.priceTL}
      screenshots={t.screenshots}
      outputs={t.outputs}
      sheetCount={t.sheetCount}
      minExcelVersion={t.minExcelVersion}
      macCompatible={t.macCompatible}
    />

    <section id="onizleme" class="product-section product-section--preview">
      <div class="section-head">
        <div>
          <p class="section-kicker">GERÇEK ÜRÜN EKRANLARI</p>
          <h2>Satın alacağınız dosyayı görün.</h2>
        </div>
        <p>Temsilî görsel değil; ürünün gerçek çalışma ekranları. Görselleri büyüterek yapıyı satın almadan önce inceleyebilirsiniz.</p>
      </div>
      <PreviewGallery images={t.screenshots} />
    </section>

    <section class="product-section product-section--flow">
      <div class="section-head section-head--light">
        <div>
          <p class="section-kicker">NASIL ÇALIŞIR?</p>
          <h2>Veriyi girin. Karar çıktısını alın.</h2>
        </div>
        <p>Karmaşık özellik listesi yerine sistemin sizden ne istediğini ve size ne verdiğini doğrudan görün.</p>
      </div>

      <div class="io-grid">
        <div class="io-card">
          <span>1 · GİRDİ</span>
          <h3>Siz girersiniz</h3>
          <ul>{t.inputs.map((item) => <li><b>→</b>{item}</li>)}</ul>
        </div>
        <div class="io-card io-card--output">
          <span>2 · ÇIKTI</span>
          <h3>Sistem üretir</h3>
          <ul>{t.outputs.map((item) => <li><b>✓</b>{item}</li>)}</ul>
        </div>
      </div>

      <details class="product-details">
        <summary>Dosyanın içinde hangi sayfalar var? <span>+</span></summary>
        <div class="product-details__body"><SheetMapTable sheets={t.sheetMap} /></div>
      </details>
    </section>

    <section class="product-section">
      <div class="section-head">
        <div>
          <p class="section-kicker">KİMLER İÇİN?</p>
          <h2>Doğru ürünü seçtiğinizden emin olun.</h2>
        </div>
        <p>Yanlış satın almayı azaltmak için uygun ve uygun olmayan kullanım senaryolarını birlikte gösteriyoruz.</p>
      </div>
      <div class="eligibility-grid">
        <EligibilityList title="Bu ürün size uygunsa" items={t.suitableFor} />
        <EligibilityList title="Bu ürün size uygun değilse" items={t.notSuitableFor} negative />
      </div>
    </section>

    <section class="product-section product-section--quiet">
      <div class="section-head">
        <div>
          <p class="section-kicker">TEKNİK BİLGİLER</p>
          <h2>Satın almadan önce bilmeniz gerekenler.</h2>
        </div>
        <p>Excel sürümü, platform, dosya tipi ve güncelleme koşulları burada. Karar için gerekli olmayan teknik detayları üst bölümde kalabalıklaştırmıyoruz.</p>
      </div>

      <details class="product-details" open>
        <summary>Uyumluluk ve dosya bilgileri <span>+</span></summary>
        <div class="product-details__body technical-grid">
          <SpecTable
            fileFormat={t.fileFormat}
            version={t.version}
            updatedAt={t.updatedAt}
            sheetCount={t.sheetCount}
            sizeMB={t.sizeMB}
            hasMacros={t.hasMacros}
            minExcelVersion={t.minExcelVersion}
            macCompatible={t.macCompatible}
            sheetsCompatibility={t.sheetsCompatibility}
          />
          <div class="requirements-card">
            <p class="requirements-card__title">ÇALIŞTIRMA GEREKSİNİMLERİ</p>
            <ul>{t.requirements.map((item) => <li><span>✓</span>{item}</li>)}</ul>
            <div class="requirements-card__policy">
              <small>GÜNCELLEME POLİTİKASI</small>
              <p>{t.updatePolicy}</p>
            </div>
          </div>
        </div>
      </details>

      {
        t.hasMacros && (
          <div class="macro-notice">
            <Notice type="warning">
              Bu dosya makro içerir. İlk açılışta Excel güvenlik uyarısı verir; içeriğe güveniyorsanız "Makroları Etkinleştir" ile açabilirsiniz.
            </Notice>
          </div>
        )
      }
    </section>

    <section id="sss" class="product-section">
      <div class="section-head">
        <div>
          <p class="section-kicker">SIK SORULAN SORULAR</p>
          <h2>Kalan soruları burada kapatın.</h2>
        </div>
      </div>
      <FaqAccordion items={t.faq} />
    </section>

    {
      related.length > 0 && (
        <section class="product-section product-section--related">
          <div class="section-head">
            <div>
              <p class="section-kicker">İLGİLİ SİSTEMLER</p>
              <h2>Bu iş akışını tamamlayan ürünler.</h2>
            </div>
            <a href="/sablonlar">Tüm sistemleri görün →</a>
          </div>
          <CellGrid>
            {related.map((item) => (
              <TemplateCard
                slug={item.id}
                name={item.data.name}
                summary={item.data.summary}
                sheetCount={item.data.sheetCount}
                priceTL={item.data.priceTL}
              />
            ))}
          </CellGrid>
        </section>
      )
    }
  </main>

  <PurchaseBar name={t.name} priceTL={t.priceTL} />
  <div class="h-20 sm:hidden" aria-hidden="true" />
</CommerceLayout>

<style>
  .product-page{width:min(1180px,calc(100% - 48px));margin-inline:auto;padding:26px 0 104px}.product-section{padding:clamp(54px,6vw,78px) 0;border-top:1px solid #e2e8e4}.section-head{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(280px,.72fr);gap:40px;align-items:end;margin-bottom:24px}.section-kicker{margin:0;font-family:var(--font-mono);font-size:9px;font-weight:800;letter-spacing:.11em;color:#0b7440}.section-head h2{max-width:720px;margin:8px 0 0;font-family:var(--font-display);font-size:clamp(29px,3.1vw,42px);line-height:1.03;letter-spacing:-.035em;color:#16291e}.section-head>p{margin:0;font-size:12px;line-height:1.6;color:#69766e}.section-head>a{justify-self:end;color:#0b7440;font-size:10px;font-weight:700;text-decoration:none}.product-section--preview{padding-top:58px}.product-section--flow{margin:0 -24px;padding-inline:24px;border:0;border-radius:24px;background:#0b3727;color:#fff}.section-head--light .section-kicker{color:#85d6a7}.section-head--light h2{color:#fff}.section-head--light>p{color:rgba(245,255,249,.66)}
  .io-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.io-card{padding:22px;border:1px solid rgba(255,255,255,.12);border-radius:16px;background:rgba(255,255,255,.05)}.io-card--output{background:rgba(112,218,156,.09);border-color:rgba(112,218,156,.18)}.io-card>span{font-family:var(--font-mono);font-size:8.5px;font-weight:800;letter-spacing:.08em;color:#82d9a5}.io-card h3{margin:8px 0 0;font-size:19px;color:#fff}.io-card ul{display:grid;gap:8px;margin:16px 0 0;padding:0;list-style:none}.io-card li{display:flex;gap:8px;font-size:11.5px;line-height:1.45;color:rgba(245,255,249,.74)}.io-card li b{color:#83dda8;font-family:var(--font-mono)}
  .product-details{margin-top:16px;border:1px solid #dce5df;border-radius:15px;background:#fff;color:#203128;overflow:hidden}.product-section--flow .product-details{border-color:rgba(255,255,255,.16);background:rgba(255,255,255,.06);color:#fff}.product-details summary{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:16px 18px;cursor:pointer;list-style:none;font-size:12px;font-weight:800}.product-details summary::-webkit-details-marker{display:none}.product-details summary span{font-size:18px;font-weight:400}.product-details[open] summary span{transform:rotate(45deg)}.product-details__body{padding:0 18px 18px}.product-section--flow .product-details__body{padding-top:4px;background:#fff;color:#203128}.eligibility-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.product-section--quiet{margin:0 -24px;padding-inline:24px;border:1px solid #e0e7e2;border-radius:24px;background:#f6f8f7}.technical-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(340px,1.1fr);gap:16px;align-items:start}.requirements-card{padding:20px;border:1px solid #dde5e0;border-radius:14px;background:#fff}.requirements-card__title,.requirements-card__policy small{margin:0;font-family:var(--font-mono);font-size:8.5px;font-weight:800;letter-spacing:.08em;color:#0b7440}.requirements-card ul{display:grid;gap:8px;margin:14px 0 0;padding:0;list-style:none}.requirements-card li{display:flex;gap:8px;font-size:11.5px;line-height:1.45;color:#46534b}.requirements-card li span{color:#0b7440;font-weight:800}.requirements-card__policy{margin-top:18px;padding-top:15px;border-top:1px solid #e3e9e5}.requirements-card__policy p{margin:7px 0 0;font-size:10.5px;line-height:1.5;color:#69756e}.macro-notice{margin-top:14px}.product-section--related{padding-bottom:12px}
  @media(max-width:900px){.product-page{width:min(100% - 32px,1180px)}.section-head{grid-template-columns:1fr;gap:10px}.section-head>a{justify-self:start}.technical-grid{grid-template-columns:1fr}.io-grid,.eligibility-grid{grid-template-columns:1fr}.product-section--flow,.product-section--quiet{margin-inline:-10px;padding-inline:18px}}
  @media(max-width:620px){.product-page{width:calc(100% - 24px);padding-top:16px}.product-section{padding:44px 0}.section-head{margin-bottom:18px}.section-head h2{font-size:29px}.section-head>p{font-size:11.5px}.product-section--flow,.product-section--quiet{margin-inline:-4px;padding-inline:14px;border-radius:18px}.io-card{padding:17px}.product-details summary{padding:14px;font-size:11px}.product-details__body{padding:0 12px 14px}}
</style>
