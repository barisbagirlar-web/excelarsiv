---
import CommerceLayout from '../layouts/CommerceLayout.astro';
import { getCollection } from 'astro:content';
import Button from '../components/Button.astro';
import CellGrid from '../components/CellGrid.astro';
import KatalogUrunKarti from '../components/catalog/KatalogUrunKarti.astro';
import Icon from '../components/Icon.astro';
import { toTemplateViewModel } from '../lib/templates';

const templates = await getCollection('templates');
const featured = templates.slice(0, 3).map(toTemplateViewModel);

// Client-side arama için statik indeks — şablon adı + id
const searchIndex = templates.map((template) => ({
  name: template.data.name,
  slug: template.id,
}));

const otherErrors = ['#NAME?', '#VALUE!', '#DIV/0!'];
---

<CommerceLayout
  title="Sayfa Bulunamadı — Excel Arşiv"
  description="Aradığınız şablon silindi veya adı değiştirildi. Şablon arayın veya kataloğa göz atın."
  robots="noindex,follow"
>
  <section class="container-site grid min-h-[60vh] items-center gap-10 py-20 lg:grid-cols-2">
    <div>
      <p class="kicker flex items-center gap-3">
        <span class="text-accent-primary">#REF!</span>
        <span aria-hidden="true" class="h-px w-10 bg-rule-strong" />
        Sayfa yok · 404
      </p>
      <h1 class="display mt-6">
        #REF! — Bu hücre <em class="serif-em">boş</em>.
      </h1>
      <p class="lead mt-6 max-w-md">
        Aradığınız şablon silindi veya adı değiştirildi.
      </p>

      <!-- Arama — client-side, statik indeks üzerinde -->
      <form class="mt-10 max-w-md" role="search" onsubmit="return false">
        <label for="sablon-ara" class="sr-only">Şablon ara</label>
        <div class="flex items-center gap-2 border border-rule-strong bg-surface-elevated px-3 transition-colors duration-150 ease-out focus-within:border-accent-primary">
          <Icon name="action-search" size={14} className="shrink-0 text-ink-300" />
          <input
            id="sablon-ara"
            name="sablon"
            type="search"
            placeholder="Şablon ara…"
            autocomplete="off"
            class="min-h-11 w-full bg-transparent font-mono text-sm text-ink-700 placeholder:text-ink-300 focus:outline-none"
          />
        </div>
        <p id="arama-sayac" class="mono-xs mt-2 text-ink-400" aria-live="polite"></p>
      </form>
      <ul id="arama-sonuclari" class="mt-2 max-w-md"></ul>
      <p id="arama-bos" class="mono-xs mt-2 hidden text-ink-400">
        Sonuç yok — tüm dosyaları katalogda görün.
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/">Ana sayfaya dön</Button>
        <Button href="/sablonlar" variant="secondary">Şablonları incele</Button>
      </div>
    </div>

    <div class="hidden flex-col items-end gap-6 lg:flex">
      <p
        aria-hidden="true"
        class="select-none text-right font-mono text-[10rem] leading-none text-line-dark"
      >
        #REF!
      </p>
      <ul class="flex flex-wrap justify-end gap-2" aria-label="Diğer olası hatalar">
        {
          otherErrors.map((error) => (
            <li class="border border-rule-hairline bg-surface-elevated px-2 py-1 font-mono text-xs text-ink-400">
              {error}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="border-t border-rule-hairline bg-surface-1">
        <div class="container-site section-enter">
          <h2 class="h1">Veya en popüler şablonlara göz atın</h2>
          <div class="mt-8">
            <CellGrid>
              {
                featured.map((template) => (
                  <KatalogUrunKarti template={template} />
                ))
              }
            </CellGrid>
          </div>
        </div>
      </section>
    )
  }
</CommerceLayout>

<script define:vars={{ searchIndex }}>
  const input = /** @type {HTMLInputElement} */ (document.getElementById('sablon-ara'));
  const results = /** @type {HTMLUListElement} */ (document.getElementById('arama-sonuclari'));
  const counter = /** @type {HTMLParagraphElement} */ (document.getElementById('arama-sayac'));
  const empty = /** @type {HTMLParagraphElement} */ (document.getElementById('arama-bos'));

  const itemClass =
    'flex items-center justify-between gap-4 border-b border-rule-hairline px-2 py-3 font-mono text-sm text-ink-700 transition-colors duration-150 ease-out hover:text-accent-primary';

  input.addEventListener('input', () => {
    const query = input.value.trim().toLocaleLowerCase('tr');
    const matches =
      query === ''
        ? []
        : searchIndex
            .filter((t) => t.name.toLocaleLowerCase('tr').includes(query))
            .slice(0, 8);

    results.replaceChildren();
    counter.textContent = query === '' ? '' : `${matches.length} sonuç`;
    empty.classList.toggle('hidden', matches.length > 0 || query === '');

    matches.forEach((t) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `/sablon/${t.slug}`;
      a.textContent = t.name;
      a.className = itemClass;
      const arrow = document.createElement('span');
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '→';
      a.appendChild(arrow);
      li.appendChild(a);
      results.appendChild(li);
    });
  });
</script>
