---
import CommerceLayout from '../../layouts/CommerceLayout.astro';
import { getCollection } from 'astro:content';
import SectionLabel from '../../components/SectionLabel.astro';

const templates = (await getCollection('templates')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'tr'),
);
---

<CommerceLayout
  title="Ücretsiz Proof Demo Kataloğu — Excel Arşiv"
  description="89 Excel ürününün ücretsiz Proof Demo açılış sayfaları. Gerçek formül mimarisini deneyin; tam sürümü Shopier ile satın alın."
>
  <section class="mx-auto max-w-3xl px-4 pb-24 pt-8">
    <SectionLabel number={8} label="Demo Katalog" />
    <h1 class="display mt-6">Ücretsiz Proof Demo kataloğu</h1>
    <p class="lead mt-6">
      Her ürün için indexlenebilir demo kapısı. ChatGPT tablosundan farkı görmek için demoyu indirin.
    </p>
    <ul class="mt-10 space-y-3">
      {
        templates.map((template) => (
          <li class="border-t border-rule-hairline pt-3">
            <a class="font-mono text-sm text-accent-primary underline underline-offset-4" href={`/demo/${template.id}`}>
              {template.data.name}
            </a>
            <span class="ml-2 text-xs text-ink-400">{template.data.priceTL.toLocaleString('tr-TR')} TL</span>
          </li>
        ))
      }
    </ul>
  </section>
</CommerceLayout>
